    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <div class="share-card">
          <h3>My Progress Card</h3>
          <div class="big" id="shareBigScore">0</div>
          <div style="letter-spacing:2px; opacity:.9;">TOTAL POIN</div>
          <hr style="border-color:rgba(255,255,255,.3);">
          <div class="d-flex justify-content-between mb-1">
            <span>👤 ${'' /* will fill JS */}</span>
            <strong id="shareUserName">—</strong>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span>🏆 Rank</span><strong id="shareRank">—</strong>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span>🎓 Badges</span><strong id="shareBadges">0</strong>
          </div>
          <div class="d-flex justify-content-between mb-3">
            <span>🎯 Labs</span><strong id="shareLabs">0</strong>
          </div>
          <div class="share-code" id="shareCode">—</div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card p-3 mb-3">
          <h6><i class="bi bi-share"></i> Bagikan Ke</h6>
          <div class="d-grid gap-2">
            <button class="btn btn-outline-info" onclick="shareTo('twitter')">
              <i class="bi bi-twitter"></i> Twitter / X
            </button>
            <button class="btn btn-outline-primary" onclick="shareTo('linkedin')">
              <i class="bi bi-linkedin"></i> LinkedIn
            </button>
            <button class="btn btn-outline-success" onclick="shareTo('whatsapp')">
              <i class="bi bi-whatsapp"></i> WhatsApp
            </button>
            <button class="btn btn-outline-warning" onclick="copyShareLink()">
              <i class="bi bi-link-45deg"></i> Copy Link
            </button>
            <button class="btn btn-outline-secondary" onclick="downloadShareImage()">
              <i class="bi bi-image"></i> Download Image
            </button>
          </div>
        </div>

        <div class="card p-3">
          <h6><i class="bi bi-clock-history"></i> Shared History</h6>
          <div id="sharedHistory" class="small"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- API DOCS -->
  <div id="page-api-docs" class="page">
    <h3 class="mb-3"><i class="bi bi-braces text-secondary"></i> API Reference</h3>
    <div class="card p-3 mb-3">
      <h6>Base URL</h6>
      <code style="color:#7ee787;">http://localhost:8000/api/v1</code>
      <small class="text-muted d-block mt-2">Backend FastAPI. Untuk dev bisa pakai <code>python -m http.server 5500</code> hanya untuk frontend.</small>
    </div>

    <div class="card p-3 mb-3">
      <h6><i class="bi bi-info-circle"></i> Cara Pakai</h6>
      <ol class="small">
        <li>Jalankan backend: <code>uvicorn app.main:app --host 0.0.0.0 --port 8000</code></li>
        <li>Buka <a href="http://localhost:8000/docs" target="_blank">http://localhost:8000/docs</a> → Swagger UI</li>
        <li>Untuk auth, login dulu di <code>/api/v1/auth/login</code> → dapat token</li>
        <li>Sertakan header: <code>Authorization: Bearer &lt;token&gt;</code></li>
      </ol>
    </div>

    <div class="card p-3">
      <h6>Endpoints</h6>
      <div id="apiEndpoints"></div>
    </div>
  </div>


  <!-- NOTES -->
  <div id="page-notes" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-journal-text text-info"></i> Catatan Belajar</h3>
      <button class="btn btn-primary" onclick="openNoteModal()">
        <i class="bi bi-plus-circle"></i> Catatan Baru
      </button>
    </div>
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <input type="text" class="form-control" id="noteSearch"
               placeholder="🔍 Cari catatan..." oninput="renderNotes()">
      </div>
      <div class="col-md-3">
        <select class="form-select" id="noteColorFilter" onchange="renderNotes()">
          <option value="">Semua Warna</option>
          <option value="yellow">Kuning</option>
          <option value="blue">Biru</option>
          <option value="green">Hijau</option>
          <option value="red">Merah</option>
          <option value="purple">Ungu</option>
        </select>
      </div>
    </div>
    <div class="row g-3" id="notesGrid"></div>
  </div>

  <!-- POMODORO -->
  <div id="page-pomodoro" class="page">
    <h3 class="mb-3"><i class="bi bi-alarm-fill text-danger"></i> Pomodoro Timer</h3>
    <div class="row g-3">
      <div class="col-md-6 mx-auto">
        <div class="card p-4 text-center">
          <div class="pomodoro-ring" id="pomodoroRing">
            <div class="pomodoro-inner">
              <div class="time" id="pomodoroTime">25:00</div>
              <small class="text-muted" id="pomodoroMode">Waktu Fokus</small>
            </div>
          </div>
          <div class="d-flex gap-2 justify-content-center mt-3">
            <button class="btn btn-success" id="pomodoroStart" onclick="togglePomodoro()">
              <i class="bi bi-play-fill"></i> Start
            </button>
            <button class="btn btn-warning" onclick="resetPomodoro()">
              <i class="bi bi-arrow-clockwise"></i> Reset
            </button>
            <button class="btn btn-outline-info" onclick="switchPomodoroMode()">
              <i class="bi bi-arrow-repeat"></i> Ganti Mode
            </button>
          </div>
          <hr>
          <div class="row text-center">
            <div class="col-4">
              <div class="fs-4 fw-bold text-info" id="pomodoroSessions">0</div>
              <small class="text-muted">Sesi Selesai</small>
            </div>
            <div class="col-4">
              <div class="fs-4 fw-bold text-warning" id="pomodoroFocus">0m</div>
              <small class="text-muted">Fokus Hari Ini</small>
            </div>
            <div class="col-4">
              <div class="fs-4 fw-bold text-success" id="pomodoroStreak">0</div>
              <small class="text-muted">Streak</small>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card p-3 mb-3">
          <h6><i class="bi bi-gear"></i> Pengaturan</h6>
          <div class="mb-2">
            <label class="form-label small">Fokus (menit)</label>
            <input type="number" class="form-control" id="pomoFocus" value="25" min="1" max="60">
          </div>
          <div class="mb-2">
            <label class="form-label small">Istirahat Pendek (menit)</label>
            <input type="number" class="form-control" id="pomoBreak" value="5" min="1" max="30">
          </div>
          <div>
            <label class="form-label small">Istirahat Panjang (menit)</label>
            <input type="number" class="form-control" id="pomoLong" value="15" min="1" max="60">
          </div>
        </div>

        <div class="card p-3">
          <h6><i class="bi bi-clock-history"></i> Sesi Terakhir</h6>
          <div id="pomodoroHistory" class="small"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- HEATMAP -->
  <div id="page-heatmap" class="page">
    <h3 class="mb-3"><i class="bi bi-calendar3 text-success"></i> Activity Heatmap</h3>

    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="streak-card">
          <div class="big" id="streakCurrent">0</div>
          <div>Current Streak</div>
          <small style="opacity:.9">hari</small>
        </div>
      </div>
      <div class="col-md-3">
        <div class="streak-card" style="background:linear-gradient(135deg,#6f42c1,#1f6feb);">
