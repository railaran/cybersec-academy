  const inp = document.getElementById("chatInput");
  const text = inp.value.trim();
  if (!text) return;
  DB.chat = DB.chat || [];
  DB.chat.push({
    id: Date.now(),
    from: currentUser.full_name,
    from_id: currentUser.id,
    text,
    at: new Date().toISOString(),
  });
  saveDB(DB);
  inp.value = "";
  renderChat();

  // Simulasi bot reply setelah 1-3 detik
  if (Math.random() > 0.4) {
    const bots = DB.users.filter(u => u.id !== currentUser.id);
    const bot = bots[Math.floor(Math.random() * bots.length)];
    const replies = [
      "Setuju banget! 👍", "Wah menarik, aku coba ya", "Ada yang tau cara solve lab 3?",
      "Mantap! 🔥", "Thanks sharing-nya", "Aku juga baru selesai lab itu",
      "Nice info!", "Besok ikut CTF gak?", "Boleh minta hint gak?",
    ];
    setTimeout(() => {
      DB.chat.push({
        id: Date.now(),
        from: bot.full_name,
        from_id: bot.id,
        text: replies[Math.floor(Math.random() * replies.length)],
        at: new Date().toISOString(),
      });
      saveDB(DB);
      if (document.getElementById("page-chat").classList.contains("active")) {
        renderChat();
        pushNotif(`💬 ${bot.full_name}: ${DB.chat[DB.chat.length-1].text.slice(0, 40)}...`, "info");
      }
    }, 1000 + Math.random() * 2000);
  }
}

function mentionUser(name) {
  const inp = document.getElementById("chatInput");
  inp.value = `@${name.split(" ")[0]} ${inp.value}`;
  inp.focus();
}

/* ============ ADMIN DASHBOARD ============ */
// dedup: // dedup: // dedup: let chartRoles, chartActivity;

function renderAdmin() {
  if (!currentUser || currentUser.role !== "admin") return;

  document.getElementById("adminUsers").textContent = DB.users.length;
  document.getElementById("adminActive").textContent = DB.users.filter(u => u.is_active).length;
  document.getElementById("adminActivity").textContent = (DB.progress || []).length;
  document.getElementById("adminContainers").textContent =
    (DB.containers || []).filter(c => c.status === "running").length;

  // Audit log
  const log = (DB.auditLog || []).slice(-20).reverse();
  document.getElementById("auditTable").innerHTML = log.length
    ? log.map(l => `<tr>
        <td><small>${new Date(l.at).toLocaleString("id-ID")}</small></td>
        <td><small>${l.user}</small></td>
        <td><span class="badge bg-secondary">${l.action}</span></td>
        <td><small>${l.detail || ""}</small></td>
      </tr>`).join("")
    : `<tr><td colspan="4" class="text-center text-muted py-3">
        Belum ada aktivitas tercatat.</td></tr>`;

  // Charts
  if (typeof Chart === "undefined") return;
  const ctxR = document.getElementById("chartRoles");
  const ctxA = document.getElementById("chartActivity");
  if (!ctxR || !ctxA) return;
  if (chartRoles) chartRoles.destroy();
  if (chartActivity) chartActivity.destroy();

  const roleCount = {admin:0, instructor:0, student:0};
  DB.users.forEach(u => roleCount[u.role] = (roleCount[u.role] || 0) + 1);

  const actCount = {lab:0, quiz:0, referral:0};
  (DB.progress || []).forEach(p => actCount[p.item_type] = (actCount[p.item_type] || 0) + 1);

  chartRoles = new Chart(ctxR, {
    type: "pie",
    data: {
      labels: Object.keys(roleCount),
      datasets: [{
        data: Object.values(roleCount),
        backgroundColor: ["#dc3545","#198754","#0d6efd"],
        borderWidth: 0,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { labels: { color: getComputedStyle(document.body).color } } }
    }
  });

  chartActivity = new Chart(ctxA, {
    type: "bar",
    data: {
      labels: Object.keys(actCount),
      datasets: [{
        label: "Jumlah",
        data: Object.values(actCount),
        backgroundColor: ["#dc3545","#ffc107","#198754"],
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: getComputedStyle(document.body).color }, grid: { display: false } },
        y: { ticks: { color: getComputedStyle(document.body).color }, grid: { color: "rgba(128,128,128,.15)" } }
      }
    }
  });
}

function logAction(action, detail) {
  DB.auditLog = DB.auditLog || [];
  DB.auditLog.push({
    at: new Date().toISOString(),
    user: currentUser?.full_name || "guest",
    action,
    detail,
  });
  if (DB.auditLog.length > 100) DB.auditLog = DB.auditLog.slice(-100);
  saveDB(DB);
}

function clearAuditLog() {
  if (!confirm("Hapus semua log audit?")) return;
  DB.auditLog = [];
  saveDB(DB);
  renderAdmin();
  showToast("Log dibersihkan");
}

/* ============ LOG STREAMING ============ */
// dedup: let logStreamId = null;
function openLogStream(cid) {
  const c = DB.containers.find(x => x.id === cid);
  if (!c) return;
  document.getElementById("logContainerName").textContent = c.container_id;
  document.getElementById("logStream").innerHTML = "";
  new bootstrap.Modal(document.getElementById("logModal")).show();
  startLogStream(c);
}

function logLine(text, cls = "") {
  const stream = document.getElementById("logStream");
  const div = document.createElement("div");
  div.className = "log-line " + cls;
  const ts = new Date().toLocaleTimeString("id-ID");
  div.textContent = `[${ts}] ${text}`;
  stream.appendChild(div);
  if (document.getElementById("logAutoScroll")?.checked) {
    stream.scrollTop = stream.scrollHeight;
  }
}

function startLogStream(c) {
  stopLogStream();
  logLine(`Attaching to ${c.container_id}...`, "log-info");
  logLine(`Image: ${c.image}`, "log-info");
  logLine(`Network isolated: ${c.network_isolated ? 'yes' : 'no'}`, "log-info");
  logLine(`Published port: ${c.port}`, "log-info");
  logLine("---", "log-info");

  const events = [
    ["[init] Loading configuration...", "log-info"],
    ["[init] Checking dependencies...", "log-info"],
    ["[init] Environment ready", "log-success"],
    ["[web] Starting service on port 80", "log-info"],
    ["[web] Listening on 0.0.0.0:80", "log-success"],
    ["[db] Connected to MySQL", "log-success"],
    ["[warn] Debug mode is ON", "log-warn"],
    ["[warn] Directory listing enabled", "log-warn"],
    ["[req] GET / 200 OK", "log-info"],
    ["[req] GET /login.php 200 OK", "log-info"],
    ["[req] POST /login.php 302 Redirect", "log-info"],
    ["[warn] SQL syntax error detected — potential SQLi attempt", "log-warn"],
    ["[req] GET /admin 403 Forbidden", "log-error"],
    ["[req] GET /robots.txt 200 OK", "log-info"],
    ["[note] Flag planted at /flag.txt", "log-success"],
  ];
// dedup: let idx = 0;
  logStreamId = setInterval(() => {
    if (idx >= events.length) {
      logLine("---", "log-info");
      logLine("Waiting for more events... (streaming)", "log-info");
      idx = 3;
      return;
    }
    logLine(events[idx][0], events[idx][1]);
    idx++;
  }, 1200);
}

function stopLogStream() {
  if (logStreamId) { clearInterval(logStreamId); logStreamId = null; }
}

/* ============ AUTO THEME (OS) ============ */
function autoThemeFromOS() {
  if (localStorage.getItem("cybersec_theme")) return; // sudah dipilih manual
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  document.documentElement.setAttribute("data-theme", prefersDark ? "dark" : "light");
  updateThemeBtn();
}
window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", e => {
  if (localStorage.getItem("cybersec_theme")) return;
  document.documentElement.setAttribute("data-theme", e.matches ? "dark" : "light");
  updateThemeBtn();
});


/* ============ VIDEO PLAYER ============ */
let currentVideo = null;
let videoTimer = null;

function openVideo(courseId, lessonIdx, title) {
  const vid = (DB.videos || []).find(v => v.lesson_id === lessonIdx) || {
    title, duration: 300,
  };
  currentVideo = { courseId, lessonIdx, title, duration: vid.duration, time: 0, playing: false };
  document.getElementById("videoTitle").textContent = title;
  document.getElementById("videoStage").innerHTML = `
    <div class="text-center">
      <i class="bi bi-camera-video-fill" style="font-size:4rem; opacity:.3;"></i>
      <div class="mt-2" style="opacity:.7;">[Simulasi Video]</div>
      <div class="mt-1" style="opacity:.5; font-size:.85rem;">${vid.title || title}</div>
    </div>
    <div class="play-big" id="videoPlayBtn" onclick="playVideo()" style="position:absolute;">
      <i class="bi bi-play-circle-fill"></i>
    </div>
  `;
  document.getElementById("videoStatus").textContent = "Paused";
  document.getElementById("videoProgress").style.width = "0%";
  updateVideoTime();
  new bootstrap.Modal(document.getElementById("videoModal")).show();
}

function playVideo() {
  if (!currentVideo) return;
  if (currentVideo.playing) {
    pauseVideo();
    return;
  }
  currentVideo.playing = true;
  const btn = document.getElementById("videoPlayBtn");
  if (btn) btn.innerHTML = '<i class="bi bi-pause-circle-fill"></i>';
  document.getElementById("videoStatus").textContent = "Playing";
  clearInterval(videoTimer);
  videoTimer = setInterval(() => {
    currentVideo.time += 2;
    if (currentVideo.time >= currentVideo.duration) {
      currentVideo.time = currentVideo.duration;
      pauseVideo();
      showToast("Video selesai! Klik 'Tandai Selesai'");
    }
    updateVideoTime();
  }, 100);
}

function pauseVideo() {
  if (!currentVideo) return;
  currentVideo.playing = false;
  clearInterval(videoTimer);
  const btn = document.getElementById("videoPlayBtn");
  if (btn) btn.innerHTML = '<i class="bi bi-play-circle-fill"></i>';
  document.getElementById("videoStatus").textContent = "Paused";
}

function updateVideoTime() {
  if (!currentVideo) return;
  const m1 = Math.floor(currentVideo.time / 60);
  const s1 = currentVideo.time % 60;
  const m2 = Math.floor(currentVideo.duration / 60);
  const s2 = currentVideo.duration % 60;
  document.getElementById("videoTime").textContent =
    `${String(m1).padStart(2,"0")}:${String(s1).padStart(2,"0")} / ${String(m2).padStart(2,"0")}:${String(s2).padStart(2,"0")}`;
  document.getElementById("videoProgress").style.width =
    (currentVideo.time / currentVideo.duration * 100) + "%";
}

function stopVideo() {
  pauseVideo();
  currentVideo = null;
}

function markCurrentVideoDone() {
  if (!currentVideo) return;
  markLessonComplete(currentVideo.courseId, currentVideo.lessonIdx);
  stopVideo();
  bootstrap.Modal.getInstance(document.getElementById("videoModal")).hide();
}

/* ============ MY COURSES ============ */
function isCoursePurchased(courseId) {
  if (!currentUser) return false;
  const c = DB.courses.find(x => x.id === courseId);
  if (!c) return false;
  if (c.price === 0) return true; // gratis
  return (DB.invoices || []).some(inv =>
    inv.user_id === currentUser.id && inv.course_id === courseId && inv.status === "paid"
  );
}

function renderMyCourses() {
  if (!currentUser) return;
  const purchased = DB.courses.filter(c => isCoursePurchased(c.id));
  document.getElementById("mcTotal").textContent = purchased.length;
  const done = purchased.filter(c => {
    const cp = (DB.courseProgress || []).find(x =>
      x.user_id === currentUser.id && x.course_id === c.id
    );
    return cp && cp.done === 9;
  }).length;
  document.getElementById("mcDone").textContent = done;
  document.getElementById("mcTime").textContent = purchased.length * 3 + "h";
  const spent = (DB.invoices || [])
    .filter(i => i.user_id === currentUser.id && i.status === "paid")
    .reduce((s, i) => s + i.total, 0);
  document.getElementById("mcSpent").textContent = "Rp " + spent.toLocaleString("id-ID");

  const grid = document.getElementById("myCoursesGrid");
  if (!purchased.length) {
    grid.innerHTML = `<div class="col-12 text-center text-muted py-5">
      <i class="bi bi-collection-play fs-1 d-block mb-2"></i>
      Belum ada course. Beli course dulu di menu Courses.
    </div>`;
  } else {
    grid.innerHTML = purchased.map(c => {
      const cp = (DB.courseProgress || []).find(x =>
        x.user_id === currentUser.id && x.course_id === c.id
      ) || { done: 0, lessons: [] };
      const pct = Math.round(cp.done / 9 * 100);
      return `
        <div class="col-md-6 col-lg-4">
          <div class="course-card p-3">
            <div class="d-flex justify-content-between mb-2">
              <span class="badge bg-secondary">${c.level}</span>
              <small class="text-muted">${c.duration_hours} jam</small>
            </div>
            <h6 class="mb-2">${c.title}</h6>
            <div class="course-progress-bar"><div style="width:${pct}%"></div></div>
            <small class="text-muted">${cp.done}/9 lesson • ${pct}%</small>
            <button class="btn btn-sm btn-info w-100 mt-2" onclick="viewCourseDetail(${c.id})">
              <i class="bi bi-play-fill"></i> Lanjut Belajar
            </button>
          </div>
        </div>`;
    }).join("");
  }

  // Invoice list
  const invs = (DB.invoices || []).filter(i => i.user_id === currentUser.id).reverse();
  document.getElementById("invoiceList").innerHTML = invs.length
    ? invs.map(inv => `
        <div class="invoice-card ${inv.status === 'paid' ? 'invoice-paid' : ''}">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="fw-bold">${inv.invoice_no}</div>
              <small class="text-muted">${new Date(inv.at).toLocaleString("id-ID")}</small>
              <div class="small mt-1">${inv.course_title}</div>
              <small class="text-muted">Metode: ${inv.method.toUpperCase()}</small>
            </div>
            <div class="text-end">
              <div class="fw-bold text-warning">Rp ${inv.total.toLocaleString("id-ID")}</div>
              <span class="badge bg-${inv.status === 'paid' ? 'success' : 'warning'}">${inv.status.toUpperCase()}</span>
            </div>
          </div>
        </div>`).join("")
    : `<div class="text-center text-muted py-3">Belum ada transaksi.</div>`;
}

/* ============ CHECKOUT ============ */
let checkoutCourseId = null;
let currentDiscount = 0;

function openCheckout(courseId) {
  const c = DB.courses.find(x => x.id === courseId);
  if (!c) return;
  checkoutCourseId = courseId;
  currentDiscount = 0;
  document.getElementById("checkoutCourse").innerHTML = `
    <div class="card p-3">
      <h6>${c.title}</h6>
      <small class="text-muted">${c.level} • ${c.duration_hours} jam</small>
    </div>
  `;
  document.getElementById("promoCode").value = "";
  document.getElementById("promoResult").innerHTML = "";
  document.getElementById("promoCode").oninput = applyPromo;
  updateCheckoutTotal();
  new bootstrap.Modal(document.getElementById("checkoutModal")).show();
}

function applyPromo() {
  const code = document.getElementById("promoCode").value.trim().toUpperCase();
  const c = DB.courses.find(x => x.id === checkoutCourseId);
  const el = document.getElementById("promoResult");
  if (!code) { currentDiscount = 0; el.innerHTML = ""; updateCheckoutTotal(); return; }
  const promos = { "CYBER20": 0.2, "HELLO10": 0.1, "CTF2025": 0.3 };
  if (promos[code]) {
    currentDiscount = c.price * promos[code];
    el.innerHTML = `<span class="text-success">✓ Kode ${code} berlaku (diskon ${Math.round(promos[code]*100)}%)</span>`;
  } else {
    currentDiscount = 0;
    el.innerHTML = `<span class="text-danger">✗ Kode tidak valid</span>`;
  }
  updateCheckoutTotal();
}

function updateCheckoutTotal() {
  const c = DB.courses.find(x => x.id === checkoutCourseId);
  if (!c) return;
  const subtotal = c.price;
  const disc = currentDiscount;
  const afterDisc = subtotal - disc;
  const tax = Math.round(afterDisc * 0.11);
  const total = afterDisc + tax;

  document.getElementById("coSubtotal").textContent = "Rp " + subtotal.toLocaleString("id-ID");
  document.getElementById("coDiscount").textContent = "-Rp " + disc.toLocaleString("id-ID");
  document.getElementById("coTax").textContent = "Rp " + tax.toLocaleString("id-ID");
  document.getElementById("coTotal").textContent = "Rp " + total.toLocaleString("id-ID");
}

function processPayment() {
  const c = DB.courses.find(x => x.id === checkoutCourseId);
  if (!c) return;
  const method = document.querySelector('input[name="payMethod"]:checked').value;
  const subtotal = c.price;
  const afterDisc = subtotal - currentDiscount;
  const tax = Math.round(afterDisc * 0.11);
  const total = afterDisc + tax;

  DB.invoices = DB.invoices || [];
  const inv = {
    id: Date.now(),
    user_id: currentUser.id,
    course_id: c.id,
    course_title: c.title,
    invoice_no: "INV-" + Date.now().toString(36).toUpperCase(),
    subtotal, discount: currentDiscount, tax, total,
    method,
    status: "paid",
    at: new Date().toISOString(),
  };
  DB.invoices.push(inv);
  saveDB(DB);
  logAction("PAYMENT", `${inv.invoice_no} - ${c.title}`);

  bootstrap.Modal.getInstance(document.getElementById("checkoutModal")).hide();
  pushNotif(`✅ Pembayaran berhasil: ${c.title}`, "success");
  sendWebNotif("Pembayaran Sukses", `${c.title} berhasil dibeli`);
  showToast("Pembayaran berhasil!");

  renderMyCourses();
  viewCourseDetail(c.id);
}

/* ============ CERT VERIFY ============ */
function verifyCert() {
  const input = document.getElementById("verifyInput").value.trim();
  const el = document.getElementById("verifyResult");
  if (!input) { el.innerHTML = '<span class="text-warning">Masukkan Certificate ID</span>'; return; }
  // Format: CSA-{TYPE}-{ITEM_ID}-{USER_ID}-{RANDOM}
  const parts = input.split("-");
  if (parts.length < 5 || parts[0] !== "CSA") {
    el.innerHTML = `<div class="alert alert-danger">
      <i class="bi bi-x-circle-fill"></i> <strong>INVALID</strong><br>
      Format Certificate ID tidak dikenali.
    </div>`;
    return;
  }
  const type = parts[1].toLowerCase();
  const itemId = parseInt(parts[2]);
  const userId = parseInt(parts[3]);
  const item = type === "lab"
    ? DB.labs.find(x => x.id === itemId)
    : DB.quizzes.find(x => x.id === itemId);
  const user = DB.users.find(u => u.id === userId);
  if (!item || !user) {
    el.innerHTML = `<div class="alert alert-danger">
      <i class="bi bi-x-circle-fill"></i> <strong>INVALID</strong><br>
      Sertifikat tidak ditemukan di database.
    </div>`;
    return;
  }
  const prog = DB.progress.find(p => p.user_id === userId &&
    p.item_type === type && p.item_id === itemId);
  if (currentUser) {
    DB.user_badges = DB.user_badges || [];
    const hasVerifier = DB.user_badges.some(b => b.user_id === currentUser.id && b.badge_id === "verifier");
    if (!hasVerifier) {
      DB.user_badges.push({user_id: currentUser.id, badge_id: "verifier", earned_at: new Date().toISOString()});
      saveDB(DB);
      const b = DB.badges.find(x => x.id === "verifier");
      if (b) showBadgeToast(b);
    }
  }
  el.innerHTML = `<div class="alert alert-success">
    <i class="bi bi-patch-check-fill fs-3 d-block mb-2"></i>
    <strong>✓ SERTIFIKAT ASLI</strong>
    <hr class="my-2">
    <div><strong>Nama:</strong> ${user.full_name}</div>
    <div><strong>${type === 'lab' ? 'Lab' : 'Quiz'}:</strong> ${item.title}</div>
    <div><strong>Poin:</strong> +${prog?.points || 0}</div>
    <div><strong>ID:</strong> <code>${input}</code></div>
    <small class="text-muted d-block mt-2">Diterbitkan oleh CyberSec Academy</small>
  </div>`;
}

/* ============ STANDALONE EXPORT ============ */
function exportStandalone() {
  // Buat versi HTML standalone dengan semua CSS/JS inline
  const clone = document.documentElement.cloneNode(true);
  // Hapus elemen yang tidak perlu
  clone.querySelectorAll("[data-standalone-remove]").forEach(e => e.remove());
  const html = "<!DOCTYPE html>\n" + clone.outerHTML;
  const blob = new Blob([html], { type: "text/html" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `cybersec-standalone-${Date.now()}.html`;
  a.click();
  URL.revokeObjectURL(url);
  showToast("File standalone ter-download");
}


/* ============ BLOCK PAID COURSES ============ */
function canAccessCourse(courseId) {
  if (!currentUser) return false;
  const c = DB.courses.find(x => x.id === courseId);
  if (!c) return false;
  if (c.price === 0) return true;
  if (currentUser.role === "admin") return true; // admin bypass
  return (DB.invoices || []).some(inv =>
    inv.user_id === currentUser.id && inv.course_id === courseId && inv.status === "paid"
  );
}

function showLockedOverlay(courseId) {
  const c = DB.courses.find(x => x.id === courseId);
  if (!c) return "";
  return `
    <div class="locked-overlay">
      <i class="bi bi-lock-fill"></i>
      <h5 class="mt-2">Course Terkunci</h5>
      <p class="text-muted small mb-2">Course ini berbayar. Beli untuk membuka semua modul & lesson.</p>
      <div class="fs-4 fw-bold text-warning mb-2">Rp ${c.price.toLocaleString("id-ID")}</div>
      <button class="btn btn-warning" onclick="openCheckout(${c.id})">
        <i class="bi bi-cart-fill"></i> Beli Sekarang
      </button>
      ${!currentUser ? '<p class="small text-muted mt-2">Login dulu untuk membeli.</p>' : ""}
    </div>`;
}

/* ============ GOOGLE LOGIN MOCK ============ */
function loginWithGoogle() {
  // Popup simulasi
  const w = 500, h = 600;
  const left = (screen.width - w) / 2;
  const top = (screen.height - h) / 2;
  const win = window.open("", "googleLogin",
    `width=${w},height=${h},left=${left},top=${top},toolbar=no,menubar=no`);

  if (win) {
    win.document.write(`
      <html>
      <head><title>Sign in with Google</title>
      <style>
        body { font-family:-apple-system,sans-serif; display:flex; align-items:center;
               justify-content:center; min-height:100vh; margin:0;
               background:#f6f8fa; }
        .card { background:#fff; padding:2rem; border-radius:1rem;
                box-shadow:0 4px 20px rgba(0,0,0,.1); width:320px; text-align:center; }
        .logo { font-size:2rem; margin-bottom:1rem; }
        h3 { margin:0 0 .5rem; }
        p { color:#656d76; font-size:.9rem; }
        .account { display:flex; align-items:center; gap:.75rem; padding:.75rem;
                   border:1px solid #d0d7de; border-radius:.5rem; margin-bottom:.5rem;
                   cursor:pointer; transition:background .15s; text-align:left; }
        .account:hover { background:#f6f8fa; }
        .avatar { width:2.5rem; height:2.5rem; border-radius:50%;
                  display:flex; align-items:center; justify-content:center;
                  color:#fff; font-weight:bold; font-size:1.1rem; }
        .name { font-weight:500; font-size:.9rem; }
        .email { color:#656d76; font-size:.8rem; }
        button.close { margin-top:1rem; padding:.5rem 1rem; border:1px solid #d0d7de;
                       background:#fff; border-radius:.4rem; cursor:pointer; }
      </style>
      </head>
      <body>
      <div class="card">
        <div class="logo">🔐</div>
        <h3>Choose an account</h3>
        <p>to continue to CyberSec Academy</p>

        <div class="account" onclick="pick('demo.cybersec@gmail.com','Demo Cyber')">
          <div class="avatar" style="background:#1f6feb;">D</div>
          <div>
            <div class="name">Demo Cyber</div>
            <div class="email">demo.cybersec@gmail.com</div>
          </div>
        </div>

        <div class="account" onclick="pick('budi.santoso@gmail.com','Budi Santoso')">
          <div class="avatar" style="background:#198754;">B</div>
          <div>
            <div class="name">Budi Santoso</div>
            <div class="email">budi.santoso@gmail.com</div>
          </div>
        </div>

        <div class="account" onclick="pick('siti.aminah@gmail.com','Siti Aminah')">
          <div class="avatar" style="background:#dc3545;">S</div>
          <div>
            <div class="name">Siti Aminah</div>
            <div class="email">siti.aminah@gmail.com</div>
          </div>
        </div>

        <button class="close" onclick="window.close()">Cancel</button>
      </div>
      <script>
        function pick(email, name) {
          if (window.opener) {
            window.opener.handleGoogleLogin(email, name);
            window.close();
          }
        }
      </script>
      </body>
      </html>
    `);
    win.document.close();
  } else {
    // Fallback: popup diblokir, langsung login sebagai Demo
    handleGoogleLogin("demo.cybersec@gmail.com", "Demo Cyber");
  }
}

function handleGoogleLogin(email, name) {
  // Cari user existing berdasarkan email
  let user = DB.users.find(u => u.email === email);
  if (!user) {
    // Auto-register
    user = {
      id: nextId(DB.users),
      full_name: name,
      email,
      password: "(google-oauth)",
      role: "student",
      is_active: true,
      provider: "google",
    };
    DB.users.push(user);
    saveDB(DB);
    logAction("GOOGLE_REGISTER", email);
  }
  logAction("GOOGLE_LOGIN", email);
  loginAs(user);
}

window.handleGoogleLogin = handleGoogleLogin;

/* ============ LOGIN HISTORY & SESSIONS ============ */
function recordLogin() {
  if (!currentUser) return;
  DB.loginHistory = DB.loginHistory || [];
  DB.loginHistory.unshift({
    user_id: currentUser.id,
    at: new Date().toISOString(),
    ua: navigator.userAgent.slice(0, 100),
    device: navigator.platform || "Unknown",
  });
  if (DB.loginHistory.length > 50) DB.loginHistory = DB.loginHistory.slice(0, 50);
  DB.sessions = DB.sessions || [];
  DB.sessions.push({
    id: Date.now(),
    user_id: currentUser.id,
    started_at: new Date().toISOString(),
    ua: navigator.userAgent.slice(0, 100),
  });
  saveDB(DB);
}

/* ============ RAPOR ============ */
function renderRapor() {
  if (!currentUser) return;
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const labs = mine.filter(p => p.item_type === "lab");
  const quizzes = mine.filter(p => p.item_type === "quiz");
  const refs = mine.filter(p => p.item_type === "referral");
  const totalPoints = mine.reduce((s,p) => s + p.points, 0);

  const courses = DB.courses.filter(c => isCoursePurchased(c.id));
  const finishedCourses = courses.filter(c => {
    const cp = (DB.courseProgress || []).find(x =>
      x.user_id === currentUser.id && x.course_id === c.id
    );
    return cp && cp.done === 9;
  });

  const badges = (DB.user_badges || []).filter(b => b.user_id === currentUser.id);
  const certs = mine.length;
  const spent = (DB.invoices || [])
    .filter(i => i.user_id === currentUser.id && i.status === "paid")
    .reduce((s, i) => s + i.total, 0);

  // Hitung grade
  let grade = "D";
  let gradeColor = "secondary";
  const score = Math.min(100, Math.round(totalPoints / 10));
  if (score >= 90) { grade = "A"; gradeColor = "success"; }
  else if (score >= 80) { grade = "B"; gradeColor = "info"; }
  else if (score >= 70) { grade = "C"; gradeColor = "warning"; }
  else if (score >= 60) { grade = "D"; gradeColor = "secondary"; }
  else { grade = "E"; gradeColor = "danger"; }

  // Rank
  const totals = {};
  DB.users.forEach(u => totals[u.id] = {id:u.id, points:0});
  DB.progress.forEach(p => { if (totals[p.user_id]) totals[p.user_id].points += p.points; });
  const ranked = Object.values(totals).sort((a,b) => b.points - a.points);
  const rank = ranked.findIndex(r => r.id === currentUser.id) + 1;

  document.getElementById("raporContent").innerHTML = `
    <div class="rapor-section">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <h4 class="mb-1">${currentUser.full_name}</h4>
          <div class="text-muted">${currentUser.email}</div>
          <span class="badge bg-${currentUser.role === 'admin' ? 'danger' : 'primary'} mt-1">${currentUser.role.toUpperCase()}</span>
        </div>
        <div class="text-center">
          <div class="text-muted small">Grade</div>
          <div class="display-3 fw-bold text-${gradeColor}">${grade}</div>
          <div class="text-muted small">Score: ${score}/100</div>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <div class="rapor-section">
          <h6><i class="bi bi-graph-up-arrow text-info"></i> Statistik Belajar</h6>
          <table class="table table-sm table-borderless mb-0">
            <tr><td>Total Poin</td><td class="text-end text-warning fw-bold">${totalPoints.toLocaleString("id-ID")}</td></tr>
            <tr><td>Peringkat Global</td><td class="text-end">#${rank} dari ${DB.users.length}</td></tr>
            <tr><td>Labs Selesai</td><td class="text-end">${labs.length}</td></tr>
            <tr><td>Quiz Lulus</td><td class="text-end">${quizzes.length}</td></tr>
            <tr><td>Course Diikuti</td><td class="text-end">${courses.length}</td></tr>
            <tr><td>Course Selesai 100%</td><td class="text-end">${finishedCourses.length}</td></tr>
            <tr><td>Badge Diperoleh</td><td class="text-end">${badges.length}/${DB.badges.length}</td></tr>
            <tr><td>Sertifikat</td><td class="text-end">${certs}</td></tr>
            <tr><td>Referral</td><td class="text-end">${refs.length}</td></tr>
            <tr><td>Total Belanja</td><td class="text-end text-warning">Rp ${spent.toLocaleString("id-ID")}</td></tr>
          </table>
        </div>
      </div>

      <div class="col-md-6">
        <div class="rapor-section">
          <h6><i class="bi bi-list-check text-success"></i> Capaian Detail</h6>
          <table class="table table-sm mb-0">
            <thead><tr><th>Item</th><th class="text-end">Poin</th></tr></thead>
            <tbody>
              ${mine.length ? mine.map(p => {
                let title = "—";
                if (p.item_type === "lab") {
                  const l = DB.labs.find(x => x.id === p.item_id);
                  title = l ? "Lab: " + l.title : "—";
                } else if (p.item_type === "quiz") {
                  const q = DB.quizzes.find(x => x.id === p.item_id);
                  title = q ? "Quiz: " + q.title : "—";
                } else if (p.item_type === "referral") {
                  title = "Referral";
                }
                return `<tr><td><small>${title}</small></td>
                  <td class="text-end text-success">+${p.points}</td></tr>`;
              }).join("") : '<tr><td colspan="2" class="text-muted text-center">Belum ada</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="rapor-section">
      <h6><i class="bi bi-chat-quote text-info"></i> Catatan & Rekomendasi</h6>
      <p class="mb-1">${score >= 80
        ? "🎉 Luar biasa! Performa kamu sangat baik. Lanjutkan ke materi advanced seperti Malware Analysis atau Cloud Security."
        : score >= 60
          ? "👍 Progres bagus! Perbanyak latihan di lab supaya pemahaman makin kuat."
          : "💪 Jangan menyerah! Coba selesaikan lebih banyak lab pemula dulu untuk membangun fondasi."}</p>
      <small class="text-muted">Dicetak: ${new Date().toLocaleString("id-ID")} • CyberSec Academy</small>
    </div>
  `;
}

function printRapor() {
  renderRapor();
  // Clone area rapor ke print area
  let printArea = document.querySelector(".print-area");
  if (!printArea) {
    printArea = document.createElement("div");
    printArea.className = "print-area";
    document.body.appendChild(printArea);
  }
  printArea.innerHTML = `
    <div style="text-align:center; padding:2rem; border-bottom:3px double #1f6feb;">
      <h1 style="margin:0; color:#1f6feb;">CyberSec Academy</h1>
      <div style="letter-spacing:3px; color:#6c757d;">RAPOR BELAJAR</div>
    </div>
    <div style="padding:2rem; font-family:Georgia, serif;">
      ${document.getElementById("raporContent").innerHTML}
    </div>
  `;
  setTimeout(() => window.print(), 300);
}

/* ============ MULTI-DEVICE SYNC (via BroadcastChannel) ============ */
let syncChannel = null;
function initSync() {
  if (!("BroadcastChannel" in window)) return;
  try {
    syncChannel = new BroadcastChannel("cybersec_sync");
    syncChannel.onmessage = e => {
      if (e.data.type === "DB_UPDATE") {
        DB = loadDB();
        if (currentUser) {
          refreshAll();
          showToast("Data disinkronkan dari tab lain", "info");
        }
      } else if (e.data.type === "USER_LOGIN") {
        showSyncIndicator(true);
      } else if (e.data.type === "USER_LOGOUT") {
        showSyncIndicator(false);
      }
    };
  } catch (_) {}
}

function broadcastDBUpdate() {
  if (!syncChannel) return;
  try {
    syncChannel.postMessage({ type: "DB_UPDATE", at: Date.now() });
  } catch (_) {}
}

function showSyncIndicator(online) {
  const el = document.getElementById("syncIndicator");
  if (!el) return;
  if (online) {
    el.className = "sync-indicator";
    el.innerHTML = '<i class="bi bi-cloud-check"></i> Sync';
  } else {
    el.className = "sync-indicator offline";
    el.innerHTML = '<i class="bi bi-cloud-slash"></i> Offline';
  }
}

// Update saveDB agar broadcast
const _origSaveDB = saveDB;
saveDB = function(db) {
  _origSaveDB(db);
  broadcastDBUpdate();
};

// Online/offline detection
window.addEventListener("online", () => showSyncIndicator(true));
window.addEventListener("offline", () => showSyncIndicator(false));
if (!navigator.onLine) showSyncIndicator(false);

/* ============ EXPORT/IMPORT tambahan ============ */
function exportFullBackup() {
  const data = {
    version: "1.0",
    at: new Date().toISOString(),
    user: currentUser,
    db: DB,
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `cybersec-full-backup-${Date.now()}.json`;
  a.click();
  URL.revokeObjectURL(url);
  showToast("Backup lengkap ter-download");
}


/* ============ CHAT WEBSOCKET SIM (typing indicator) ============ */
function simulateTyping() {
  const box = document.getElementById("chatBox");
  if (!box) return;
  const typing = document.createElement("div");
  typing.id = "typingIndicator";
  typing.className = "chat-msg";
  typing.innerHTML = `
    <div class="chat-bubble">
      <div class="chat-meta">Seseorang sedang menulis...</div>
      <div class="chat-typing"><span></span><span></span><span></span></div>
    </div>`;
  box.appendChild(typing);
  box.scrollTop = box.scrollHeight;
  setTimeout(() => typing.remove(), 1800);
}

/* Override sendChat supaya ada typing indicator */
const _origSendChat = sendChat;
sendChat = function() {
  _origSendChat();
  // Bot typing indicator lalu reply
  if (Math.random() > 0.3) {
    setTimeout(simulateTyping, 300);
  }
};

/* ============ PAYMENT POLLING ============ */
function processPaymentWithPolling(courseId) {
  const c = DB.courses.find(x => x.id === courseId);
  if (!c) return;
  const method = document.querySelector('input[name="payMethod"]:checked')?.value || "transfer";
  const subtotal = c.price;
  const afterDisc = subtotal - (currentDiscount || 0);
  const tax = Math.round(afterDisc * 0.11);
  const total = afterDisc + tax;
  const invNo = "INV-" + Date.now().toString(36).toUpperCase();

  document.getElementById("payInvoice").textContent = invNo;
  document.getElementById("payTotal").textContent = "Rp " + total.toLocaleString("id-ID");
  document.getElementById("payProgress").style.width = "0%";
  document.getElementById("payStatusText").textContent = "Memverifikasi dengan payment gateway";

  const modal = new bootstrap.Modal(document.getElementById("paymentModal"));
  modal.show();

  const steps = [
    { pct: 20, txt: "Menghubungi bank..." },
    { pct: 40, txt: "Verifikasi OTP..." },
    { pct: 60, txt: "Memproses transaksi..." },
    { pct: 80, txt: "Menunggu konfirmasi merchant..." },
    { pct: 100, txt: "Pembayaran berhasil!" },
  ];
  let i = 0;
  const timer = setInterval(() => {
    if (i < steps.length) {
      document.getElementById("payProgress").style.width = steps[i].pct + "%";
      document.getElementById("payStatusText").textContent = steps[i].txt;
      i++;
    } else {
      clearInterval(timer);
      const el = document.getElementById("payPending");
      el.className = "payment-status success";
      el.innerHTML = `
        <i class="bi bi-check-circle-fill fs-2 text-success"></i>
        <div>
          <div class="fw-bold text-success">Pembayaran Sukses!</div>
          <small class="text-muted">Invoice ${invNo}</small>
        </div>`;
      setTimeout(() => {
        modal.hide();
        // Simpan invoice
        DB.invoices = DB.invoices || [];
        DB.invoices.push({
          id: Date.now(), user_id: currentUser.id, course_id: c.id,
          course_title: c.title, invoice_no: invNo,
          subtotal, discount: currentDiscount || 0, tax, total,
          method, status: "paid", at: new Date().toISOString(),
        });
        saveDB(DB);
        logAction("PAYMENT", `${invNo} - ${c.title}`);
        pushNotif(`✅ Pembayaran berhasil: ${c.title}`, "success");
        sendWebNotif("Pembayaran Sukses", `${c.title} berhasil dibeli`);
        showToast("Pembayaran berhasil!");
        renderMyCourses();
        viewCourseDetail(c.id);
      }, 800);
    }
  }, 700);
}

/* Override processPayment untuk pakai polling */
const _origProcessPayment = processPayment;
processPayment = function() {
  if (!checkoutCourseId) return;
  bootstrap.Modal.getInstance(document.getElementById("checkoutModal"))?.hide();
  setTimeout(() => processPaymentWithPolling(checkoutCourseId), 300);
};

/* ============ SHARE PROGRESS ============ */
function renderShare() {
  if (!currentUser) return;
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const total = mine.reduce((s,p) => s + p.points, 0);

  const totals = {};
  DB.users.forEach(u => totals[u.id] = {id:u.id, points:0});
  DB.progress.forEach(p => { if (totals[p.user_id]) totals[p.user_id].points += p.points; });
  const ranked = Object.values(totals).sort((a,b) => b.points - a.points);
  const rank = ranked.findIndex(r => r.id === currentUser.id) + 1;

  const badges = (DB.user_badges || []).filter(b => b.user_id === currentUser.id).length;
  const labs = mine.filter(p => p.item_type === "lab").length;

  document.getElementById("shareBigScore").textContent = total.toLocaleString("id-ID");
  document.getElementById("shareUserName").textContent = currentUser.full_name;
  document.getElementById("shareRank").textContent = "#" + rank;
  document.getElementById("shareBadges").textContent = badges;
  document.getElementById("shareLabs").textContent = labs;

  // Generate share code
  const code = "CSA-" + btoa(currentUser.id + ":" + total).slice(0, 10).toUpperCase().replace(/=/g, "");
  document.getElementById("shareCode").textContent = "Share ID: " + code;

  // Shared history
  const hist = (DB.sharedReports || []).filter(r => r.user_id === currentUser.id).slice(-5).reverse();
  const el = document.getElementById("sharedHistory");
  el.innerHTML = hist.length ? hist.map(r => `
    <div class="d-flex justify-content-between py-1 border-bottom border-secondary">
      <span>${r.channel}</span>
      <small class="text-muted">${new Date(r.at).toLocaleString("id-ID")}</small>
    </div>`).join("") : '<span class="text-muted">Belum ada share</span>';
}

function buildShareText() {
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const total = mine.reduce((s,p) => s + p.points, 0);
  const labs = mine.filter(p => p.item_type === "lab").length;
  return `🎯 Saya sudah mengumpulkan ${total.toLocaleString("id-ID")} poin dan menyelesaikan ${labs} lab di CyberSec Academy! 🚀 Ayo ikutan belajar keamanan siber! #CyberSecAcademy`;
}

function shareTo(channel) {
  const text = buildShareText();
  const url = window.location.origin + "/app.html";
  const enc = encodeURIComponent;
  const urls = {
    twitter: `https://twitter.com/intent/tweet?text=${enc(text)}&url=${enc(url)}`,
    linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
    whatsapp: `https://wa.me/?text=${enc(text + " " + url)}`,
  };
  if (urls[channel]) {
    window.open(urls[channel], "_blank", "width=600,height=500");
    DB.sharedReports = DB.sharedReports || [];
    DB.sharedReports.push({user_id: currentUser.id, channel, at: new Date().toISOString()});
    saveDB(DB);
    renderShare();
    showToast(`Shared ke ${channel}`);
  }
}

function copyShareLink() {
  const code = document.getElementById("shareCode").textContent.replace("Share ID: ", "");
  const url = window.location.origin + "/app.html?share=" + code;
  navigator.clipboard?.writeText(url).then(() => {
    DB.sharedReports = DB.sharedReports || [];
    DB.sharedReports.push({user_id: currentUser.id, channel: "link", at: new Date().toISOString()});
    saveDB(DB);
    renderShare();
    showToast("Link dicopy!");
  });
}

function downloadShareImage() {
  // Generate SVG share card
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const total = mine.reduce((s,p) => s + p.points, 0);
  const labs = mine.filter(p => p.item_type === "lab").length;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
    <defs>
      <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1f6feb"/>
        <stop offset="1" stop-color="#6f42c1"/>
      </linearGradient>
    </defs>
    <rect width="600" height="400" rx="20" fill="url(#g)"/>
    <text x="300" y="70" text-anchor="middle" font-family="sans-serif" fill="#fff" font-size="20" opacity=".8">CYBERSEC ACADEMY</text>
    <text x="300" y="200" text-anchor="middle" font-family="sans-serif" fill="#fff" font-size="80" font-weight="bold">${total}</text>
    <text x="300" y="240" text-anchor="middle" font-family="sans-serif" fill="#fff" font-size="16" opacity=".8" letter-spacing="4">TOTAL POIN</text>
    <text x="300" y="290" text-anchor="middle" font-family="sans-serif" fill="#fff" font-size="22">${currentUser.full_name}</text>
    <text x="300" y="330" text-anchor="middle" font-family="sans-serif" fill="#fff" font-size="16" opacity=".8">${labs} Labs • ${(DB.user_badges||[]).filter(b=>b.user_id===currentUser.id).length} Badges</text>
  </svg>`;
  const blob = new Blob([svg], { type: "image/svg+xml" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `cybersec-progress-${currentUser.id}.svg`;
  a.click();
  URL.revokeObjectURL(url);
  showToast("Image ter-download (SVG)");
}

/* ============ API DOCS RENDER ============ */
const ENDPOINTS = [
  { method:"POST", path:"/auth/login", desc:"Login user" },
  { method:"POST", path:"/auth/register", desc:"Register user baru" },
  { method:"GET", path:"/auth/me", desc:"Info user login (butuh token)" },
  { method:"GET", path:"/users", desc:"List users (pagination + search)" },
  { method:"POST", path:"/users", desc:"Create user (admin)" },
  { method:"PUT", path:"/users/{id}", desc:"Update user (admin)" },
  { method:"DELETE", path:"/users/{id}", desc:"Delete user (admin)" },
  { method:"GET", path:"/courses", desc:"List courses" },
  { method:"POST", path:"/courses", desc:"Create course (admin)" },
  { method:"PUT", path:"/courses/{id}", desc:"Update course" },
  { method:"DELETE", path:"/courses/{id}", desc:"Delete course" },
  { method:"GET", path:"/labs", desc:"List labs" },
  { method:"POST", path:"/labs/{id}/submit", desc:"Submit flag lab" },
  { method:"GET", path:"/quizzes", desc:"List quizzes" },
  { method:"POST", path:"/quizzes/{id}/submit", desc:"Submit quiz answers" },
  { method:"GET", path:"/tools", desc:"List cyber tools" },
  { method:"GET", path:"/events", desc:"List events" },
  { method:"POST", path:"/events/{id}/register", desc:"Register event" },
  { method:"GET", path:"/dashboard/stats", desc:"Statistik global" },
  { method:"GET", path:"/dashboard/recent", desc:"5 item terbaru tiap modul" },
  { method:"GET", path:"/leaderboard", desc:"Ranking user" },
];

function renderApiDocs() {
  const el = document.getElementById("apiEndpoints");
  el.innerHTML = ENDPOINTS.map(e => `
    <div class="api-endpoint">
      <span class="api-method api-${e.method.toLowerCase()}">${e.method}</span>
      <code style="flex:1;">${e.path}</code>
      <small class="text-muted">${e.desc}</small>
    </div>
  `).join("");
}


/* ============ NOTES ============ */
let selectedNoteColor = "yellow";
const NOTE_COLORS = {
  yellow: { bg: "#3d3419", border: "#ffc107" },
  blue:   { bg: "#172a45", border: "#0d6efd" },
  green:  { bg: "#17341d", border: "#198754" },
  red:    { bg: "#3d1a1a", border: "#dc3545" },
  purple: { bg: "#2d1f45", border: "#6f42c1" },
};

function renderNotes() {
  if (!currentUser) return;
  const notes = (DB.bookmarks || []).filter(n => n.user_id === currentUser.id);
  const q = (document.getElementById("noteSearch")?.value || "").toLowerCase();
  const cf = document.getElementById("noteColorFilter")?.value || "";
  const filtered = notes.filter(n =>
    (!q || n.title.toLowerCase().includes(q) || n.content.toLowerCase().includes(q)) &&
    (!cf || n.color === cf)
  ).sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));

  const grid = document.getElementById("notesGrid");
  if (!filtered.length) {
    grid.innerHTML = `<div class="col-12 text-center text-muted py-5">
      <i class="bi bi-journal-text fs-1 d-block mb-2"></i>
      Belum ada catatan. Klik <strong>Catatan Baru</strong> untuk mulai.
    </div>`;
    return;
  }
  grid.innerHTML = filtered.map(n => {
    const c = NOTE_COLORS[n.color] || NOTE_COLORS.yellow;
    return `
      <div class="col-md-6 col-lg-4">
        <div class="note-card" style="background:${c.bg};border-left:4px solid ${c.border};">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="mb-0">${n.title || "(tanpa judul)"}</h6>
            <div class="actions">
              <button class="btn btn-sm btn-link text-info p-0 me-2" onclick="openNoteModal(${n.id})">
                <i class="bi bi-pencil"></i>
              </button>
              <button class="btn btn-sm btn-link text-danger p-0" onclick="deleteNote(${n.id})">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          </div>
          <p class="small mb-2" style="white-space:pre-wrap;">${n.content || ""}</p>
          <small class="text-muted">${new Date(n.updated_at).toLocaleString("id-ID")}</small>
        </div>
      </div>`;
  }).join("");
}

function openNoteModal(id) {
  document.getElementById("noteModalTitle").textContent = id ? "Edit Catatan" : "Catatan Baru";
  if (id) {
    const n = DB.bookmarks.find(x => x.id === id);
    document.getElementById("noteId").value = n.id;
    document.getElementById("noteTitle").value = n.title;
    document.getElementById("noteContent").value = n.content;
    document.getElementById("noteColor").value = n.color;
    selectedNoteColor = n.color;
  } else {
    document.getElementById("noteId").value = "";
    document.getElementById("noteTitle").value = "";
    document.getElementById("noteContent").value = "";
    document.getElementById("noteColor").value = "yellow";
    selectedNoteColor = "yellow";
  }
  // Highlight selected color
  document.querySelectorAll("[data-color]").forEach(b => {
    b.style.border = b.dataset.color === selectedNoteColor ? "3px solid #fff" : "0";
  });
  new bootstrap.Modal(document.getElementById("noteModal")).show();
}

function selectNoteColor(color) {
  selectedNoteColor = color;
  document.getElementById("noteColor").value = color;
  document.querySelectorAll("[data-color]").forEach(b => {
    b.style.border = b.dataset.color === color ? "3px solid #fff" : "0";
  });
}

function saveNote() {
  const id = document.getElementById("noteId").value;
  const data = {
    title: document.getElementById("noteTitle").value.trim() || "(tanpa judul)",
    content: document.getElementById("noteContent").value,
    color: document.getElementById("noteColor").value,
  };
  DB.bookmarks = DB.bookmarks || [];
  if (id) {
    const n = DB.bookmarks.find(x => x.id === parseInt(id));
    Object.assign(n, data, { updated_at: new Date().toISOString() });
  } else {
    DB.bookmarks.push({
      id: Date.now(),
      user_id: currentUser.id,
      ...data,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    });
    logAction("NOTE_CREATE", data.title);
  }
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("noteModal")).hide();
  renderNotes();
  showToast(id ? "Catatan diupdate" : "Catatan ditambahkan");
}

function deleteNote(id) {
  if (!confirm("Hapus catatan ini?")) return;
  DB.bookmarks = DB.bookmarks.filter(n => n.id !== id);
  saveDB(DB);
  renderNotes();
  showToast("Catatan dihapus");
}

/* ============ POMODORO ============ */
let pomodoroState = {
  running: false,
  mode: "focus", // focus, break, long
  seconds: 25 * 60,
  totalSeconds: 25 * 60,
  timer: null,
  sessions: 0,
  focusMinutesToday: 0,
};

function renderPomodoro() {
  updatePomodoroDisplay();
  document.getElementById("pomoFocus").value = DB.settings?.pomoFocus || 25;
  document.getElementById("pomoBreak").value = DB.settings?.pomoBreak || 5;
  document.getElementById("pomoLong").value = DB.settings?.pomoLong || 15;
  document.getElementById("pomodoroSessions").textContent = pomodoroState.sessions;
  document.getElementById("pomodoroFocus").textContent = pomodoroState.focusMinutesToday + "m";

  // History
  const hist = (DB.pomodoroHistory || []).filter(h => h.user_id === currentUser.id).slice(-5).reverse();
  const el = document.getElementById("pomodoroHistory");
  el.innerHTML = hist.length ? hist.map(h => `
    <div class="d-flex justify-content-between py-1 border-bottom border-secondary">
      <span>${h.mode === "focus" ? "🎯 Fokus" : "☕ Istirahat"} ${h.minutes}m</span>
      <small class="text-muted">${new Date(h.at).toLocaleString("id-ID")}</small>
    </div>`).join("") : '<span class="text-muted">Belum ada sesi</span>';
}

function updatePomodoroDisplay() {
  const m = Math.floor(pomodoroState.seconds / 60);
  const s = pomodoroState.seconds % 60;
  document.getElementById("pomodoroTime").textContent =
    `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
  document.getElementById("pomodoroMode").textContent =
    pomodoroState.mode === "focus" ? "Waktu Fokus" :
    pomodoroState.mode === "break" ? "Istirahat Pendek" : "Istirahat Panjang";

  const pct = (pomodoroState.totalSeconds - pomodoroState.seconds) / pomodoroState.totalSeconds;
  const deg = pct * 360;
  const color = pomodoroState.mode === "focus" ? "#1f6feb" : "#198754";
  document.getElementById("pomodoroRing").style.background =
    `conic-gradient(${color} ${deg}deg, #21262d ${deg}deg)`;

  const btn = document.getElementById("pomodoroStart");
  if (btn) {
    btn.innerHTML = pomodoroState.running
      ? '<i class="bi bi-pause-fill"></i> Pause'
      : '<i class="bi bi-play-fill"></i> Start';
    btn.className = pomodoroState.running ? "btn btn-warning" : "btn btn-success";
  }
}

function togglePomodoro() {
  if (pomodoroState.running) {
    clearInterval(pomodoroState.timer);
    pomodoroState.running = false;
    updatePomodoroDisplay();
    return;
  }
  pomodoroState.running = true;
  pomodoroState.timer = setInterval(() => {
    pomodoroState.seconds--;
    if (pomodoroState.seconds <= 0) {
      clearInterval(pomodoroState.timer);
      pomodoroState.running = false;
      const minutes = Math.round(pomodoroState.totalSeconds / 60);
      if (pomodoroState.mode === "focus") {
        pomodoroState.sessions++;
        pomodoroState.focusMinutesToday += minutes;
        DB.pomodoroHistory = DB.pomodoroHistory || [];
        DB.pomodoroHistory.push({
          user_id: currentUser.id, mode: "focus",
          minutes, at: new Date().toISOString(),
        });
        saveDB(DB);
        pushNotif(`🎯 Sesi fokus ${minutes} menit selesai! Waktunya istirahat.`, "success");
        sendWebNotif("Pomodoro Selesai", `Fokus ${minutes} menit selesai. Istirahat dulu!`);
        pomodoroState.mode = "break";
        pomodoroState.totalSeconds = (DB.settings?.pomoBreak || 5) * 60;
      } else {
        DB.pomodoroHistory.push({
          user_id: currentUser.id, mode: pomodoroState.mode,
          minutes, at: new Date().toISOString(),
        });
        saveDB(DB);
        pushNotif(`☕ Istirahat selesai! Lanjut fokus lagi.`, "info");
        pomodoroState.mode = "focus";
        pomodoroState.totalSeconds = (DB.settings?.pomoFocus || 25) * 60;
      }
      pomodoroState.seconds = pomodoroState.totalSeconds;
      renderPomodoro();
    }
    updatePomodoroDisplay();
  }, 1000);
}

function resetPomodoro() {
  clearInterval(pomodoroState.timer);
  pomodoroState.running = false;
  const mins = pomodoroState.mode === "focus"
    ? (DB.settings?.pomoFocus || 25)
    : (DB.settings?.pomoBreak || 5);
  pomodoroState.seconds = mins * 60;
  pomodoroState.totalSeconds = mins * 60;
  updatePomodoroDisplay();
}

function switchPomodoroMode() {
  clearInterval(pomodoroState.timer);
  pomodoroState.running = false;
  const modes = ["focus", "break", "long"];
  const idx = modes.indexOf(pomodoroState.mode);
  pomodoroState.mode = modes[(idx + 1) % modes.length];
  const mins = pomodoroState.mode === "focus"
    ? (DB.settings?.pomoFocus || 25)
    : pomodoroState.mode === "break"
      ? (DB.settings?.pomoBreak || 5)
      : (DB.settings?.pomoLong || 15);
  pomodoroState.seconds = mins * 60;
  pomodoroState.totalSeconds = mins * 60;
  updatePomodoroDisplay();
}

/* ============ HEATMAP ============ */
function logActivity(type = "general") {
  if (!currentUser) return;
  DB.activityHeatmap = DB.activityHeatmap || {};
  const today = new Date().toISOString().slice(0, 10);
  const key = currentUser.id + "_" + today;
  DB.activityHeatmap[key] = (DB.activityHeatmap[key] || 0) + 1;
  saveDB(DB);
}

function renderHeatmap() {
  if (!currentUser) return;
  DB.activityHeatmap = DB.activityHeatmap || {};
  const grid = document.getElementById("heatmapGrid");
  const today = new Date();
  const days = [];
  for (let i = 364; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    days.push(d);
  }

  let total = 0, activeDays = 0;
  grid.innerHTML = days.map(d => {
    const key = currentUser.id + "_" + d.toISOString().slice(0, 10);
    const count = DB.activityHeatmap[key] || 0;
    if (count > 0) activeDays++;
    total += count;
    let level = 0;
    if (count >= 1 && count <= 2) level = 1;
    else if (count >= 3 && count <= 5) level = 2;
    else if (count >= 6 && count <= 9) level = 3;
    else if (count >= 10) level = 4;
    const cls = level > 0 ? `l${level}` : "";
    return `<div class="heatmap-cell ${cls}" title="${d.toLocaleDateString("id-ID")}: ${count} aktivitas"></div>`;
  }).join("");

  // Streak
  let currentStreak = 0;
  for (let i = 0; i < 365; i++) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const key = currentUser.id + "_" + d.toISOString().slice(0, 10);
    if (DB.activityHeatmap[key]) currentStreak++;
    else break;
  }

  const sortedKeys = Object.keys(DB.activityHeatmap)
    .filter(k => k.startsWith(currentUser.id + "_"))
    .sort();
  let longest = 0, temp = 0, prevDate = null;
  sortedKeys.forEach(k => {
    const date = k.split("_")[1];
    if (prevDate) {
      const diff = (new Date(date) - new Date(prevDate)) / 86400000;
      temp = diff === 1 ? temp + 1 : 1;
    } else temp = 1;
    longest = Math.max(longest, temp);
    prevDate = date;
  });

  document.getElementById("streakCurrent").textContent = currentStreak;
  document.getElementById("streakLongest").textContent = longest;
  document.getElementById("hmTotal").textContent = total;
  document.getElementById("hmActiveDays").textContent = activeDays;
}

/* ============ TOAST ============ */
function showToast(msg, type = "success") {
  if (!toast) toast = new bootstrap.Toast(document.getElementById("toast"));
  const el = document.getElementById("toast");
  el.className = `toast align-items-center text-bg-${type} border-0`;
  document.getElementById("toastMsg").textContent = msg;
  toast.show();
}

/* ============ RESET (opsional) ============ */
function resetDemo() {
  if (!confirm("Reset semua data demo?")) return;
  localStorage.removeItem(DB_KEY);
  location.reload();
}
window.resetDemo = resetDemo;

/* ============ INIT ============ */
autoThemeFromOS();
updateLangBtn();
registerPWA();
registerPWAProper();
document.addEventListener("keydown", e => {
  if ((e.ctrlKey || e.metaKey) && e.key === "k") {
    e.preventDefault();
    openGlobalSearch();
  }
});
setInterval(() => {
  if (!currentUser) return;
  let changed = false;
  (DB.containers || []).forEach(c => {
    if (c.status === "running") {
      c.uptime_min = (c.uptime_min || 0) + 1;
      c.expires_min = Math.max(0, (c.expires_min || 0) - 1);
      if (c.expires_min === 0) c.status = "stopped";
      changed = true;
    }
  });
  if (changed) {
    saveDB(DB);
    if (document.getElementById("page-containers")?.classList.contains("active")) {
      renderContainers();
    }
  }
}, 60000);

console.log("CyberSec Academy Demo siap.");
console.log("Reset data: resetDemo()");
</script>
</body>
