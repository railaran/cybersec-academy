<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CyberSec Academy — Demo</title>
<link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#1f6feb">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
<!-- fallback: kalau CDN diblokir, tetap bisa jalan -->
<script>
window.__chartFallback = function() {
  if (typeof Chart === "undefined") {
    console.warn("Chart.js tidak bisa dimuat, chart akan dilewati.");
    return true;
  }
  return false;
};
</script>
<style>
  body { background:#0d1117; color:#e6edf3; }
  .navbar { background:#010409 !important; border-bottom:1px solid #30363d; }
  .card, .modal-content { background:#161b22; border:1px solid #30363d; }
  .form-control, .form-select { background:#0d1117; border:1px solid #30363d; color:#e6edf3; }
  .form-control:focus, .form-select:focus { background:#0d1117; color:#e6edf3; border-color:#58a6ff; box-shadow:0 0 0 .2rem rgba(88,166,255,.25); }
  .table { color:#e6edf3; } .table thead { background:#21262d; }
  .table-hover tbody tr:hover { background:#1f2937; }
  .login-wrap { min-height:100vh; display:flex; align-items:center; justify-content:center; }
  .login-card { background:#161b22; border:1px solid #30363d; border-radius:1rem; padding:2rem; width:100%; max-width:400px; }
  .brand-icon { font-size:3rem; color:#58a6ff; }
  .stat-card { background:#161b22; border:1px solid #30363d; border-radius:.75rem; transition:transform .2s, border-color .2s; }
  .stat-card:hover { transform:translateY(-3px); border-color:#58a6ff; }
  .stat-icon { font-size:2rem; } .stat-value { font-size:2rem; font-weight:700; }
  .badge-admin{background:#dc3545;} .badge-student{background:#0d6efd;}
  .badge-instructor{background:#198754;} .badge-active{background:#198754;}
  .badge-inactive{background:#6c757d;}
  .diff-easy{background:#198754;} .diff-medium{background:#ffc107;color:#000;}
  .diff-hard{background:#dc3545;} .diff-insane{background:#6f42c1;}
  .course-card,.lab-card,.quiz-card,.tool-card,.event-card {
    background:#161b22; border:1px solid #30363d; border-radius:.75rem;
    transition: transform .2s, border-color .2s; height:100%;
  }
  .course-card:hover,.lab-card:hover,.quiz-card:hover,.tool-card:hover,.event-card:hover {
    transform: translateY(-4px); border-color:#58a6ff;
  }
  .event-cover { height:120px; background:linear-gradient(135deg,#1f6feb,#6f42c1);
    display:flex; align-items:center; justify-content:center; font-size:2.5rem; color:#fff; border-radius:.75rem .75rem 0 0; }
  code.cmd { background:#0d1117; border:1px solid #30363d; padding:2px 6px; border-radius:.25rem;
    color:#7ee787; font-size:.78rem; display:block; overflow-x:auto; white-space:nowrap; margin-top:.25rem; }
  .rank-1{background:linear-gradient(90deg,rgba(255,215,0,.15),transparent);}
  .rank-2{background:linear-gradient(90deg,rgba(192,192,192,.12),transparent);}
  .rank-3{background:linear-gradient(90deg,rgba(205,127,50,.12),transparent);}
  .toast-container { z-index: 9999; }
  .page { display:none; } .page.active { display:block; }
  .medal { font-size:1.2rem; }
  .nav-link.active { background:#1f6feb !important; }
  [data-theme="light"] body { background:#f6f8fa; color:#1f2328; }
  [data-theme="light"] .navbar { background:#fff !important; border-bottom:1px solid #d0d7de; }
  [data-theme="light"] .navbar-brand,
  [data-theme="light"] .navbar .btn-outline-light { color:#1f2328 !important; border-color:#d0d7de; }
  [data-theme="light"] .card,
  [data-theme="light"] .modal-content,
  [data-theme="light"] .stat-card,
  [data-theme="light"] .course-card,
  [data-theme="light"] .lab-card,
  [data-theme="light"] .quiz-card,
  [data-theme="light"] .tool-card,
  [data-theme="light"] .event-card,
  [data-theme="light"] .login-card { background:#fff; border-color:#d0d7de; }
  [data-theme="light"] .form-control,
  [data-theme="light"] .form-select { background:#fff; color:#1f2328; border-color:#d0d7de; }
  [data-theme="light"] .table { color:#1f2328; }
  [data-theme="light"] .table thead { background:#f6f8fa; }
  [data-theme="light"] .table-hover tbody tr:hover { background:#f6f8fa; }
  [data-theme="light"] code.cmd { background:#f6f8fa; color:#0550ae; border-color:#d0d7de; }
  [data-theme="light"] .text-muted { color:#656d76 !important; }
  .chart-container { position:relative; height:260px; }
  .terminal {
    background:#000; color:#0f0; font-family:"Consolas","Courier New",monospace;
    font-size:.85rem; padding:1rem; border-radius:.5rem; height:280px;
    overflow-y:auto; border:1px solid #30363d;
  }
  .terminal-line { white-space:pre-wrap; word-break:break-all; }
  .terminal-input {
    background:transparent; border:0; color:#0f0; font-family:inherit;
    font-size:inherit; outline:none; width:85%; padding:0;
  }
  .quiz-option {
    display:block; padding:.75rem 1rem; margin-bottom:.5rem;
    background:#0d1117; border:1px solid #30363d; border-radius:.5rem;
    cursor:pointer; transition:all .15s;
  }
  .quiz-option:hover { border-color:#58a6ff; background:#161b22; }
  .quiz-option.selected { border-color:#58a6ff; background:rgba(88,166,255,.15); }
  .quiz-option.correct  { border-color:#198754; background:rgba(25,135,84,.2); }
  .quiz-option.wrong    { border-color:#dc3545; background:rgba(220,53,69,.2); }
  .timer-badge { font-variant-numeric:tabular-nums; }
  .container-card {
    background:#161b22; border:1px solid #30363d; border-radius:.75rem;
    padding:1rem; margin-bottom:.75rem; transition:border-color .2s;
  }
  .container-card:hover { border-color:#58a6ff; }
  .status-dot {
    display:inline-block; width:.6rem; height:.6rem; border-radius:50%;
    margin-right:.35rem; animation:pulse 2s infinite;
  }
  .status-running { background:#198754; }
  .status-stopped { background:#6c757d; animation:none; }
  .status-starting { background:#ffc107; }
  @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:.4;} }
  .star-rating { color:#ffc107; font-size:1rem; }
  .star-click { cursor:pointer; font-size:1.5rem; color:#6c757d; transition:color .15s; }
  .star-click:hover, .star-click.active { color:#ffc107; }
  .forum-msg { background:#0d1117; border:1px solid #30363d; border-radius:.5rem;
    padding:.75rem; margin-bottom:.75rem; }
  .forum-reply { background:#161b22; border-left:3px solid #58a6ff;
    padding:.5rem .75rem; margin-top:.5rem; margin-left:1rem; border-radius:.25rem; }
  .badge-card {
    background:#161b22; border:1px solid #30363d; border-radius:.75rem;
    padding:1rem; text-align:center; transition:transform .2s, border-color .2s;
    height:100%;
  }
  .badge-card.earned { border-color:#ffc107; background:linear-gradient(180deg,rgba(255,193,7,.1),transparent); }
  .badge-card.earned:hover { transform:translateY(-4px); border-color:#ffc107; }
  .badge-card.locked { opacity:.5; filter:grayscale(1); }
  .badge-icon { font-size:2.5rem; margin-bottom:.5rem; }
  .badge-card.earned .badge-icon { color:#ffc107; }
  .badge-card.locked .badge-icon { color:#6c757d; }
  .badge-toast {
    position:fixed; top:80px; right:20px; z-index:9999;
    background:linear-gradient(135deg,#1f6feb,#6f42c1);
    color:#fff; padding:1rem 1.5rem; border-radius:.75rem;
    box-shadow:0 10px 40px rgba(31,111,235,.5);
    animation: slideInRight .5s, slideOutRight .5s 4.5s;
    max-width:320px;
  }
  @keyframes slideInRight { from{transform:translateX(400px);opacity:0;} to{transform:translateX(0);opacity:1;} }
  @keyframes slideOutRight { to{transform:translateX(400px);opacity:0;} }
  .lang-flag { font-size:1.2rem; }
  .course-progress-bar {
    height:8px; background:#21262d; border-radius:4px; overflow:hidden; margin-top:.5rem;
  }
  .course-progress-bar > div {
    height:100%; background:linear-gradient(90deg,#1f6feb,#58a6ff);
    transition:width .4s;
  }
  .period-tab {
    padding:.4rem .9rem; border:1px solid #30363d; border-radius:.5rem;
    background:#161b22; color:#e6edf3; cursor:pointer; margin-right:.35rem;
    transition:all .15s;
  }
  .period-tab:hover { border-color:#58a6ff; }
  .period-tab.active { background:#1f6feb; border-color:#1f6feb; }
  .referral-code {
    background:#0d1117; border:2px dashed #58a6ff; padding:1rem;
    border-radius:.5rem; font-family:monospace; font-size:1.3rem;
    text-align:center; letter-spacing:2px; color:#58a6ff; cursor:pointer;
    transition:all .2s;
  }
  .referral-code:hover { background:#161b22; border-color:#7ee787; color:#7ee787; }
  .chat-box {
    background:#0d1117; border:1px solid #30363d; border-radius:.5rem;
    height:400px; overflow-y:auto; padding:1rem;
  }
  .chat-msg { margin-bottom:.75rem; display:flex; gap:.5rem; }
  .chat-msg.me { flex-direction:row-reverse; }
  .chat-bubble {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:.5rem .75rem; max-width:70%;
  }
  .chat-msg.me .chat-bubble { background:#1f6feb; border-color:#1f6feb; }
  .chat-meta { font-size:.7rem; color:#6c757d; margin-bottom:.15rem; }
  .log-stream {
    background:#000; color:#0f0; font-family:monospace; font-size:.8rem;
    padding:1rem; border-radius:.5rem; height:300px; overflow-y:auto;
    border:1px solid #30363d;
  }
  .log-line { white-space:pre-wrap; }
  .log-info { color:#58a6ff; }
  .log-warn { color:#ffc107; }
  .log-error { color:#dc3545; }
  .log-success { color:#198754; }
  .admin-stat-big { font-size:2.5rem; font-weight:700; }
  .video-card {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    overflow:hidden; cursor:pointer; transition:all .2s;
  }
  .video-card:hover { border-color:#58a6ff; transform:translateY(-3px); }
  .video-thumb {
    height:120px; background-size:cover; background-position:center;
    display:flex; align-items:center; justify-content:center;
    background-color:#21262d;
  }
  .video-play {
    width:3rem; height:3rem; border-radius:50%; background:rgba(0,0,0,.6);
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:1.5rem;
  }
  .video-lesson-done .video-thumb::after {
    content:"✓"; position:absolute; top:.5rem; right:.5rem;
    background:#198754; color:#fff; width:1.5rem; height:1.5rem;
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-weight:bold;
  }
  .video-player-modal .modal-body { padding:0; }
  .video-stage {
    background:#000; height:340px; display:flex; align-items:center;
    justify-content:center; color:#fff; font-size:1.2rem; position:relative;
  }
  .video-stage .play-big {
    font-size:5rem; color:#58a6ff; cursor:pointer;
    transition:transform .2s;
  }
  .video-stage .play-big:hover { transform:scale(1.1); }
  .progress-video { height:5px; background:#21262d; }
  .progress-video > div { height:100%; background:#58a6ff; transition:width .3s; }
  .invoice-card {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:1.25rem; margin-bottom:.75rem;
  }
  .invoice-paid { border-color:#198754; }
  .locked-overlay {
    background:rgba(13,17,23,.85); backdrop-filter:blur(6px);
    border-radius:.75rem; padding:1.5rem; text-align:center;
    border:2px dashed #ffc107; margin-bottom:1rem;
  }
  .locked-overlay i { font-size:2.5rem; color:#ffc107; }
  .google-btn {
    display:flex; align-items:center; gap:.75rem; justify-content:center;
    background:#fff; color:#1f2328; border:1px solid #d0d7de;
    padding:.75rem; border-radius:.5rem; font-weight:500;
    cursor:pointer; transition:all .15s; width:100%;
  }
  .google-btn:hover { background:#f6f8fa; box-shadow:0 2px 8px rgba(0,0,0,.1); }
  .google-icon {
    width:1.25rem; height:1.25rem;
    background:conic-gradient(#4285F4 0 90deg,#34A853 90deg 180deg,#FBBC05 180deg 270deg,#EA4335 270deg);
    border-radius:50%;
  }
  .rapor-section {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:1rem; margin-bottom:1rem;
  }
  .sync-indicator {
    display:inline-flex; align-items:center; gap:.35rem;
    padding:.2rem .6rem; border-radius:1rem; font-size:.75rem;
    background:rgba(25,135,84,.2); color:#7ee787;
  }
  .sync-indicator.offline { background:rgba(255,193,7,.2); color:#ffc107; }
  .print-area { display:none; }
  @media print {
    body > *:not(.print-area) { display:none !important; }
    .print-area { display:block !important; }
  }
  .chat-typing {
    display:inline-flex; gap:.25rem; padding:.5rem .75rem;
    background:#161b22; border-radius:1rem; border:1px solid #30363d;
  }
  .chat-typing span {
    width:.5rem; height:.5rem; border-radius:50%; background:#6c757d;
    animation: typing 1.4s infinite;
  }
  .chat-typing span:nth-child(2) { animation-delay:.2s; }
  .chat-typing span:nth-child(3) { animation-delay:.4s; }
  @keyframes typing {
    0%, 60%, 100% { transform:translateY(0); opacity:.5; }
    30% { transform:translateY(-6px); opacity:1; }
  }
  .payment-status {
    display:flex; align-items:center; gap:.75rem; padding:1rem;
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    margin-bottom:.75rem;
  }
  .payment-status .spinner-border-sm { width:1.5rem; height:1.5rem; }
  .payment-status.success { border-color:#198754; background:rgba(25,135,84,.1); }
  .payment-status.failed  { border-color:#dc3545; background:rgba(220,53,69,.1); }
  .share-card {
    background:linear-gradient(135deg,#1f6feb,#6f42c1);
    color:#fff; padding:1.5rem; border-radius:1rem;
    box-shadow:0 8px 24px rgba(31,111,235,.3);
  }
  .share-card h3 { margin:0 0 .5rem; }
  .share-card .big { font-size:3rem; font-weight:700; }
  .share-code {
    background:rgba(0,0,0,.3); padding:.5rem .75rem; border-radius:.4rem;
    font-family:monospace; font-size:.9rem;
  }
  .api-endpoint {
    background:#0d1117; border:1px solid #30363d; padding:.75rem 1rem;
    border-radius:.5rem; margin-bottom:.5rem; font-family:monospace;
    font-size:.85rem; display:flex; align-items:center; gap:.75rem;
  }
  .api-method {
    padding:.2rem .5rem; border-radius:.25rem; font-weight:bold;
    font-size:.75rem; min-width:50px; text-align:center;
  }
  .api-get    { background:#198754; }
  .api-post   { background:#0d6efd; }
  .api-put    { background:#ffc107; color:#000; }
  .api-delete { background:#dc3545; }
  .bookmark-btn {
    background:transparent; border:0; color:#ffc107;
    font-size:1.2rem; cursor:pointer; transition:transform .15s;
  }
  .bookmark-btn:hover { transform:scale(1.2); }
  .heatmap {
    display:grid; grid-template-columns:repeat(53, 1fr);
    gap:2px; padding:1rem; background:#0d1117;
    border-radius:.5rem; border:1px solid #30363d; overflow-x:auto;
  }
  .heatmap-cell {
    width:12px; height:12px; border-radius:2px; background:#161b22;
    transition:transform .15s; cursor:pointer;
  }
  .heatmap-cell:hover { transform:scale(1.4); }
  .heatmap-cell.l1 { background:#0e4429; }
  .heatmap-cell.l2 { background:#006d32; }
  .heatmap-cell.l3 { background:#26a641; }
  .heatmap-cell.l4 { background:#39d353; }
  .heatmap-legend {
    display:flex; align-items:center; gap:.25rem; font-size:.75rem;
    color:#6c757d; margin-top:.5rem;
  }
  .streak-card {
    background:linear-gradient(135deg,#ff6b35,#f7931e);
    color:#fff; padding:1.25rem; border-radius:.75rem; text-align:center;
  }
  .streak-card .big { font-size:3rem; font-weight:700; line-height:1; }
  .time-widget {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:.75rem 1rem; font-size:1.5rem; font-family:monospace;
    color:#7ee787; text-align:center;
  }
  .pomodoro-ring {
    width:180px; height:180px; border-radius:50%;
    background:conic-gradient(#1f6feb 0deg, #21262d 0deg);
    display:flex; align-items:center; justify-content:center;
    margin:0 auto; transition:background .3s;
  }
  .pomodoro-inner {
    width:150px; height:150px; border-radius:50%; background:#161b22;
    display:flex; align-items:center; justify-content:center;
    flex-direction:column; color:#e6edf3;
  }
  .pomodoro-inner .time { font-size:2rem; font-weight:700; font-family:monospace; }
  .note-card {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:1rem; margin-bottom:.75rem;
  }
  .note-card .actions { opacity:0; transition:opacity .2s; }
  .note-card:hover .actions { opacity:1; }
  .toast-notification {
    position:fixed; top:80px; right:20px;
    background:#161b22; border:1px solid #30363d;
    border-left:4px solid #1f6feb; border-radius:.5rem;
    padding:1rem 1.25rem; max-width:350px; z-index:9998;
    box-shadow:0 4px 20px rgba(0,0,0,.3);
    animation:slideInRight .4s, slideOutRight .4s 4.6s;
  }
  .toast-notification.success { border-left-color:#198754; }
  .toast-notification.warning { border-left-color:#ffc107; }
  .toast-notification.danger  { border-left-color:#dc3545; }
    background:#0d1117; border:2px solid #30363d; padding:1rem;
    border-radius:.5rem; font-family:monospace; text-align:center;
    font-size:1.1rem; letter-spacing:2px; color:#58e6ff;
  }
  .chat-box {
    background:#0d1117; border:1px solid #30363d; border-radius:.5rem;
    height:400px; overflow-y:auto; padding:1rem;
  }
  .chat-msg { margin-bottom:.75rem; display:flex; gap:.5rem; }
  .chat-msg.me { flex-direction:row-reverse; }
  .chat-bubble {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:.5rem .75rem; max-width:70%;
  }
  .chat-msg.me .chat-bubble { background:#1f6feb; border-color:#1f6feb; }
  .chat-meta { font-size:.7rem; color:#6c757d; margin-bottom:.15rem; }
  .log-stream {
    background:#000; color:#0f0; font-family:monospace; font-size:.8rem;
    padding:1rem; border-radius:.5rem; height:300px; overflow-y:auto;
    border:1px solid #30363d;
  }
  .log-line { white-space:pre-wrap; }
  .log-info { color:#58a6ff; }
  .log-warn { color:#ffc107; }
  .log-error { color:#dc3545; }
  .log-success { color:#198754; }
  .admin-stat-big { font-size:2.5rem; font-weight:700; }
  .video-card {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    overflow:hidden; cursor:pointer; transition:all .2s;
  }
  .video-card:hover { border-color:#58a6ff; transform:translateY(-3px); }
  .video-thumb {
    height:120px; background-size:cover; background-position:center;
    display:flex; align-items:center; justify-content:center;
    background-color:#21262d;
  }
  .video-play {
    width:3rem; height:3rem; border-radius:50%; background:rgba(0,0,0,.6);
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:1.5rem;
  }
  .video-lesson-done .video-thumb::after {
    content:"✓"; position:absolute; top:.5rem; right:.5rem;
    background:#198754; color:#fff; width:1.5rem; height:1.5rem;
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-weight:bold;
  }
  .video-player-modal .modal-body { padding:0; }
  .video-stage {
    background:#000; height:340px; display:flex; align-items:center;
    justify-content:center; color:#fff; font-size:1.2rem; position:relative;
  }
  .video-stage .play-big {
    font-size:5rem; color:#58a6ff; cursor:pointer;
    transition:transform .2s;
  }
  .video-stage .play-big:hover { transform:scale(1.1); }
  .progress-video { height:5px; background:#21262d; }
  .progress-video > div { height:100%; background:#58a6ff; transition:width .3s; }
  .invoice-card {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:1.25rem; margin-bottom:.75rem;
  }
  .invoice-paid { border-color:#198754; }
  .locked-overlay {
    background:rgba(13,17,23,.85); backdrop-filter:blur(6px);
    border-radius:.75rem; padding:1.5rem; text-align:center;
    border:2px dashed #ffc107; margin-bottom:1rem;
  }
  .locked-overlay i { font-size:2.5rem; color:#ffc107; }
  .google-btn {
    display:flex; align-items:center; gap:.75rem; justify-content:center;
    background:#fff; color:#1f2328; border:1px solid #d0d7de;
    padding:.75rem; border-radius:.5rem; font-weight:500;
    cursor:pointer; transition:all .15s; width:100%;
  }
  .google-btn:hover { background:#f6f8fa; box-shadow:0 2px 8px rgba(0,0,0,.1); }
  .google-icon {
    width:1.25rem; height:1.25rem;
    background:conic-gradient(#4285F4 0 90deg,#34A853 90deg 180deg,#FBBC05 180deg 270deg,#EA4335 270deg);
    border-radius:50%;
  }
  .rapor-section {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:1rem; margin-bottom:1rem;
  }
  .sync-indicator {
    display:inline-flex; align-items:center; gap:.35rem;
    padding:.2rem .6rem; border-radius:1rem; font-size:.75rem;
    background:rgba(25,135,84,.2); color:#7ee787;
  }
  .sync-indicator.offline { background:rgba(255,193,7,.2); color:#ffc107; }
  .print-area { display:none; }
  @media print {
    body > *:not(.print-area) { display:none !important; }
    .print-area { display:block !important; }
  }
  .chat-typing {
    display:inline-flex; gap:.25rem; padding:.5rem .75rem;
    background:#161b22; border-radius:1rem; border:1px solid #30363d;
  }
  .chat-typing span {
    width:.5rem; height:.5rem; border-radius:50%; background:#6c757d;
    animation: typing 1.4s infinite;
  }
  .chat-typing span:nth-child(2) { animation-delay:.2s; }
  .chat-typing span:nth-child(3) { animation-delay:.4s; }
  @keyframes typing {
    0%, 60%, 100% { transform:translateY(0); opacity:.5; }
    30% { transform:translateY(-6px); opacity:1; }
  }
  .payment-status {
    display:flex; align-items:center; gap:.75rem; padding:1rem;
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    margin-bottom:.75rem;
  }
  .payment-status .spinner-border-sm { width:1.5rem; height:1.5rem; }
  .payment-status.success { border-color:#198754; background:rgba(25,135,84,.1); }
  .payment-status.failed  { border-color:#dc3545; background:rgba(220,53,69,.1); }
  .share-card {
    background:linear-gradient(135deg,#1f6feb,#6f42c1);
    color:#fff; padding:1.5rem; border-radius:1rem;
    box-shadow:0 8px 24px rgba(31,111,235,.3);
  }
  .share-card h3 { margin:0 0 .5rem; }
  .share-card .big { font-size:3rem; font-weight:700; }
  .share-code {
    background:rgba(0,0,0,.3); padding:.5rem .75rem; border-radius:.4rem;
    font-family:monospace; font-size:.9rem;
  }
  .api-endpoint {
    background:#0d1117; border:1px solid #30363d; padding:.75rem 1rem;
    border-radius:.5rem; margin-bottom:.5rem; font-family:monospace;
    font-size:.85rem; display:flex; align-items:center; gap:.75rem;
  }
  .api-method {
    padding:.2rem .5rem; border-radius:.25rem; font-weight:bold;
    font-size:.75rem; min-width:50px; text-align:center;
  }
  .api-get    { background:#198754; }
  .api-post   { background:#0d6efd; }
  .api-put    { background:#ffc107; color:#000; }
  .api-delete { background:#dc3545; }
  .bookmark-btn {
    background:transparent; border:0; color:#ffc107;
    font-size:1.2rem; cursor:pointer; transition:transform .15s;
  }
  .bookmark-btn:hover { transform:scale(1.2); }
  .heatmap {
    display:grid; grid-template-columns:repeat(53, 1fr);
    gap:2px; padding:1rem; background:#0d1117;
    border-radius:.5rem; border:1px solid #30363d; overflow-x:auto;
  }
  .heatmap-cell {
    width:12px; height:12px; border-radius:2px; background:#161b22;
    transition:transform .15s; cursor:pointer;
  }
  .heatmap-cell:hover { transform:scale(1.4); }
  .heatmap-cell.l1 { background:#0e4429; }
  .heatmap-cell.l2 { background:#006d32; }
  .heatmap-cell.l3 { background:#26a641; }
  .heatmap-cell.l4 { background:#39d353; }
  .heatmap-legend {
    display:flex; align-items:center; gap:.25rem; font-size:.75rem;
    color:#6c757d; margin-top:.5rem;
  }
  .streak-card {
    background:linear-gradient(135deg,#ff6b35,#f7931e);
    color:#fff; padding:1.25rem; border-radius:.75rem; text-align:center;
  }
  .streak-card .big { font-size:3rem; font-weight:700; line-height:1; }
  .time-widget {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:.75rem 1rem; font-size:1.5rem; font-family:monospace;
    color:#7ee787; text-align:center;
  }
  .pomodoro-ring {
    width:180px; height:180px; border-radius:50%;
    background:conic-gradient(#1f6feb 0deg, #21262d 0deg);
    display:flex; align-items:center; justify-content:center;
    margin:0 auto; transition:background .3s;
  }
  .pomodoro-inner {
    width:150px; height:150px; border-radius:50%; background:#161b22;
    display:flex; align-items:center; justify-content:center;
    flex-direction:column; color:#e6edf3;
  }
  .pomodoro-inner .time { font-size:2rem; font-weight:700; font-family:monospace; }
  .note-card {
    background:#161b22; border:1px solid #30363d; border-radius:.5rem;
    padding:1rem; margin-bottom:.75rem;
  }
  .note-card .actions { opacity:0; transition:opacity .2s; }
  .note-card:hover .actions { opacity:1; }
  .toast-notification {
    position:fixed; top:80px; right:20px;
    background:#161b22; border:1px solid #30363d;
    border-left:4px solid #1f6feb; border-radius:.5rem;
    padding:1rem 1.25rem; max-width:350px; z-index:9998;
    box-shadow:0 4px 20px rgba(0,0,0,.3);
    animation:slideInRight .4s, slideOutRight .4s 4.6s;
  }
  .toast-notification.success { border-left-color:#198754; }
  .toast-notification.warning { border-left-color:#ffc107; }
  .toast-notification.danger  { border-left-color:#dc3545; }
    background:#0d1117; border:2px solid #30363d; padding:1rem;
    border-radius:.5rem; font-family:monospace; text-align:center;
    font-size:1.1rem; letter-spacing:2px; color:#58e6ff;
  }
</style>
</head>
<body>

<!-- ================== LOGIN VIEW ================== -->
<div id="loginView" class="login-wrap">
  <div class="login-card">
    <div class="text-center mb-4">
      <i class="bi bi-shield-lock-fill brand-icon"></i>
      <h4 class="mt-2 mb-0">CyberSec Academy</h4>
      <small class="text-muted">Sign in to continue</small>
    </div>

    <ul class="nav nav-pills nav-fill mb-3">
      <li class="nav-item"><a class="nav-link active" href="#" id="tabLogin">Login</a></li>
      <li class="nav-item"><a class="nav-link" href="#" id="tabRegister">Register</a></li>
    </ul>

    <form id="loginForm">
      <div class="mb-3" id="nameField" style="display:none">
        <label class="form-label">Nama Lengkap</label>
        <input type="text" class="form-control" id="regName" placeholder="Nama kamu">
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" id="loginEmail" value="admin@cybersec.id" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" class="form-control" id="loginPassword" value="admin123" required>
      </div>
      <button class="btn btn-primary w-100" type="submit">
        <i class="bi bi-box-arrow-in-right"></i> Login
      </button>
    </form>

    <div class="text-center my-3">
      <small class="text-muted">atau</small>
    </div>

    <button type="button" class="google-btn" onclick="loginWithGoogle()">
      <span class="google-icon"></span>
      <span>Continue with Google</span>
    </button>

    <div class="alert alert-danger mt-3 d-none" id="loginError"></div>

    <div class="text-center mt-3 small text-muted">
      Demo: <code>admin@cybersec.id</code> / <code>admin123</code>
    </div>
  </div>
</div>

<!-- ================== MAIN APP ================== -->
<div id="mainApp" style="display:none">

<nav class="navbar navbar-expand-xl navbar-dark px-3 flex-nowrap" style="overflow-x:auto;">
  <a class="navbar-brand" href="#" onclick="showPage('dashboard');return false;">
    <i class="bi bi-shield-lock-fill text-info"></i> CyberSec Academy
  </a>
  <div class="ms-auto d-flex gap-2 flex-nowrap" style="white-space:nowrap;">
    <button class="btn btn-sm btn-outline-light" onclick="showPage('dashboard')"><i class="bi bi-speedometer2"></i> Dashboard</button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('users')"><i class="bi bi-people"></i> Users</button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('courses')"><i class="bi bi-journal-code"></i> Courses</button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('labs')"><i class="bi bi-terminal"></i> Labs</button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('quizzes')"><i class="bi bi-question-circle"></i> Quizzes</button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('tools')"><i class="bi bi-tools"></i> Tools</button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('events')"><i class="bi bi-calendar-event"></i> Events</button>
    <button class="btn btn-sm btn-outline-warning" onclick="showPage('leaderboard')"><i class="bi bi-trophy"></i> Leaderboard</button>
    <button class="btn btn-sm btn-outline-warning" onclick="showPage('certificates')"><i class="bi bi-award"></i> Sertifikat</button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('progress')"><i class="bi bi-graph-up"></i> Progress</button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('timeline')"><i class="bi bi-clock-history"></i> Timeline</button>
    <button class="btn btn-sm btn-outline-danger" onclick="showPage('containers')"><i class="bi bi-box"></i> Containers</button>
    <button class="btn btn-sm btn-outline-warning" onclick="showPage('badges')"><i class="bi bi-trophy-fill"></i> Badges</button>
    <button class="btn btn-sm btn-outline-primary" onclick="showPage('chat')"><i class="bi bi-chat-dots-fill"></i> Chat</button>
    <button class="btn btn-sm btn-outline-warning" onclick="showPage('admin')" id="adminBtn" style="display:none"><i class="bi bi-shield-fill"></i> Admin</button>
    <button class="btn btn-sm btn-outline-success" onclick="showPage('my-courses')"><i class="bi bi-play-btn"></i> My Courses</button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('verify')"><i class="bi bi-patch-check"></i> Verify</button>
    <button class="btn btn-sm btn-outline-success" onclick="showPage('rapor')"><i class="bi bi-file-earmark-pdf"></i> Rapor</button>
    <button class="btn btn-sm btn-outline-primary" onclick="showPage('share')"><i class="bi bi-share-fill"></i> Share</button>
    <button class="btn btn-sm btn-outline-secondary" onclick="showPage('api-docs')"><i class="bi bi-braces"></i> API</button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('notes')"><i class="bi bi-journal-text"></i> Notes</button>
    <button class="btn btn-sm btn-outline-danger" onclick="showPage('pomodoro')"><i class="bi bi-alarm-fill"></i> Pomodoro</button>
    <button class="btn btn-sm btn-outline-success" onclick="showPage('heatmap')"><i class="bi bi-calendar3"></i> Activity</button>
    <button class="btn btn-sm btn-outline-primary" onclick="showPage('chat')"><i class="bi bi-chat-dots-fill"></i> Chat</button>
    <button class="btn btn-sm btn-outline-warning" onclick="showPage('admin')" id="adminBtn" style="display:none"><i class="bi bi-shield-fill"></i> Admin</button>
    <button class="btn btn-sm btn-outline-success" onclick="showPage('my-courses')"><i class="bi bi-play-btn"></i> My Courses</button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('verify')"><i class="bi bi-patch-check"></i> Verify</button>
    <button class="btn btn-sm btn-outline-success" onclick="showPage('rapor')"><i class="bi bi-file-earmark-pdf"></i> Rapor</button>
    <button class="btn btn-sm btn-outline-primary" onclick="showPage('share')"><i class="bi bi-share-fill"></i> Share</button>
    <button class="btn btn-sm btn-outline-secondary" onclick="showPage('api-docs')"><i class="bi bi-braces"></i> API</button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('notes')"><i class="bi bi-journal-text"></i> Notes</button>
    <button class="btn btn-sm btn-outline-danger" onclick="showPage('pomodoro')"><i class="bi bi-alarm-fill"></i> Pomodoro</button>
    <button class="btn btn-sm btn-outline-success" onclick="showPage('heatmap')"><i class="bi bi-calendar3"></i> Activity</button>
    <button class="btn btn-sm btn-outline-secondary" onclick="toggleLang()" id="langBtn" title="Language"><span class="lang-flag">🇮🇩</span></button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('profile')"><i class="bi bi-person-circle"></i> <span id="navUserName">Profile</span></button>
    <button class="btn btn-sm btn-outline-secondary" onclick="openGlobalSearch()" title="Cari (Ctrl+K)">
      <i class="bi bi-search"></i>
    </button>
    <button class="btn btn-sm btn-outline-secondary position-relative" onclick="showNotifications()" title="Notifikasi">
      <i class="bi bi-bell"></i>
      <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none">0</span>
    </button>
    <button class="btn btn-sm btn-outline-secondary" onclick="toggleTheme()" id="themeBtn" title="Theme"><i class="bi bi-moon-stars"></i></button>
    <button class="btn btn-sm btn-outline-danger" onclick="logout()"><i class="bi bi-box-arrow-right"></i></button>
  </div>
</nav>

<div class="container my-4">

  <!-- DASHBOARD -->
  <div id="page-dashboard" class="page active">
    <h3 class="mb-3"><i class="bi bi-speedometer2"></i> Dashboard</h3>
    <div class="row g-3 mb-4">
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-people-fill stat-icon text-info"></i>
        <div class="stat-value" id="statUsers">0</div><div class="text-muted small">Users</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-journal-code stat-icon text-success"></i>
        <div class="stat-value" id="statCourses">0</div><div class="text-muted small">Courses</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-terminal-fill stat-icon text-danger"></i>
        <div class="stat-value" id="statLabs">0</div><div class="text-muted small">Labs</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-question-circle-fill stat-icon text-warning"></i>
        <div class="stat-value" id="statQuizzes">0</div><div class="text-muted small">Quizzes</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-tools stat-icon text-info"></i>
        <div class="stat-value" id="statTools">0</div><div class="text-muted small">Tools</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-calendar-event stat-icon text-success"></i>
        <div class="stat-value" id="statEvents">0</div><div class="text-muted small">Events</div></div></div>
    </div>
    <div class="row g-3">
      <div class="col-md-6"><div class="card p-3"><h6><i class="bi bi-journal-code text-success"></i> Courses Terbaru</h6>
        <ul class="list-unstyled small mb-0" id="recentCourses"></ul></div></div>
      <div class="col-md-6"><div class="card p-3"><h6><i class="bi bi-terminal-fill text-danger"></i> Labs Terbaru</h6>
        <ul class="list-unstyled small mb-0" id="recentLabs"></ul></div></div>
    </div>
  </div>

  <!-- USERS -->
  <div id="page-users" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-people-fill"></i> Users</h3>
      <button class="btn btn-primary" onclick="openUserModal()"><i class="bi bi-plus-circle"></i> Tambah</button>
    </div>
    <div class="row g-2 mb-3">
      <div class="col-md-6"><input class="form-control" id="userSearch" placeholder="Cari nama / email..." oninput="renderUsers()"></div>
      <div class="col-md-3"><select class="form-select" id="userRoleFilter" onchange="renderUsers()">
        <option value="">Semua Role</option><option>admin</option><option>instructor</option><option>student</option></select></div>
    </div>
    <div class="card"><div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead><tr><th>#</th><th>Nama</th><th>Email</th><th>Role</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody id="usersTable"></tbody>
      </table>
    </div></div>
  </div>

  <!-- COURSES -->
  <div id="page-courses" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-journal-code"></i> Courses</h3>
      <button class="btn btn-primary" onclick="openCourseModal()"><i class="bi bi-plus-circle"></i> Tambah</button>
    </div>
    <div class="row g-2 mb-3">
      <div class="col-md-6"><input class="form-control" id="courseSearch" placeholder="Cari course..." oninput="renderCourses()"></div>
      <div class="col-md-3"><select class="form-select" id="courseLevelFilter" onchange="renderCourses()">
        <option value="">Semua Level</option><option>beginner</option><option>intermediate</option><option>advanced</option></select></div>
    </div>
    <div class="row g-3" id="coursesGrid"></div>
  </div>

  <!-- LABS -->
  <div id="page-labs" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-terminal"></i> Labs</h3>
      <button class="btn btn-primary" onclick="openLabModal()"><i class="bi bi-plus-circle"></i> Tambah</button>
    </div>
    <div class="row g-2 mb-3">
      <div class="col-md-6"><input class="form-control" id="labSearch" placeholder="Cari lab..." oninput="renderLabs()"></div>
      <div class="col-md-3"><select class="form-select" id="labCatFilter" onchange="renderLabs()">
        <option value="">Semua Kategori</option><option>web</option><option>network</option><option>forensics</option><option>crypto</option><option>osint</option><option>reveng</option></select></div>
      <div class="col-md-3"><select class="form-select" id="labDiffFilter" onchange="renderLabs()">
        <option value="">Semua Difficulty</option><option>easy</option><option>medium</option><option>hard</option><option>insane</option></select></div>
    </div>
    <div class="row g-3" id="labsGrid"></div>
  </div>

  <!-- QUIZZES -->
  <div id="page-quizzes" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-question-circle"></i> Quizzes</h3>
      <button class="btn btn-primary" onclick="openQuizModal()"><i class="bi bi-plus-circle"></i> Tambah</button>
    </div>
    <div class="row g-3" id="quizzesGrid"></div>
  </div>

  <!-- TOOLS -->
  <div id="page-tools" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-tools"></i> Cyber Tools</h3>
      <button class="btn btn-primary" onclick="openToolModal()"><i class="bi bi-plus-circle"></i> Tambah</button>
    </div>
    <div class="row g-2 mb-3">
      <div class="col-md-6"><input class="form-control" id="toolSearch" placeholder="Cari tool..." oninput="renderTools()"></div>
      <div class="col-md-3"><select class="form-select" id="toolCatFilter" onchange="renderTools()">
        <option value="">Semua Kategori</option><option>recon</option><option>exploitation</option><option>forensics</option><option>crypto</option><option>web</option><option>network</option><option>osint</option></select></div>
    </div>
    <div class="row g-3" id="toolsGrid"></div>
  </div>

  <!-- EVENTS -->
  <div id="page-events" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-calendar-event"></i> Events</h3>
      <button class="btn btn-primary" onclick="openEventModal()"><i class="bi bi-plus-circle"></i> Tambah</button>
    </div>
    <div class="row g-2 mb-3">
      <div class="col-md-6"><input class="form-control" id="eventSearch" placeholder="Cari event..." oninput="renderEvents()"></div>
      <div class="col-md-3"><select class="form-select" id="eventTypeFilter" onchange="renderEvents()">
        <option value="">Semua Tipe</option><option>ctf</option><option>workshop</option><option>webinar</option><option>bootcamp</option></select></div>
    </div>
    <div class="row g-3" id="eventsGrid"></div>
  </div>

  <!-- LEADERBOARD -->
  <div id="page-leaderboard" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0"><i class="bi bi-trophy-fill text-warning"></i> Leaderboard</h3>
      <div>
        <button class="period-tab active" data-period="all" onclick="setPeriod('all')">All Time</button>
        <button class="period-tab" data-period="week" onclick="setPeriod('week')">Minggu Ini</button>
        <button class="period-tab" data-period="today" onclick="setPeriod('today')">Hari Ini</button>
      </div>
    </div>
    <div class="card"><div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead><tr><th style="width:70px">Rank</th><th>Nama</th><th class="text-end">Points</th><th class="text-end">Completed</th></tr></thead>
        <tbody id="lbTable"></tbody>
      </table>
    </div></div>


  <!-- CERTIFICATES -->
  <div id="page-certificates" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-award-fill text-warning"></i> Sertifikat Saya</h3>
      <button class="btn btn-outline-info" onclick="renderCertificates()">
        <i class="bi bi-arrow-clockwise"></i> Refresh
      </button>
    </div>
    <div class="row g-3" id="certGrid"></div>
  </div>

  <!-- CERTIFICATE VIEW (untuk print) -->
  <div id="page-certificate-view" class="page">
    <div class="mb-3 d-flex justify-content-between align-items-center">
      <button class="btn btn-outline-secondary" onclick="showPage('certificates')">
        <i class="bi bi-arrow-left"></i> Kembali
      </button>
      <button class="btn btn-primary" onclick="window.print()">
        <i class="bi bi-printer"></i> Print / Save PDF
      </button>
    </div>
    <div id="certPrintArea" style="background:#fff; color:#000; padding:4rem; border-radius:.5rem;
         border:8px double #1f6feb; text-align:center; min-height:600px;
         font-family:Georgia, serif;">
      <!-- diisi via JS -->
    </div>
  </div>


  <!-- TIMELINE -->
  <div id="page-timeline" class="page">
    <h3 class="mb-3"><i class="bi bi-clock-history"></i> Activity Timeline</h3>
    <div class="card p-3">
      <div id="timelineList"></div>
    </div>
  </div>

  <!-- COURSE DETAIL -->
