function t(key) {
  const lang = DB.settings?.lang || "id";
  return (I18N[lang] && I18N[lang][key]) || key;
}

function toggleLang() {
  if (!DB.settings) DB.settings = { lang: "id" };
  DB.settings.lang = DB.settings.lang === "id" ? "en" : "id";
  saveDB(DB);
  updateLangBtn();
  showToast(DB.settings.lang === "id" ? "Bahasa: Indonesia" : "Language: English");
}

function updateLangBtn() {
  const lang = DB.settings?.lang || "id";
  const btn = document.getElementById("langBtn");
  if (btn) btn.innerHTML = lang === "id" ? '<span class="lang-flag">🇮🇩</span>' : '<span class="lang-flag">🇬🇧</span>';
}

/* ============ PWA ============ */
function registerPWA() {
  // Service worker inline (dari data URL) untuk offline cache
  if ("serviceWorker" in navigator) {
    const swCode = `
      const CACHE = "cybersec-v1";
      const ASSETS = ["./app.html"];
      self.addEventListener("install", e => {
        e.waitUntil(caches.open(CACHE).then(c => c.addAll(ASSETS)).then(() => self.skipWaiting()));
      });
      self.addEventListener("activate", e => {
        e.waitUntil(caches.keys().then(keys =>
          Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k)))
        ).then(() => self.clients.claim()));
      });
      self.addEventListener("fetch", e => {
        if (e.request.method !== "GET") return;
        e.respondWith(
          caches.match(e.request).then(r => r || fetch(e.request).then(res => {
            if (res.ok && e.request.url.startsWith(self.location.origin)) {
              const clone = res.clone();
              caches.open(CACHE).then(c => c.put(e.request, clone));
            }
            return res;
          }).catch(() => caches.match("./app.html")))
        );
      });
    `;
    try {
      const blob = new Blob([swCode], { type: "application/javascript" });
      const url = URL.createObjectURL(blob);
      navigator.serviceWorker.register(url).catch(() => {});
    } catch (_) {}
  }
}


/* ============ PWA PROPER ============ */
function registerPWAProper() {
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("./sw.js")
      .then(reg => console.log("SW registered:", reg.scope))
      .catch(err => console.warn("SW registration failed:", err));
  }
  // Update theme color berdasarkan theme
  const meta = document.querySelector('meta[name="theme-color"]');
  if (meta) {
    const t = document.documentElement.getAttribute("data-theme") || "dark";
    meta.content = t === "dark" ? "#0d1117" : "#ffffff";
  }
}

/* ============ WEB NOTIFICATIONS ============ */
async function requestNotifPermission() {
  if (!("Notification" in window)) {
    showToast("Browser tidak mendukung notifikasi", "warning");
    return;
  }
  if (Notification.permission === "granted") {
    DB.notifications_enabled = true;
    saveDB(DB);
    showToast("Notifikasi sudah aktif");
    updateNotifPermBtn();
    return;
  }
  const perm = await Notification.requestPermission();
  if (perm === "granted") {
    DB.notifications_enabled = true;
    saveDB(DB);
    showToast("Notifikasi browser aktif!");
    sendWebNotif("CyberSec Academy", "Notifikasi berhasil diaktifkan 🎉");
    updateNotifPermBtn();
  } else {
    showToast("Izin notifikasi ditolak", "warning");
  }
}

function updateNotifPermBtn() {
  const btn = document.getElementById("notifPermBtn");
  if (!btn) return;
  if (DB.notifications_enabled && "Notification" in window && Notification.permission === "granted") {
    btn.className = "btn btn-success w-100";
    btn.innerHTML = '<i class="bi bi-bell-fill"></i> Notifikasi Aktif';
  }
}

function sendWebNotif(title, body) {
  if (!DB.notifications_enabled) return;
  if (!("Notification" in window)) return;
  if (Notification.permission !== "granted") return;
  try {
    new Notification(title, {
      body,
      icon: "./manifest.json",
      badge: "./manifest.json",
      tag: "cybersec-" + Date.now(),
    });
  } catch (_) {}
}

/* ============ REFERRAL ============ */
function getMyReferralCode() {
  if (!currentUser) return "";
  // Generate dari id + nama
  const base = currentUser.full_name.replace(/\s+/g, "").toUpperCase().slice(0, 4);
  return `${base}${String(currentUser.id).padStart(3, "0")}`;
}

function copyReferral() {
  const code = getMyReferralCode();
  navigator.clipboard?.writeText(code).then(() => {
    showToast(`Kode "${code}" dicopy!`);
  }).catch(() => {
    showToast("Gagal copy, salin manual: " + code, "warning");
  });
}

function simulateReferral() {
  if (!currentUser) return;
  DB.referrals = DB.referrals || [];
  const fakeNames = ["Dewi Lestari","Rudi Hartono","Maya Sari","Bayu Pratama","Fitri Handayani","Eko Nugroho"];
  const name = fakeNames[Math.floor(Math.random() * fakeNames.length)];
  const bonus = 50;
  DB.referrals.push({
    referrer_id: currentUser.id,
    referee_name: name,
    bonus,
    at: new Date().toISOString(),
  });
  // Kasih poin ke user
  DB.progress.push({
    user_id: currentUser.id,
    item_type: "referral",
    item_id: Date.now(),
    points: bonus,
    note: `Referral ${name}`,
  });
  saveDB(DB);
  pushNotif(`Referral baru: ${name} mendaftar. +${bonus} poin!`, "success");
  sendWebNotif("Referral Baru! 🎉", `${name} mendaftar dengan kode kamu. +${bonus} poin!`);
  checkAndAwardBadges();
  renderProfile(); renderLeaderboard(); renderProgress();
  showToast(`+${bonus} poin dari referral ${name}`);
}

function renderReferralInfo() {
  if (!currentUser) return;
  const code = getMyReferralCode();
  const el = document.getElementById("refCode");
  if (el) el.textContent = code;

  const mine = (DB.referrals || []).filter(r => r.referrer_id === currentUser.id);
  const elCount = document.getElementById("refCount");
  const elPts = document.getElementById("refPoints");
  if (elCount) elCount.textContent = mine.length;
  if (elPts) elPts.textContent = mine.reduce((s,r) => s + r.bonus, 0);
}

/* ============ COURSE COMPLETION ============ */
function getCourseProgress(courseId) {
  if (!currentUser) return { done: 0, total: 9, percent: 0 };
  const cp = (DB.courseProgress || []).find(c =>
    c.user_id === currentUser.id && c.course_id === courseId
  );
  const total = 9; // 3 modul × 3 lesson
  const done = cp ? cp.done : 0;
  return { done, total, percent: Math.round(done / total * 100) };
}

function markLessonComplete(courseId, lessonIdx) {
  if (!currentUser) return;
  DB.courseProgress = DB.courseProgress || [];
  let cp = DB.courseProgress.find(c =>
    c.user_id === currentUser.id && c.course_id === courseId
  );
  if (!cp) {
    cp = { user_id: currentUser.id, course_id: courseId, done: 0, lessons: [] };
    DB.courseProgress.push(cp);
  }
  if (!cp.lessons.includes(lessonIdx)) {
    cp.lessons.push(lessonIdx);
    cp.done = cp.lessons.length;
    saveDB(DB);
    pushNotif(`Lesson ${lessonIdx + 1} selesai!`, "info");
    if (cp.done === 9) {
      pushNotif(`🎉 Course selesai 100%!`, "success");
      sendWebNotif("Course Selesai! 🎉", "Kamu menyelesaikan seluruh course");
    }
    viewCourseDetail(courseId);
  }
}

function renderCourseProgressInto(id, courseId) {
  const { done, total, percent } = getCourseProgress(courseId);
  const bar = document.getElementById("cdProgBar");
  const txt = document.getElementById("cdProgText");
  if (bar) bar.style.width = percent + "%";
  if (txt) txt.textContent = `${done} dari ${total} lesson selesai (${percent}%)`;
}

/* ============ LEADERBOARD PERIOD ============ */
let currentPeriod = "all";

function setPeriod(p) {
  currentPeriod = p;
  document.querySelectorAll(".period-tab").forEach(b => {
    b.classList.toggle("active", b.dataset.period === p);
  });
  renderLeaderboard();
}

function filterProgressByPeriod(progress) {
  if (currentPeriod === "all") return progress;
  const now = Date.now();
  const day = 24 * 60 * 60 * 1000;
  const cutoff = currentPeriod === "today"
    ? new Date().setHours(0, 0, 0, 0)
    : now - 7 * day;
  return progress.filter(p => {
    const at = p.created_at ? new Date(p.created_at).getTime() : now;
    return at >= cutoff;
  });
}


/* ============ CHAT ============ */
let chatPollId = null;

function renderChat() {
  if (!currentUser) return;
  const box = document.getElementById("chatBox");
  const msgs = DB.chat || [];
  box.innerHTML = msgs.map(m => {
    const isMe = m.from_id === currentUser.id;
    return `<div class="chat-msg ${isMe ? 'me' : ''}">
      <div class="chat-bubble">
        <div class="chat-meta">${isMe ? 'Kamu' : m.from} • ${new Date(m.at).toLocaleTimeString("id-ID")}</div>
        <div>${m.text}</div>
      </div>
    </div>`;
  }).join("");
  box.scrollTop = box.scrollHeight;

  // Users list
  const usersEl = document.getElementById("chatUsers");
  usersEl.innerHTML = DB.users.map(u => `
    <div class="d-flex align-items-center gap-2 py-1 px-2" style="cursor:pointer;"
         onclick="mentionUser('${u.full_name}')">
      <div style="width:.6rem; height:.6rem; border-radius:50%;
           background:${u.is_active ? '#198754' : '#6c757d'};"></div>
      <small>${u.full_name}</small>
      ${u.role === 'admin' ? '<span class="badge bg-danger ms-auto">A</span>' : ''}
    </div>`).join("");
}

function sendChat() {
  const inp = document.getElementById("chatInput");
  const text = inp.value.trim();
  if (!text) return;
  DB.chat = DB.chat || [];
  DB.chat.push({
    id: Date.now(),
    from: currentUser.full_name,
    from_id: currentUser.id,
    text,
    at: new Date().toISOString(),
  });
  saveDB(DB);
  inp.value = "";
  renderChat();

  // Simulasi bot reply setelah 1-3 detik
  if (Math.random() > 0.4) {
    const bots = DB.users.filter(u => u.id !== currentUser.id);
    const bot = bots[Math.floor(Math.random() * bots.length)];
    const replies = [
      "Setuju banget! 👍", "Wah menarik, aku coba ya", "Ada yang tau cara solve lab 3?",
      "Mantap! 🔥", "Thanks sharing-nya", "Aku juga baru selesai lab itu",
      "Nice info!", "Besok ikut CTF gak?", "Boleh minta hint gak?",
    ];
    setTimeout(() => {
      DB.chat.push({
        id: Date.now(),
        from: bot.full_name,
        from_id: bot.id,
        text: replies[Math.floor(Math.random() * replies.length)],
        at: new Date().toISOString(),
      });
      saveDB(DB);
      if (document.getElementById("page-chat").classList.contains("active")) {
        renderChat();
        pushNotif(`💬 ${bot.full_name}: ${DB.chat[DB.chat.length-1].text.slice(0, 40)}...`, "info");
      }
    }, 1000 + Math.random() * 2000);
  }
}

function mentionUser(name) {
  const inp = document.getElementById("chatInput");
  inp.value = `@${name.split(" ")[0]} ${inp.value}`;
  inp.focus();
}

/* ============ ADMIN DASHBOARD ============ */
let chartRoles, chartActivity;

function renderAdmin() {
  if (!currentUser || currentUser.role !== "admin") return;

  document.getElementById("adminUsers").textContent = DB.users.length;
  document.getElementById("adminActive").textContent = DB.users.filter(u => u.is_active).length;
  document.getElementById("adminActivity").textContent = (DB.progress || []).length;
  document.getElementById("adminContainers").textContent =
    (DB.containers || []).filter(c => c.status === "running").length;

  // Audit log
  const log = (DB.auditLog || []).slice(-20).reverse();
  document.getElementById("auditTable").innerHTML = log.length
    ? log.map(l => `<tr>
        <td><small>${new Date(l.at).toLocaleString("id-ID")}</small></td>
        <td><small>${l.user}</small></td>
        <td><span class="badge bg-secondary">${l.action}</span></td>
        <td><small>${l.detail || ""}</small></td>
      </tr>`).join("")
    : `<tr><td colspan="4" class="text-center text-muted py-3">
        Belum ada aktivitas tercatat.</td></tr>`;

  // Charts
  if (typeof Chart === "undefined") return;
  const ctxR = document.getElementById("chartRoles");
  const ctxA = document.getElementById("chartActivity");
  if (!ctxR || !ctxA) return;
  if (chartRoles) chartRoles.destroy();
  if (chartActivity) chartActivity.destroy();

  const roleCount = {admin:0, instructor:0, student:0};
  DB.users.forEach(u => roleCount[u.role] = (roleCount[u.role] || 0) + 1);

  const actCount = {lab:0, quiz:0, referral:0};
  (DB.progress || []).forEach(p => actCount[p.item_type] = (actCount[p.item_type] || 0) + 1);

  chartRoles = new Chart(ctxR, {
    type: "pie",
    data: {
      labels: Object.keys(roleCount),
      datasets: [{
        data: Object.values(roleCount),
        backgroundColor: ["#dc3545","#198754","#0d6efd"],
        borderWidth: 0,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { labels: { color: getComputedStyle(document.body).color } } }
    }
  });

  chartActivity = new Chart(ctxA, {
    type: "bar",
    data: {
      labels: Object.keys(actCount),
      datasets: [{
        label: "Jumlah",
        data: Object.values(actCount),
        backgroundColor: ["#dc3545","#ffc107","#198754"],
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: getComputedStyle(document.body).color }, grid: { display: false } },
        y: { ticks: { color: getComputedStyle(document.body).color }, grid: { color: "rgba(128,128,128,.15)" } }
      }
    }
  });
}

function logAction(action, detail) {
  DB.auditLog = DB.auditLog || [];
  DB.auditLog.push({
    at: new Date().toISOString(),
    user: currentUser?.full_name || "guest",
    action,
    detail,
  });
  if (DB.auditLog.length > 100) DB.auditLog = DB.auditLog.slice(-100);
  saveDB(DB);
}

function clearAuditLog() {
  if (!confirm("Hapus semua log audit?")) return;
  DB.auditLog = [];
  saveDB(DB);
  renderAdmin();
  showToast("Log dibersihkan");
}

/* ============ LOG STREAMING ============ */
let logStreamId = null;
function openLogStream(cid) {
  const c = DB.containers.find(x => x.id === cid);
  if (!c) return;
  document.getElementById("logContainerName").textContent = c.container_id;
  document.getElementById("logStream").innerHTML = "";
  new bootstrap.Modal(document.getElementById("logModal")).show();
  startLogStream(c);
}

function logLine(text, cls = "") {
  const stream = document.getElementById("logStream");
  const div = document.createElement("div");
  div.className = "log-line " + cls;
  const ts = new Date().toLocaleTimeString("id-ID");
  div.textContent = `[${ts}] ${text}`;
  stream.appendChild(div);
  if (document.getElementById("logAutoScroll")?.checked) {
    stream.scrollTop = stream.scrollHeight;
  }
}

function startLogStream(c) {
  stopLogStream();
  logLine(`Attaching to ${c.container_id}...`, "log-info");
  logLine(`Image: ${c.image}`, "log-info");
  logLine(`Network isolated: ${c.network_isolated ? 'yes' : 'no'}`, "log-info");
  logLine(`Published port: ${c.port}`, "log-info");
  logLine("---", "log-info");

  const events = [
    ["[init] Loading configuration...", "log-info"],
    ["[init] Checking dependencies...", "log-info"],
    ["[init] Environment ready", "log-success"],
    ["[web] Starting service on port 80", "log-info"],
    ["[web] Listening on 0.0.0.0:80", "log-success"],
    ["[db] Connected to MySQL", "log-success"],
    ["[warn] Debug mode is ON", "log-warn"],
    ["[warn] Directory listing enabled", "log-warn"],
    ["[req] GET / 200 OK", "log-info"],
    ["[req] GET /login.php 200 OK", "log-info"],
    ["[req] POST /login.php 302 Redirect", "log-info"],
    ["[warn] SQL syntax error detected — potential SQLi attempt", "log-warn"],
    ["[req] GET /admin 403 Forbidden", "log-error"],
    ["[req] GET /robots.txt 200 OK", "log-info"],
    ["[note] Flag planted at /flag.txt", "log-success"],
  ];

  let idx = 0;
  logStreamId = setInterval(() => {
    if (idx >= events.length) {
      logLine("---", "log-info");
      logLine("Waiting for more events... (streaming)", "log-info");
      idx = 3;
      return;
    }
    logLine(events[idx][0], events[idx][1]);
    idx++;
  }, 1200);
}

function stopLogStream() {
  if (logStreamId) { clearInterval(logStreamId); logStreamId = null; }
}

/* ============ AUTO THEME (OS) ============ */
function autoThemeFromOS() {
  if (localStorage.getItem("cybersec_theme")) return; // sudah dipilih manual
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  document.documentElement.setAttribute("data-theme", prefersDark ? "dark" : "light");
  updateThemeBtn();
}
window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", e => {
  if (localStorage.getItem("cybersec_theme")) return;
  document.documentElement.setAttribute("data-theme", e.matches ? "dark" : "light");
  updateThemeBtn();
});


