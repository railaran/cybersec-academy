  <!-- VERIFY CERT -->
  <div id="page-verify" class="page">
    <h3 class="mb-3"><i class="bi bi-patch-check-fill text-info"></i> Verifikasi Sertifikat</h3>
    <div class="row">
      <div class="col-md-6 mx-auto">
        <div class="card p-4">
          <p class="text-muted small">Masukkan Certificate ID untuk memverifikasi keaslian sertifikat.</p>
          <input type="text" class="cert-verify-input mb-3" id="verifyInput"
                 placeholder="CSA-LAB-1-2-XXXXXXX">
          <button class="btn btn-info w-100" onclick="verifyCert()">
            <i class="bi bi-search"></i> Verifikasi
          </button>
          <div id="verifyResult" class="mt-3"></div>
          <hr>
          <small class="text-muted">Format: <code>CSA-{TYPE}-{ITEM_ID}-{USER_ID}-{RANDOM}</code></small>
          <small class="text-muted d-block mt-1">Salin dari bawah sertifikat yang pernah kamu buat.</small>
        </div>
      </div>
    </div>
  </div>


