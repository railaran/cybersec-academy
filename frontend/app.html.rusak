}

/* ============ EVENTS ============ */
function renderEvents() {
  const q = (document.getElementById("eventSearch")?.value || "").toLowerCase();
  const tf = document.getElementById("eventTypeFilter")?.value || "";
  const filtered = DB.events.filter(e =>
    (!q || e.title.toLowerCase().includes(q)) &&
    (!tf || e.type === tf)
  );
  document.getElementById("eventsGrid").innerHTML = filtered.map(e => `
    <div class="col-md-6 col-lg-4">
      <div class="event-card">
        <div class="event-cover"><i class="bi bi-calendar-event"></i></div>
        <div class="p-3">
          <div class="d-flex justify-content-between mb-2">
            <span class="badge bg-danger">${e.type.toUpperCase()}</span>
            <small class="text-muted">${e.start_at || "-"}</small>
          </div>
          <h6 class="mb-1">${e.title}</h6>
          <p class="small text-muted mb-2">${e.description}</p>
          <div class="small text-muted mb-2">
            <div><i class="bi bi-geo-alt"></i> ${e.location}</div>
            <div><i class="bi bi-tag"></i> ${e.is_free ? "Gratis" : "Rp " + e.price.toLocaleString("id-ID")}</div>
          </div>
          <div class="d-flex gap-1">
            <button class="btn btn-sm btn-outline-success flex-fill" onclick="registerEvent(${e.id})"><i class="bi bi-check-circle"></i> Daftar</button>
            <button class="btn btn-sm btn-outline-info" onclick="openEventModal(${e.id})"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-sm btn-outline-danger" onclick="deleteEvent(${e.id})"><i class="bi bi-trash"></i></button>
          </div>
        </div>
      </div>
    </div>
  `).join("");
}
function openEventModal(id) {
  const m = new bootstrap.Modal(document.getElementById("eventModal"));
  if (id) {
    const e = DB.events.find(x => x.id === id);
    document.getElementById("eventModalTitle").textContent = "Edit Event";
    document.getElementById("eventId").value = e.id;
    document.getElementById("eTitle").value = e.title;
    document.getElementById("eType").value = e.type;
    document.getElementById("eLocation").value = e.location;
    document.getElementById("eDate").value = e.start_at || "";
    document.getElementById("eDesc").value = e.description || "";
  } else {
    document.getElementById("eventModalTitle").textContent = "Tambah Event";
    document.getElementById("eventId").value = "";
    document.getElementById("eTitle").value = "";
    document.getElementById("eType").value = "ctf";
    document.getElementById("eLocation").value = "Online";
    document.getElementById("eDate").value = "";
    document.getElementById("eDesc").value = "";
  }
  m.show();
}
function saveEvent() {
  const id = document.getElementById("eventId").value;
  const data = {
    title: document.getElementById("eTitle").value,
    type: document.getElementById("eType").value,
    location: document.getElementById("eLocation").value,
    start_at: document.getElementById("eDate").value,
    description: document.getElementById("eDesc").value,
    is_free: true, price: 0, capacity: 100,
  };
  if (id) Object.assign(DB.events.find(x => x.id === parseInt(id)), data);
  else DB.events.push({id: nextId(DB.events), ...data});
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("eventModal")).hide();
  renderEvents(); renderDashboard();
  showToast(id ? "Event diupdate" : "Event ditambahkan");
}
function deleteEvent(id) {
  if (!confirm("Hapus event ini?")) return;
  DB.events = DB.events.filter(e => e.id !== id);
  saveDB(DB); renderEvents(); renderDashboard();
  showToast("Event dihapus");
}
function registerEvent(id) {
  const e = DB.events.find(x => x.id === id);
  showToast(`Berhasil mendaftar: ${e.title}`);
}

/* ============ LEADERBOARD ============ */
function renderLeaderboard() {
  const totals = {};
  DB.users.forEach(u => totals[u.id] = {name: u.full_name, points: 0, completed: 0});
  const filtered = filterProgressByPeriod(DB.progress || []);
  filtered.forEach(p => {
    if (totals[p.user_id]) {
      totals[p.user_id].points += p.points;
      totals[p.user_id].completed += 1;
    }
  });
  const rows = Object.values(totals).sort((a, b) => b.points - a.points);
  document.getElementById("lbTable").innerHTML = rows.map((r, i) => {
    const medal = i === 0 ? "🥇" : i === 1 ? "🥈" : i === 2 ? "🥉" : (i + 1);
    return `<tr class="${i < 3 ? 'rank-' + (i+1) : ''}">
      <td class="fw-bold">${medal}</td>
      <td><i class="bi bi-person-circle"></i> ${r.name}</td>
      <td class="text-end fw-bold text-warning">${r.points.toLocaleString("id-ID")}</td>
      <td class="text-end">${r.completed}</td>
    </tr>`;
  }).join("");
}


/* ============ PROFILE ============ */
function renderProfile() {
  if (!currentUser) return;
  document.getElementById("navUserName").textContent = currentUser.full_name.split(" ")[0];
  document.getElementById("profName").value = currentUser.full_name;
  document.getElementById("profEmail").value = currentUser.email;
  document.getElementById("profRole").value = currentUser.role;
  renderReferralInfo();
  updateNotifPermBtn();
  renderLoginHistory();
}

function renderLoginHistory() {
  if (!currentUser) return;
  const el = document.getElementById("loginHistoryList");
  if (!el) return;
  const mine = (DB.loginHistory || []).filter(h => h.user_id === currentUser.id).slice(0, 5);
  if (!mine.length) { el.innerHTML = '<span class="text-muted">Belum ada</span>'; return; }
  el.innerHTML = mine.map(h => `
    <div class="d-flex justify-content-between py-1 border-bottom border-secondary">
      <span>${new Date(h.at).toLocaleString("id-ID")}</span>
      <small class="text-muted">${h.device}</small>
    </div>
  `).join("");
}
function saveProfile() {
  const name = document.getElementById("profName").value.trim();
  const email = document.getElementById("profEmail").value.trim();
  if (!name || !email) { showToast("Nama & email wajib diisi", "danger"); return; }
  const dup = DB.users.find(u => u.email === email && u.id !== currentUser.id);
  if (dup) { showToast("Email sudah dipakai user lain", "danger"); return; }
  const u = DB.users.find(x => x.id === currentUser.id);
  u.full_name = name; u.email = email;
  Object.assign(currentUser, { full_name: name, email });
  saveDB(DB);
  renderProfile(); renderUsers(); renderLeaderboard();
  showToast("Profile tersimpan");
}
function changePassword() {
  const oldPw = document.getElementById("oldPw").value;
  const newPw = document.getElementById("newPw").value;
  const confirm = document.getElementById("confirmPw").value;
  const u = DB.users.find(x => x.id === currentUser.id);
  if (u.password !== oldPw) { showToast("Password lama salah", "danger"); return; }
  if (newPw.length < 6) { showToast("Password minimal 6 karakter", "danger"); return; }
  if (newPw !== confirm) { showToast("Konfirmasi tidak cocok", "danger"); return; }
  u.password = newPw; saveDB(DB);
  document.getElementById("oldPw").value = "";
  document.getElementById("newPw").value = "";
  document.getElementById("confirmPw").value = "";
  showToast("Password berhasil diubah");
}

/* ============ PROGRESS ============ */
function renderProgress() {
  if (!currentUser) return;
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const labDone = mine.filter(p => p.item_type === "lab");
  const quizDone = mine.filter(p => p.item_type === "quiz");
  const total = mine.reduce((s, p) => s + p.points, 0);

  document.getElementById("profTotalPoints").textContent = total;
  document.getElementById("profLabsDone").textContent = labDone.length;
  document.getElementById("profQuizDone").textContent = quizDone.length;

  // Rank
  const totals = {};
  DB.users.forEach(u => totals[u.id] = {id: u.id, points: 0});
  DB.progress.forEach(p => { if (totals[p.user_id]) totals[p.user_id].points += p.points; });
  const ranked = Object.values(totals).sort((a, b) => b.points - a.points);
  const rank = ranked.findIndex(r => r.id === currentUser.id) + 1;
  document.getElementById("profRank").textContent = rank > 0 ? "#" + rank : "-";

  // Table labs
  document.getElementById("progressLabsTable").innerHTML = labDone.length
    ? labDone.map(p => {
        const l = DB.labs.find(x => x.id === p.item_id);
        if (!l) return "";
        return `<tr>
          <td><i class="bi bi-terminal text-info"></i> ${l.title}</td>
          <td><span class="badge bg-secondary">${l.category}</span></td>
          <td><span class="badge diff-${l.difficulty}">${l.difficulty}</span></td>
          <td class="text-end text-warning fw-bold">+${p.points}</td>
        </tr>`;
      }).join("")
    : `<tr><td colspan="4" class="text-center text-muted py-4">Belum ada lab diselesaikan. Buka menu Labs & submit flag!</td></tr>`;

  // Table quiz
  document.getElementById("progressQuizTable").innerHTML = quizDone.length
    ? quizDone.map(p => {
        const q = DB.quizzes.find(x => x.id === p.item_id);
        if (!q) return "";
        return `<tr>
          <td><i class="bi bi-question-circle text-warning"></i> ${q.title}</td>
          <td><span class="badge diff-${q.difficulty}">${q.difficulty}</span></td>
          <td class="text-end text-warning fw-bold">+${p.points}</td>
        </tr>`;
      }).join("")
    : `<tr><td colspan="3" class="text-center text-muted py-4">Belum ada quiz diselesaikan.</td></tr>`;
}


/* ============ THEME ============ */
function initTheme() {
  const t = localStorage.getItem("cybersec_theme") || "dark";
  document.documentElement.setAttribute("data-theme", t);
  updateThemeBtn();
}
function toggleTheme() {
  const cur = document.documentElement.getAttribute("data-theme") || "dark";
  const next = cur === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  localStorage.setItem("cybersec_theme", next);
  updateThemeBtn();
}
function updateThemeBtn() {
  const t = document.documentElement.getAttribute("data-theme") || "dark";
  const btn = document.getElementById("themeBtn");
  if (btn) btn.innerHTML = t === "dark"
    ? '<i class="bi bi-moon-stars"></i>'
    : '<i class="bi bi-sun"></i>';
}

/* ============ CERTIFICATES ============ */
function renderCertificates() {
  if (!currentUser) return;
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const grid = document.getElementById("certGrid");

  // Group progress: 1 sertifikat per item
  if (!mine.length) {
    grid.innerHTML = `<div class="col-12 text-center text-muted py-5">
      <i class="bi bi-award fs-1 d-block mb-2"></i>
      Belum ada sertifikat. Selesaikan lab atau quiz dulu!
    </div>`;
    return;
  }

  grid.innerHTML = mine.map(p => {
    let item, icon, type;
    if (p.item_type === "lab") {
      item = DB.labs.find(x => x.id === p.item_id);
      icon = "bi-terminal-fill"; type = "Lab";
    } else {
      item = DB.quizzes.find(x => x.id === p.item_id);
      icon = "bi-question-circle-fill"; type = "Quiz";
    }
    if (!item) return "";
    return `
      <div class="col-md-6 col-lg-4">
        <div class="card p-3 h-100">
          <div class="d-flex align-items-center mb-2">
            <i class="bi ${icon} fs-2 text-warning me-2"></i>
            <div>
              <span class="badge bg-secondary">${type}</span>
              <div class="small text-muted">+${p.points} poin</div>
            </div>
          </div>
          <h6 class="mb-2">${item.title}</h6>
          <button class="btn btn-sm btn-warning mt-auto" onclick="viewCertificate('${p.item_type}', ${p.item_id})">
            <i class="bi bi-award"></i> Lihat Sertifikat
          </button>
        </div>
      </div>`;
  }).join("");
}

function viewCertificate(itemType, itemId) {
  let item, type;
  if (itemType === "lab") {
    item = DB.labs.find(x => x.id === itemId);
    type = "Lab";
  } else {
    item = DB.quizzes.find(x => x.id === itemId);
    type = "Quiz";
  }
  if (!item) { showToast("Item tidak ditemukan", "danger"); return; }

  const date = new Date().toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
  const certId = `CSA-${itemType.toUpperCase()}-${item.id}-${currentUser.id}-${Date.now().toString(36).toUpperCase()}`;

  document.getElementById("certPrintArea").innerHTML = `
    <div style="font-size:1.1rem; letter-spacing:2px; color:#1f6feb; text-transform:uppercase;">CyberSec Academy</div>
    <div style="font-size:.85rem; letter-spacing:4px; margin-bottom:2rem; color:#6c757d;">CERTIFICATE OF COMPLETION</div>
    <div style="font-size:2.5rem; color:#1f6feb; margin-bottom:1rem;">🏆</div>
    <div style="font-size:1rem; color:#6c757d;">Diberikan kepada</div>
    <div style="font-size:2rem; font-weight:bold; margin:.5rem 0 1rem; border-bottom:2px solid #1f6feb; display:inline-block; padding:0 2rem .25rem;">
      ${currentUser.full_name}
    </div>
    <div style="font-size:1rem; color:#6c757d; margin:1rem 0 .5rem;">
      atas keberhasilan menyelesaikan ${type}
    </div>
    <div style="font-size:1.4rem; font-weight:bold; margin-bottom:2rem;">
      ${item.title}
    </div>
    <div style="font-size:.9rem; color:#6c757d; margin-bottom:3rem;">
      dengan skor <strong>+${DB.progress.find(p => p.user_id === currentUser.id && p.item_type === itemType && p.item_id === itemId)?.points || 0} poin</strong>
    </div>
    <div style="display:flex; justify-content:space-between; font-size:.85rem; color:#6c757d; margin-top:3rem;">
      <div>
        <div style="border-top:1px solid #999; padding-top:.25rem; min-width:180px;">
          ${date}
        </div>
      </div>
      <div>
        <div style="border-top:1px solid #999; padding-top:.25rem; min-width:180px;">
          CyberSec Academy
        </div>
      </div>
    </div>
    <div style="font-size:.7rem; color:#999; margin-top:1.5rem;">
      Certificate ID: ${certId}
    </div>
  `;
  showPage("certificate-view");
}

/* ============ CHARTS ============ */
let chartCat, chartDiff;
function renderCharts() {
  if (!currentUser) return;
  if (typeof Chart === "undefined") {
    const catEl = document.getElementById("chartCategory");
    const diffEl = document.getElementById("chartDiff");
    if (catEl && !catEl.dataset.fallbackShown) {
      catEl.parentElement.innerHTML = '<div class="text-center text-muted py-5">' +
        '<i class="bi bi-bar-chart fs-1 d-block mb-2"></i>' +
        'Chart tidak bisa dimuat (offline / CDN diblokir).</div>';
      catEl.dataset.fallbackShown = "1";
    }
    if (diffEl && !diffEl.dataset.fallbackShown) {
      diffEl.parentElement.innerHTML = '<div class="text-center text-muted py-5">' +
        '<i class="bi bi-bar-chart fs-1 d-block mb-2"></i>' +
        'Chart tidak bisa dimuat (offline / CDN diblokir).</div>';
      diffEl.dataset.fallbackShown = "1";
    }
    return;
  }
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const labProgress = mine.filter(p => p.item_type === "lab");

  // Distribusi per kategori
  const catMap = {};
  labProgress.forEach(p => {
    const l = DB.labs.find(x => x.id === p.item_id);
    if (l) catMap[l.category] = (catMap[l.category] || 0) + p.points;
  });

  // Distribusi per difficulty
  const diffMap = {};
  labProgress.forEach(p => {
    const l = DB.labs.find(x => x.id === p.item_id);
    if (l) diffMap[l.difficulty] = (diffMap[l.difficulty] || 0) + p.points;
  });

  const chartColors = ["#58a6ff","#7ee787","#ffa657","#ff7b72","#d2a8ff","#79c0ff","#ffdfb6"];

  const ctxCat = document.getElementById("chartCategory");
  const ctxDiff = document.getElementById("chartDiff");
  if (!ctxCat || !ctxDiff) return;

  if (chartCat) chartCat.destroy();
  if (chartDiff) chartDiff.destroy();

  chartCat = new Chart(ctxCat, {
    type: "doughnut",
    data: {
      labels: Object.keys(catMap).length ? Object.keys(catMap) : ["Belum ada data"],
      datasets: [{
        data: Object.values(catMap).length ? Object.values(catMap) : [1],
        backgroundColor: chartColors,
        borderWidth: 0,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { labels: { color: getComputedStyle(document.body).color } }
      }
    }
  });

  chartDiff = new Chart(ctxDiff, {
    type: "bar",
    data: {
      labels: Object.keys(diffMap).length ? Object.keys(diffMap) : ["Belum ada data"],
      datasets: [{
        label: "Poin",
        data: Object.values(diffMap).length ? Object.values(diffMap) : [0],
        backgroundColor: ["#198754","#ffc107","#dc3545","#6f42c1"],
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: { ticks: { color: getComputedStyle(document.body).color }, grid: { display: false } },
        y: { ticks: { color: getComputedStyle(document.body).color }, grid: { color: "rgba(128,128,128,.15)" } }
      }
    }
  });
}

/* ============ EXPORT / IMPORT ============ */
function exportJSON() {
  const data = JSON.stringify(DB, null, 2);
  const blob = new Blob([data], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `cybersec-backup-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
  showToast("Data berhasil di-export");
}
function importJSON(ev) {
  const file = ev.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      if (!data.users || !data.courses) throw new Error("Format tidak valid");
      if (!confirm("Import akan menimpa data saat ini. Lanjut?")) return;
      DB = data;
      saveDB(DB);
      // Login sebagai user pertama (admin)
      const admin = DB.users.find(u => u.role === "admin") || DB.users[0];
      currentUser = admin;
      renderProfile();
      refreshAll();
      showToast("Data berhasil di-import");
    } catch (err) {
      showToast("Gagal import: " + err.message, "danger");
    }
  };
  reader.readAsText(file);
}


/* ============ NOTIFICATIONS ============ */
function pushNotif(msg, type = "info") {
  DB.notifications = DB.notifications || [];
  DB.notifications.unshift({
    id: Date.now(),
    user_id: currentUser?.id || 0,
    msg, type,
    read: false,
    at: new Date().toISOString()
  });
  if (DB.notifications.length > 30) DB.notifications = DB.notifications.slice(0, 30);
  saveDB(DB);
  renderNotifBadge();
  if (type === "success" || type === "danger") {
    sendWebNotif("CyberSec Academy", msg);
  }
}
function renderNotifBadge() {
  const mine = (DB.notifications || []).filter(n => n.user_id === currentUser?.id && !n.read);
  const badge = document.getElementById("notifBadge");
  if (!badge) return;
  if (mine.length) {
    badge.textContent = mine.length;
    badge.style.display = "";
  } else {
    badge.style.display = "none";
  }
}
function showNotifications() {
  const mine = (DB.notifications || []).filter(n => n.user_id === currentUser?.id);
  const list = document.getElementById("notifList");
  if (!mine.length) {
    list.innerHTML = `<li class="list-group-item bg-transparent text-muted text-center py-4">
      Belum ada notifikasi</li>`;
  } else {
    list.innerHTML = mine.map(n => `
      <li class="list-group-item bg-transparent border-secondary d-flex gap-2">
        <i class="bi bi-${n.type === 'success' ? 'check-circle text-success' :
                           n.type === 'danger'  ? 'exclamation-circle text-danger' :
                                                  'info-circle text-info'}"></i>
        <div class="flex-grow-1">
          <div>${n.msg}</div>
          <small class="text-muted">${new Date(n.at).toLocaleString("id-ID")}</small>
        </div>
      </li>`).join("");
  }
  // Mark read
  DB.notifications.forEach(n => { if (n.user_id === currentUser?.id) n.read = true; });
  saveDB(DB); renderNotifBadge();
  new bootstrap.Modal(document.getElementById("notifModal")).show();
}

/* ============ QUIZ ATTEMPT ============ */
let attempt = null;
let attemptTimerId = null;

function startQuiz(quizId) {
  const quiz = DB.quizzes.find(q => q.id === quizId);
  if (!quiz) return;
  const questions = (DB.quizQuestions || []).filter(q => q.quiz_id === quizId);
  if (!questions.length) {
    showToast("Quiz ini belum punya pertanyaan", "warning");
    return;
  }
  attempt = {
    quiz,
    questions,
    idx: 0,
    answers: {},
    startedAt: Date.now(),
    remaining: quiz.time_limit_min * 60,
  };
  document.getElementById("attemptTitle").textContent = quiz.title;
  renderQuestion();
  new bootstrap.Modal(document.getElementById("attemptModal")).show();
  startAttemptTimer();
}

function startAttemptTimer() {
  clearInterval(attemptTimerId);
  updateTimerBadge();
  attemptTimerId = setInterval(() => {
    attempt.remaining--;
    updateTimerBadge();
    if (attempt.remaining <= 0) {
      clearInterval(attemptTimerId);
      finishAttempt(true);
    }
  }, 1000);
}
function updateTimerBadge() {
  const m = Math.floor(attempt.remaining / 60);
  const s = attempt.remaining % 60;
  document.getElementById("attemptTimer").textContent =
    `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
}

function renderQuestion() {
  const q = attempt.questions[attempt.idx];
  const selected = attempt.answers[q.id];
  document.getElementById("attemptBody").innerHTML = `
    <div class="mb-3">
      <h6>${q.text}</h6>
    </div>
    ${q.answers.map((a, i) => `
      <label class="quiz-option ${selected === i ? 'selected' : ''}" onclick="selectAnswer(${i})">
        <input type="radio" name="opt" ${selected === i ? 'checked' : ''} style="margin-right:.5rem">
        ${String.fromCharCode(65+i)}. ${a}
      </label>
    `).join("")}
  `;
  document.getElementById("attemptProgress").textContent =
    `Soal ${attempt.idx + 1}/${attempt.questions.length}`;
  const btn = document.getElementById("nextBtn");
  if (attempt.idx === attempt.questions.length - 1) {
    btn.innerHTML = '<i class="bi bi-check-circle"></i> Selesai';
  } else {
    btn.innerHTML = '<i class="bi bi-arrow-right"></i> Lanjut';
  }
}

function selectAnswer(i) {
  const q = attempt.questions[attempt.idx];
  attempt.answers[q.id] = i;
  renderQuestion();
}

function nextQuestion() {
  const q = attempt.questions[attempt.idx];
  if (attempt.answers[q.id] === undefined) {
    showToast("Pilih jawaban dulu", "warning");
    return;
  }
  if (attempt.idx < attempt.questions.length - 1) {
    attempt.idx++;
    renderQuestion();
  } else {
    finishAttempt(false);
  }
}

function finishAttempt(timeout) {
  clearInterval(attemptTimerId);
  let correct = 0;
  attempt.questions.forEach(q => {
    if (attempt.answers[q.id] === q.correct) correct++;
  });
  const score = Math.round((correct / attempt.questions.length) * 100);
  const passed = score >= attempt.quiz.pass_score;
  const points = passed ? correct * 50 : 0;

  if (passed) {
    const ex = DB.progress.find(p => p.user_id === currentUser.id &&
      p.item_type === "quiz" && p.item_id === attempt.quiz.id);
    if (ex) {
      ex.points = Math.max(ex.points, points);
      ex.score = Math.max(ex.score || 0, score);
    } else {
      DB.progress.push({user_id: currentUser.id, item_type:"quiz",
        item_id: attempt.quiz.id, points, score});
    }
    saveDB(DB);
    pushNotif(`Selamat! Kamu lulus quiz "${attempt.quiz.title}" dengan skor ${score}%`, "success");
    logActivity("quiz");
    checkAndAwardBadges();
    renderLeaderboard(); renderProgress(); renderCertificates();
  } else {
    pushNotif(`Quiz "${attempt.quiz.title}" belum lulus. Skor: ${score}%`, "danger");
  }

  document.getElementById("attemptBody").innerHTML = `
    <div class="text-center py-4">
      <i class="bi bi-${passed ? 'trophy-fill text-warning' : 'x-circle text-danger'} fs-1"></i>
      <h3 class="mt-2">${passed ? "LULUS!" : "BELUM LULUS"}</h3>
      <p class="text-muted">${timeout ? "Waktu habis" : ""}</p>
      <div class="fs-1 fw-bold ${passed ? 'text-success' : 'text-danger'}">${score}%</div>
      <p>Benar ${correct} dari ${attempt.questions.length}</p>
      ${passed ? `<p class="text-warning">+${points} poin</p>` : ""}
      <p class="small text-muted">Pass score: ${attempt.quiz.pass_score}%</p>
    </div>
  `;
  document.getElementById("nextBtn").innerHTML = '<i class="bi bi-x"></i> Tutup';
  document.getElementById("nextBtn").onclick = () => {
    bootstrap.Modal.getInstance(document.getElementById("attemptModal")).hide();
    attempt = null;
    document.getElementById("nextBtn").onclick = nextQuestion;
  };
}

function cancelAttempt() {
  clearInterval(attemptTimerId);
  attempt = null;
  document.getElementById("nextBtn").onclick = nextQuestion;
}

/* ============ TERMINAL SIMULASI ============ */
let termLab = null;
function openTerminal(labId) {
  termLab = DB.labs.find(l => l.id === labId);
  if (!termLab) return;
  document.getElementById("termLabName").textContent = termLab.title;
  document.getElementById("termBody").innerHTML = `
    <div class="terminal-line">Welcome to ${termLab.title}</div>
    <div class="terminal-line">Kategori: ${termLab.category} | Difficulty: ${termLab.difficulty}</div>
    <div class="terminal-line">${termLab.description || ""}</div>
    <div class="terminal-line">---</div>
    <div class="terminal-line">Hint: coba <b>help</b> untuk daftar perintah.</div>
    <div class="terminal-line">---</div>
  `;
  new bootstrap.Modal(document.getElementById("terminalModal")).show();
  setTimeout(() => document.getElementById("termInput").focus(), 300);
}

function termPrint(line) {
  const body = document.getElementById("termBody");
  const div = document.createElement("div");
  div.className = "terminal-line";
  div.innerHTML = line;
  body.appendChild(div);
  body.scrollTop = body.scrollHeight;
}

function runCmd() {
  const input = document.getElementById("termInput");
  const cmd = input.value.trim();
  if (!cmd) return;
  termPrint(`<span style="color:#58a6ff;">$</span> ${cmd}`);
  input.value = "";

  const [c, ...args] = cmd.split(/\s+/);

  if (c === "help") {
    termPrint("Perintah tersedia:");
    termPrint("  ls              - list file");
    termPrint("  cat &lt;file&gt;      - tampilkan file");
    termPrint("  nmap &lt;target&gt;   - scan port");
    termPrint("  whoami          - user aktif");
    termPrint("  flag            - dapatkan flag (kalau sudah solve)");
    termPrint("  clear           - bersihkan terminal");
  } else if (c === "ls") {
    termPrint("readme.txt   flag.txt   config.php   .hidden");
  } else if (c === "cat") {
    if (!args[0]) { termPrint("cat: missing operand"); return; }
    if (args[0] === "readme.txt") termPrint("Selamat datang di lab CTF. Temukan flag di flag.txt.");
    else if (args[0] === "flag.txt") termPrint("Akses ditolak. Kamu harus menyelesaikan objective dulu.");
    else if (args[0] === "config.php") termPrint("&lt;?php $db_pass = 's3cr3t'; ?&gt;");
    else termPrint(`cat: ${args[0]}: No such file`);
  } else if (c === "nmap") {
    if (!args[0]) { termPrint("nmap: target required"); return; }
    termPrint(`Starting Nmap scan on ${args[0]}...`);
    termPrint("PORT     STATE SERVICE");
    termPrint("22/tcp   open  ssh");
    termPrint("80/tcp   open  http");
    termPrint("3306/tcp open  mysql");
    termPrint("Nmap done: 1 IP address scanned");
  } else if (c === "whoami") {
    termPrint(currentUser?.email || "guest");
  } else if (c === "flag") {
    termPrint(`Flag untuk lab ini: <b style="color:#ffcc00;">${termLab.flag}</b>`);
    termPrint("(Gunakan tombol Flag untuk submit)");
  } else if (c === "clear") {
    document.getElementById("termBody").innerHTML = "";
  } else {
    termPrint(`command not found: ${c}`);
  }
}

/* ============ USER SWITCHER (dev only) ============ */
function switchUser(email) {
  const u = DB.users.find(x => x.email === email);
  if (!u) return;
  currentUser = u;
  renderProfile(); renderProgress(); renderNotifBadge(); renderLeaderboard();
  renderCertificates();
  showToast(`Login sebagai ${u.full_name}`);
}


/* ============ TIMELINE ============ */
function renderTimeline() {
  if (!currentUser) return;
  const mine = (DB.notifications || []).filter(n => n.user_id === currentUser.id);
  const el = document.getElementById("timelineList");
  if (!mine.length) {
    el.innerHTML = '<div class="text-center text-muted py-5">' +
      '<i class="bi bi-clock-history fs-1 d-block mb-2"></i>' +
      'Belum ada aktivitas.</div>';
    return;
  }
  el.innerHTML = '<div style="position:relative; padding-left:2rem;">' +
    '<div style="position:absolute; left:.5rem; top:0; bottom:0; width:2px; background:#30363d;"></div>' +
    mine.map(n => {
      const color = n.type === "success" ? "#198754" :
                    n.type === "danger"  ? "#dc3545" : "#58a6ff";
      const icon  = n.type === "success" ? "check-circle" :
                    n.type === "danger"  ? "exclamation-circle" : "info-circle";
      return `
        <div style="position:relative; margin-bottom:1.5rem;">
          <div style="position:absolute; left:-1.65rem; top:0; width:1rem; height:1rem;
               border-radius:50%; background:${color}; border:2px solid #0d1117;"></div>
          <div class="d-flex justify-content-between">
            <div>
              <i class="bi bi-${icon} me-1" style="color:${color};"></i>
              ${n.msg}
            </div>
            <small class="text-muted">${new Date(n.at).toLocaleString("id-ID")}</small>
          </div>
        </div>`;
    }).join("") + "</div>";
}

/* ============ COURSE DETAIL ============ */
function viewCourseDetail(courseId) {
  const c = DB.courses.find(x => x.id === courseId);
  if (!c) return;
  // Fake modules & lessons
  const modules = [
    {title: "Pengenalan", lessons: ["Overview", "Setup Environment", "Konsep Dasar"]},
    {title: "Praktik Inti", lessons: ["Studi Kasus 1", "Studi Kasus 2", "Latihan Mandiri"]},
    {title: "Advanced", lessons: ["Teknik Lanjutan", "Real-world Scenario", "Final Project"]},
  ];
  const totalLessons = modules.reduce((s, m) => s + m.lessons.length, 0);
  const cp = getCourseProgress(courseId);
  const doneLessons = cp.done;

  const videos = DB.videos || [];
  const cpLessons = (DB.courseProgress || []).find(x =>
    x.user_id === currentUser.id && x.course_id === courseId
  )?.lessons || [];
  const canAccess = canAccessCourse(courseId);

  document.getElementById("courseDetailContent").innerHTML = `
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <h3 class="mb-1">${c.title}</h3>
            <div class="d-flex gap-2 mb-2">
              <span class="badge bg-secondary">${c.level}</span>
              <span class="badge bg-info text-dark">${c.duration_hours} jam</span>
              <span class="badge ${c.is_published ? 'bg-success' : 'bg-secondary'}">
                ${c.is_published ? 'Published' : 'Draft'}</span>
            </div>
          </div>
          <div class="text-end">
            <div class="fs-3 fw-bold text-warning">
              ${c.price ? "Rp " + c.price.toLocaleString("id-ID") : "Gratis"}
            </div>
          </div>
        </div>
        <p class="text-muted">${c.description || "Tidak ada deskripsi."}</p>
        ${c.price > 0 && !canAccess
          ? `<button class="btn btn-warning w-100 mb-3" onclick="openCheckout(${c.id})">
              <i class="bi bi-cart-fill"></i> Beli Course — Rp ${c.price.toLocaleString("id-ID")}
            </button>`
          : c.price > 0
            ? `<div class="alert alert-success py-2 mb-3">
                <i class="bi bi-check-circle-fill"></i> Sudah dibeli
              </div>`
            : ""}
        <div class="progress" style="height:8px;">
          <div class="progress-bar bg-success" id="cdProgBar" style="width:0%"></div>
        </div>
        <small class="text-muted" id="cdProgText">0 dari ${totalLessons} lesson selesai</small>
      </div>
    </div>

    ${!canAccess
      ? showLockedOverlay(courseId)
      : `<div class="row g-3">
          ${modules.map((m, i) => `
            <div class="col-md-4">
              <div class="card p-3 h-100">
                <h6><i class="bi bi-folder2 text-info"></i> Modul ${i+1}: ${m.title}</h6>
            <div class="mt-2">
              ${m.lessons.map((l, j) => {
                const lessonIdx = i * 3 + j;
                const done = cpLessons.includes(lessonIdx);
                const vid = videos.find(v => v.lesson_id === lessonIdx);
                return `
                  <div class="video-card ${done ? 'video-lesson-done' : ''} mb-2"
                       onclick="openVideo(${courseId}, ${lessonIdx}, '${l.replace(/'/g, "\\'")}')">
                    <div class="video-thumb" style="background-image:url('${vid?.thumb || ""}'); height:70px; position:relative;">
                      <div class="video-play" style="width:2rem;height:2rem;font-size:1rem;">
                        <i class="bi bi-play-fill"></i>
                      </div>
                    </div>
                    <div class="p-2">
                      <div class="small">${l}</div>
                      <small class="text-muted">${vid ? Math.floor(vid.duration/60) + "m " + (vid.duration%60) + "s" : "—"}</small>
                    </div>
                  </div>`;
              }).join("")}
                </div>
              </div>
            </div>`).join("")}
        </div>`}
  `;
  showPage("course-detail");
}

/* ============ GLOBAL SEARCH ============ */
function openGlobalSearch() {
  new bootstrap.Modal(document.getElementById("globalSearchModal")).show();
  setTimeout(() => document.getElementById("gsInput").focus(), 300);
}
function runGlobalSearch() {
  const q = document.getElementById("gsInput").value.trim().toLowerCase();
  const box = document.getElementById("gsResults");
  if (q.length < 2) {
    box.innerHTML = '<p class="text-muted text-center py-3">Ketik minimal 2 karakter.</p>';
    return;
  }
  const results = [];
  DB.users.forEach(u => {
    if (u.full_name.toLowerCase().includes(q) || u.email.toLowerCase().includes(q))
      results.push({icon: "person-circle", color: "info", label: u.full_name, sub: u.email, page: "users"});
  });
  DB.courses.forEach(c => {
    if (c.title.toLowerCase().includes(q))
      results.push({icon: "journal-code", color: "success", label: c.title, sub: "Course", page: "courses"});
  });
  DB.labs.forEach(l => {
    if (l.title.toLowerCase().includes(q))
      results.push({icon: "terminal-fill", color: "danger", label: l.title, sub: "Lab", page: "labs"});
  });
  DB.quizzes.forEach(x => {
    if (x.title.toLowerCase().includes(q))
      results.push({icon: "question-circle-fill", color: "warning", label: x.title, sub: "Quiz", page: "quizzes"});
  });
  DB.tools.forEach(t => {
    if (t.name.toLowerCase().includes(q))
      results.push({icon: "tools", color: "info", label: t.name, sub: "Tool", page: "tools"});
  });
  DB.events.forEach(e => {
    if (e.title.toLowerCase().includes(q))
      results.push({icon: "calendar-event", color: "success", label: e.title, sub: "Event", page: "events"});
  });

  if (!results.length) {
    box.innerHTML = '<p class="text-muted text-center py-3">Tidak ada hasil.</p>';
    return;
  }
  box.innerHTML = results.map(r => `
    <div class="d-flex align-items-center gap-2 p-2 border-bottom border-secondary"
         style="cursor:pointer;" onclick="bootstrap.Modal.getInstance(document.getElementById('globalSearchModal')).hide(); showPage('${r.page}')">
      <i class="bi bi-${r.icon} text-${r.color} fs-4"></i>
      <div>
        <div>${r.label}</div>
        <small class="text-muted">${r.sub}</small>
      </div>
      <i class="bi bi-arrow-right ms-auto text-muted"></i>
    </div>
  `).join("");
}


/* ============ FORUM ============ */
let currentForumCourse = null;
function viewCourseForum(courseId) {
  currentForumCourse = courseId;
  const c = DB.courses.find(x => x.id === courseId);
  if (!c) return;

  const forum = (DB.forum || []).filter(f => f.course_id === courseId);
  const reviews = (DB.reviews || []).filter(r => r.course_id === courseId);
  const avg = reviews.length ? (reviews.reduce((s,r) => s+r.rating, 0) / reviews.length).toFixed(1) : "–";
  const myReview = reviews.find(r => r.user_id === currentUser.id);

  document.getElementById("courseDetailContent").innerHTML = `
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h3 class="mb-1"><i class="bi bi-chat-dots text-info"></i> ${c.title}</h3>
            <div class="star-rating mb-2">
              ${"★".repeat(Math.round(avg === "–" ? 0 : avg))}${"☆".repeat(5 - Math.round(avg === "–" ? 0 : avg))}
              <span class="text-muted ms-2">${avg} (${reviews.length} review)</span>
            </div>
          </div>
          <button class="btn btn-sm btn-outline-secondary" onclick="showPage('courses')">
            <i class="bi bi-arrow-left"></i> Kembali
          </button>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-7">
        <div class="card p-3">
          <h6><i class="bi bi-chat-square-text"></i> Diskusi (${forum.length})</h6>
          <div class="mb-3">
            <textarea class="form-control mb-2" id="forumNewMsg" rows="2"
                      placeholder="Tulis pertanyaan atau komentar..."></textarea>
            <button class="btn btn-sm btn-primary" onclick="postForum()">
              <i class="bi bi-send"></i> Kirim
            </button>
          </div>
          <div id="forumList">
            ${forum.length ? forum.map(f => renderForumMsg(f)).join("") :
              '<div class="text-muted text-center py-3">Belum ada diskusi. Jadilah yang pertama!</div>'}
          </div>
        </div>
      </div>

      <div class="col-md-5">
        <div class="card p-3 mb-3">
          <h6><i class="bi bi-star-fill text-warning"></i> Rating Kamu</h6>
          <div class="mb-2">
            ${[1,2,3,4,5].map(n => `
              <i class="bi bi-star-fill star-click ${myReview && myReview.rating >= n ? 'active' : ''}"
                 onclick="setRating(${n})" data-rating="${n}"></i>
            `).join("")}
          </div>
          <textarea class="form-control mb-2" id="reviewText" rows="2"
                    placeholder="Tulis review...">${myReview ? myReview.text : ""}</textarea>
          <button class="btn btn-sm btn-warning w-100" onclick="submitReview()">
            <i class="bi bi-send"></i> ${myReview ? "Update Review" : "Kirim Review"}
          </button>
        </div>

        <div class="card p-3">
          <h6><i class="bi bi-people"></i> Review Terbaru</h6>
          ${reviews.length ? reviews.slice(-3).reverse().map(r => `
            <div class="mb-2 pb-2 border-bottom border-secondary">
              <div class="d-flex justify-content-between">
                <strong>${r.user_name}</strong>
                <span class="star-rating">${"★".repeat(r.rating)}${"☆".repeat(5-r.rating)}</span>
              </div>
              <small class="text-muted">${r.text}</small>
            </div>
          `).join("") : '<small class="text-muted">Belum ada review</small>'}
        </div>
      </div>
    </div>
  `;
  window.__pendingRating = myReview ? myReview.rating : 5;
  showPage("course-detail");
  setTimeout(() => renderCourseProgressInto("cdProgBar", courseId), 50);
}

function renderForumMsg(f) {
  return `
    <div class="forum-msg">
      <div class="d-flex justify-content-between mb-1">
        <strong><i class="bi bi-person-circle"></i> ${f.user_name}</strong>
        <small class="text-muted">${new Date(f.at).toLocaleString("id-ID")}</small>
      </div>
      <div>${f.text}</div>
      ${f.replies && f.replies.length ? f.replies.map(r => `
        <div class="forum-reply">
          <div class="d-flex justify-content-between mb-1">
            <small><strong>${r.user_name}</strong></small>
            <small class="text-muted">${new Date(r.at).toLocaleString("id-ID")}</small>
          </div>
          <small>${r.text}</small>
        </div>
      `).join("") : ""}
      <button class="btn btn-sm btn-link text-info p-0 mt-2"
              onclick="replyForum(${f.id})">
        <i class="bi bi-reply"></i> Balas
      </button>
    </div>
  `;
}

function postForum() {
  const txt = document.getElementById("forumNewMsg").value.trim();
  if (!txt) { showToast("Tulis dulu pesannya", "warning"); return; }
  DB.forum = DB.forum || [];
  DB.forum.push({
    id: Date.now(),
    course_id: currentForumCourse,
    user_id: currentUser.id,
    user_name: currentUser.full_name,
    text: txt,
    at: new Date().toISOString(),
    replies: []
  });
  saveDB(DB);
  logAction("FORUM_POST", `Course #${currentForumCourse}`);
  pushNotif(`Kamu posting di forum course`, "info");
  checkAndAwardBadges();
  viewCourseForum(currentForumCourse);
  showToast("Pesan terkirim");
}

function replyForum(forumId) {
  const txt = prompt("Balasan kamu:");
  if (!txt) return;
  const f = DB.forum.find(x => x.id === forumId);
  if (!f) return;
  f.replies = f.replies || [];
  f.replies.push({
    user_id: currentUser.id,
    user_name: currentUser.full_name,
    text: txt,
    at: new Date().toISOString()
  });
  saveDB(DB);
  viewCourseForum(currentForumCourse);
  showToast("Balasan terkirim");
}

function setRating(n) {
  window.__pendingRating = n;
  document.querySelectorAll(".star-click").forEach((el, i) => {
    el.classList.toggle("active", i < n);
  });
}

function submitReview() {
  const text = document.getElementById("reviewText").value.trim();
  const rating = window.__pendingRating || 5;
  if (!text) { showToast("Tulis review dulu", "warning"); return; }
  DB.reviews = DB.reviews || [];
  const existing = DB.reviews.find(r => r.course_id === currentForumCourse &&
                                        r.user_id === currentUser.id);
  if (existing) {
    existing.rating = rating;
    existing.text = text;
    existing.at = new Date().toISOString();
  } else {
    DB.reviews.push({
      id: Date.now(),
      course_id: currentForumCourse,
      user_id: currentUser.id,
      user_name: currentUser.full_name,
      rating, text,
      at: new Date().toISOString()
    });
  }
  saveDB(DB);
  pushNotif(`Kamu memberi rating ${rating}★ untuk course`, "success");
  checkAndAwardBadges();
  viewCourseForum(currentForumCourse);
  showToast("Review tersimpan");
}

/* ============ CONTAINERS ============ */
function renderContainers() {
  if (!currentUser) return;
  const list = (DB.containers || []).filter(c => c.user_id === currentUser.id);
  const running = list.filter(c => c.status === "running");
  const stopped = list.filter(c => c.status === "stopped");
  const totalUptime = list.reduce((s, c) => s + (c.uptime_min || 0), 0);

  document.getElementById("cStatTotal").textContent = list.length;
  document.getElementById("cStatRunning").textContent = running.length;
  document.getElementById("cStatStopped").textContent = stopped.length;
  document.getElementById("cStatTime").textContent = totalUptime + "m";

  const el = document.getElementById("containersList");
  if (!list.length) {
    el.innerHTML = `<div class="card p-5 text-center text-muted">
      <i class="bi bi-box fs-1 d-block mb-2"></i>
      Belum ada container. Klik <strong>Spawn Lab</strong> untuk memulai.
    </div>`;
    return;
  }
  el.innerHTML = list.map(c => `
    <div class="container-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <h6 class="mb-1">
            <span class="status-dot status-${c.status}"></span>
            ${c.lab_title}
          </h6>
          <small class="text-muted d-block">
            <code>${c.container_id}</code> • image: <code>${c.image}</code>
          </small>
          <small class="text-muted">
            Port: <span class="badge bg-secondary">${c.port}</span>
            ${c.network_isolated ? '<span class="badge bg-info text-dark ms-1">isolated</span>' : ''}
            ${c.status === "running"
              ? `• Expires in ${c.expires_min}m`
              : `• Stopped`}
          </small>
        </div>
        <div class="text-end">
          <div class="small text-muted">Uptime</div>
          <div class="fw-bold">${c.uptime_min || 0}m</div>
        </div>
      </div>
      <div class="d-flex gap-2 mt-2">
        ${c.status === "running"
          ? `<button class="btn btn-sm btn-outline-danger" onclick="stopContainer(${c.id})">
              <i class="bi bi-stop-fill"></i> Stop</button>`
          : `<button class="btn btn-sm btn-outline-success" onclick="startContainer(${c.id})">
              <i class="bi bi-play-fill"></i> Start</button>`}
        <button class="btn btn-sm btn-outline-info" onclick="openTerminalFromContainer(${c.id})">
          <i class="bi bi-terminal"></i> Terminal</button>
        <button class="btn btn-sm btn-outline-primary" onclick="openLogStream(${c.id})">
          <i class="bi bi-file-text"></i> Logs</button>
        <button class="btn btn-sm btn-outline-primary" onclick="openLogStream(${c.id})">
          <i class="bi bi-file-text"></i> Logs</button>
        <button class="btn btn-sm btn-outline-secondary ms-auto" onclick="removeContainer(${c.id})">
          <i class="bi bi-trash"></i></button>
      </div>
    </div>
  `).join("");
}

function openSpawnContainer() {
  const sel = document.getElementById("spawnLabSelect");
  sel.innerHTML = DB.labs.map(l => `<option value="${l.id}">${l.title} (${l.difficulty})</option>`).join("");
  new bootstrap.Modal(document.getElementById("spawnModal")).show();
}

function spawnContainer() {
  const labId = parseInt(document.getElementById("spawnLabSelect").value);
  const duration = parseInt(document.getElementById("spawnDuration").value) || 60;
  const isolated = document.getElementById("spawnNetworkIsolated").checked;
  const lab = DB.labs.find(l => l.id === labId);
  if (!lab) return;

  const cid = "ctf-" + lab.category + "-" + Math.random().toString(36).slice(2, 8);
  const port = 30000 + Math.floor(Math.random() * 20000);

  DB.containers = DB.containers || [];
  DB.containers.push({
    id: Date.now(),
    user_id: currentUser.id,
    lab_id: labId,
    lab_title: lab.title,
    image: `cybersec/${lab.category}:${lab.difficulty}`,
    container_id: cid,
    port,
    status: "starting",
    uptime_min: 0,
    expires_min: duration,
    network_isolated: isolated,
    created_at: new Date().toISOString(),
  });
  saveDB(DB);
  logAction("CONTAINER_SPAWN", `${lab.title} → ${cid}`);
  bootstrap.Modal.getInstance(document.getElementById("spawnModal")).hide();
  renderContainers();
  pushNotif(`Lab "${lab.title}" sedang di-spawn...`, "info");
  showToast("Container sedang di-start...");

  setTimeout(() => {
    const c = DB.containers.find(x => x.container_id === cid);
    if (c) {
      c.status = "running";
      c.uptime_min = 0;
      saveDB(DB);
      renderContainers();
      pushNotif(`Lab "${lab.title}" siap digunakan di port ${port}`, "success");
      checkAndAwardBadges();
      showToast("Container running!");
    }
  }, 2000);
}

function startContainer(id) {
  const c = DB.containers.find(x => x.id === id);
  if (!c) return;
  c.status = "starting";
  saveDB(DB); renderContainers();
  showToast("Starting...");
  setTimeout(() => {
    c.status = "running";
    saveDB(DB); renderContainers();
    pushNotif(`Lab "${c.lab_title}" running kembali`, "success");
  }, 1500);
}

function stopContainer(id) {
  const c = DB.containers.find(x => x.id === id);
  if (!c) return;
  c.status = "stopped";
  saveDB(DB); renderContainers();
  pushNotif(`Lab "${c.lab_title}" dihentikan`, "info");
  showToast("Container stopped");
}

function removeContainer(id) {
  if (!confirm("Hapus container ini?")) return;
  DB.containers = DB.containers.filter(c => c.id !== id);
  saveDB(DB); renderContainers();
  showToast("Container dihapus");
}

function openTerminalFromContainer(cid) {
  const c = DB.containers.find(x => x.id === cid);
  if (!c) return;
  const lab = DB.labs.find(l => l.id === c.lab_id);
  if (lab) openTerminal(lab.id);
}


/* ============ BADGES ============ */
function checkAndAwardBadges() {
  if (!currentUser) return;
  DB.user_badges = DB.user_badges || [];
  const earned = new Set(
    DB.user_badges.filter(b => b.user_id === currentUser.id).map(b => b.badge_id)
  );
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const labCount = mine.filter(p => p.item_type === "lab").length;
  const quizCount = mine.filter(p => p.item_type === "quiz").length;
  const totalPoints = mine.reduce((s,p) => s + p.points, 0);
  const forumPosts = (DB.forum || []).filter(f => f.user_id === currentUser.id).length;
  const reviews = (DB.reviews || []).filter(r => r.user_id === currentUser.id).length;
  const containers = (DB.containers || []).filter(c => c.user_id === currentUser.id).length;
  const refs = (DB.referrals || []).filter(r => r.referrer_id === currentUser.id).length;
  const finishedCourses = (DB.courseProgress || []).filter(c =>
    c.user_id === currentUser.id && c.done === 9
  ).length;

  const checks = [
    ["first_login", true],
    ["first_lab", labCount >= 1],
    ["lab_master", labCount >= 5],
    ["quiz_rookie", quizCount >= 1],
    ["quiz_master", quizCount >= 3],
    ["forum_active", forumPosts >= 3],
    ["reviewer", reviews >= 1],
    ["container_pro", containers >= 3],
    ["point_500", totalPoints >= 500],
    ["point_1000", totalPoints >= 1000],
    ["referrer", refs >= 1],
    ["course_finisher", finishedCourses >= 1],
    ["buyer", (DB.invoices || []).filter(i => i.user_id === currentUser.id && i.status === "paid").length >= 1],
    ["verifier", false],
  ];

  checks.forEach(([id, ok]) => {
    if (ok && !earned.has(id)) {
      const badge = DB.badges.find(b => b.id === id);
      if (!badge) return;
      DB.user_badges.push({
        user_id: currentUser.id,
        badge_id: id,
        earned_at: new Date().toISOString()
      });
      earned.add(id);
      showBadgeToast(badge);
      pushNotif(`🏆 Badge baru: ${badge.name}!`, "success");
    }
  });
  saveDB(DB);
}

function showBadgeToast(badge) {
  const el = document.createElement("div");
  el.className = "badge-toast";
  el.innerHTML = `
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-${badge.icon} fs-2 text-warning"></i>
      <div>
        <div class="small text-uppercase" style="opacity:.8;letter-spacing:1px;">Badge Unlocked!</div>
        <div class="fw-bold">${badge.name}</div>
        <div class="small" style="opacity:.9;">${badge.desc}</div>
      </div>
    </div>
  `;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 5000);
}

function renderBadges() {
  if (!currentUser) return;
  const earned = DB.user_badges.filter(b => b.user_id === currentUser.id);
  const earnedIds = new Set(earned.map(b => b.badge_id));
  const total = DB.badges.length;
  const percent = Math.round(earned.length / total * 100);

  document.getElementById("badgeEarned").textContent = earned.length;
  document.getElementById("badgeLocked").textContent = total - earned.length;
  document.getElementById("badgeProgress").textContent = percent + "%";
  document.getElementById("badgeStreak").textContent = Math.min(earned.length, 7);

  document.getElementById("badgesGrid").innerHTML = DB.badges.map(b => {
    const has = earnedIds.has(b.id);
    return `
      <div class="col-md-4 col-lg-3">
        <div class="badge-card ${has ? 'earned' : 'locked'}">
          <i class="bi bi-${b.icon} badge-icon"></i>
          <h6 class="mb-1">${b.name}</h6>
          <small class="text-muted d-block">${b.desc}</small>
          ${has
            ? '<span class="badge bg-warning text-dark mt-2">✓ Earned</span>'
            : '<span class="badge bg-secondary mt-2"><i class="bi bi-lock"></i> Locked</span>'}
        </div>
      </div>`;
  }).join("");
}

