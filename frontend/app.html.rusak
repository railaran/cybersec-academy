function loadDB() {
  let raw = localStorage.getItem(DB_KEY);
  if (!raw) {
    const db = defaultDB();
    localStorage.setItem(DB_KEY, JSON.stringify(db));
    return db;
  }
  try { return JSON.parse(raw); }
  catch { const db = defaultDB(); localStorage.setItem(DB_KEY, JSON.stringify(db)); return db; }
}
function saveDB(db) { localStorage.setItem(DB_KEY, JSON.stringify(db)); }
function nextId(arr) { return arr.length ? Math.max(...arr.map(x=>x.id)) + 1 : 1; }

let DB = loadDB();
let currentUser = null;
let toast;

/* ============ AUTH ============ */
document.addEventListener("DOMContentLoaded", () => {
  const tabLoginEl = document.getElementById("tabLogin");
  const tabRegEl   = document.getElementById("tabRegister");
  const nameField  = document.getElementById("nameField");

  if (tabLoginEl) tabLoginEl.addEventListener("click", e => {
  e.preventDefault();
    tabLoginEl.classList.add("active");
    tabRegEl.classList.remove("active");
    nameField.style.display = "none";
  e.preventDefault();
    tabRegEl.classList.add("active");
    tabLoginEl.classList.remove("active");
    nameField.style.display = "block";
  });
});

document.addEventListener("DOMContentLoaded", () => {
  const loginFormEl = document.getElementById("loginForm");
  if (loginFormEl) {
    loginFormEl.addEventListener("submit", e => {
      e.preventDefault();
      const email = document.getElementById("loginEmail").value.trim();
      const password = document.getElementById("loginPassword").value;
      const isRegister = document.getElementById("tabRegister").classList.contains("active");
      const err = document.getElementById("loginError");
      err.classList.add("d-none");

      if (isRegister) {
        const name = document.getElementById("regName").value.trim();
        if (!name) { err.textContent = "Nama wajib diisi"; err.classList.remove("d-none"); return; }
        if (DB.users.find(u => u.email === email)) {
          err.textContent = "Email sudah terdaftar"; err.classList.remove("d-none"); return;
        }
        const u = {id: nextId(DB.users), full_name: name, email, password, role: "student", is_active: true};
        DB.users.push(u); saveDB(DB);
        loginAs(u);
      } else {
        const u = DB.users.find(x => x.email === email && x.password === password);
        if (!u) { err.textContent = "Email atau password salah"; err.classList.remove("d-none"); return; }
        loginAs(u);
      }
    });
  }
});

function loginAs(u) {
  currentUser = u;
  document.getElementById("loginView").style.display = "none";
  document.getElementById("mainApp").style.display = "block";
  refreshAll();
  renderNotifBadge();
  pushNotif(`Selamat datang, ${u.full_name}!`, "info");
  logAction("LOGIN", u.email);
  recordLogin();
  broadcastDBUpdate();
  setTimeout(checkAndAwardBadges, 500);
  showToast(`Selamat datang, ${u.full_name}!`);
}

function logout() {
  currentUser = null;
  document.getElementById("loginView").style.display = "flex";
  document.getElementById("mainApp").style.display = "none";
  document.getElementById("loginPassword").value = "";
}

/* ============ NAV ============ */
function showPage(name) {
  document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
  document.getElementById("page-" + name).classList.add("active");
  if (name === "profile") renderProfile();
  if (name === "progress") { renderProgress(); setTimeout(renderCharts, 100); }
  if (name === "certificates") renderCertificates();
  if (name === "timeline") renderTimeline();
  if (name === "containers") renderContainers();
  if (name === "badges") renderBadges();
  if (name === "chat") renderChat();
  if (name === "admin") renderAdmin();
  if (name === "my-courses") renderMyCourses();
  if (name === "verify") setTimeout(() => document.getElementById("verifyInput")?.focus(), 100);
  if (name === "rapor") renderRapor();
  if (name === "share") renderShare();
  if (name === "api-docs") renderApiDocs();
  if (name === "notes") renderNotes();
  if (name === "pomodoro") renderPomodoro();
  if (name === "heatmap") renderHeatmap();
  window.scrollTo(0, 0);
}

/* ============ REFRESH ============ */
function refreshAll() {
  renderDashboard();
  renderUsers();
  renderCourses();
  renderLabs();
  renderQuizzes();
  renderTools();
  renderEvents();
  renderLeaderboard();
  renderProfile();
  renderProgress();
  renderNotifBadge();
  renderContainers();
  renderBadges();
  renderReferralInfo();
  renderMyCourses();
  renderRapor();
  renderShare();
  checkAndAwardBadges();
  if (currentUser?.role === "admin") {
    const btn = document.getElementById("adminBtn");
    if (btn) btn.style.display = "";
  }
}

/* ============ DASHBOARD ============ */
function renderDashboard() {
  document.getElementById("statUsers").textContent = DB.users.length;
  document.getElementById("statCourses").textContent = DB.courses.length;
  document.getElementById("statLabs").textContent = DB.labs.length;
  document.getElementById("statQuizzes").textContent = DB.quizzes.length;
  document.getElementById("statTools").textContent = DB.tools.length;
  document.getElementById("statEvents").textContent = DB.events.length;

  document.getElementById("recentCourses").innerHTML = DB.courses.slice(-5).reverse()
    .map(c => `<li><i class="bi bi-dot"></i> ${c.title}</li>`).join("");
  document.getElementById("recentLabs").innerHTML = DB.labs.slice(-5).reverse()
    .map(l => `<li><i class="bi bi-dot"></i> ${l.title}</li>`).join("");
}

/* ============ USERS ============ */
function renderUsers() {
  const q = (document.getElementById("userSearch")?.value || "").toLowerCase();
  const rf = document.getElementById("userRoleFilter")?.value || "";
  const filtered = DB.users.filter(u =>
    (!q || u.full_name.toLowerCase().includes(q) || u.email.toLowerCase().includes(q)) &&
    (!rf || u.role === rf)
  );
  document.getElementById("usersTable").innerHTML = filtered.map((u, i) => `
    <tr>
      <td>${i+1}</td>
      <td><i class="bi bi-person-circle"></i> ${u.full_name}</td>
      <td>${u.email}</td>
      <td><span class="badge badge-${u.role}">${u.role}</span></td>
      <td><span class="badge badge-${u.is_active ? 'active' : 'inactive'}">${u.is_active ? 'Aktif' : 'Nonaktif'}</span></td>
      <td>
        <button class="btn btn-sm btn-outline-info" onclick="openUserModal(${u.id})"><i class="bi bi-pencil"></i></button>
        <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(${u.id})"><i class="bi bi-trash"></i></button>
      </td>
    </tr>
  `).join("");
}
function openUserModal(id) {
  const m = new bootstrap.Modal(document.getElementById("userModal"));
  if (id) {
    const u = DB.users.find(x => x.id === id);
    document.getElementById("userModalTitle").textContent = "Edit User";
    document.getElementById("userId").value = u.id;
    document.getElementById("uName").value = u.full_name;
    document.getElementById("uEmail").value = u.email;
    document.getElementById("uRole").value = u.role;
    document.getElementById("uActive").checked = u.is_active;
  } else {
    document.getElementById("userModalTitle").textContent = "Tambah User";
    document.getElementById("userId").value = "";
    document.getElementById("uName").value = "";
    document.getElementById("uEmail").value = "";
    document.getElementById("uRole").value = "student";
    document.getElementById("uActive").checked = true;
  }
  m.show();
}
function saveUser() {
  const id = document.getElementById("userId").value;
  const data = {
    full_name: document.getElementById("uName").value,
    email: document.getElementById("uEmail").value,
    role: document.getElementById("uRole").value,
    is_active: document.getElementById("uActive").checked,
  };
  if (id) {
    const u = DB.users.find(x => x.id === parseInt(id));
    Object.assign(u, data);
  } else {
    DB.users.push({id: nextId(DB.users), password: "changeme", ...data});
  }
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("userModal")).hide();
  renderUsers(); renderDashboard(); renderLeaderboard();
  showToast(id ? "User diupdate" : "User ditambahkan");
}
function deleteUser(id) {
  if (!confirm("Hapus user ini?")) return;
  DB.users = DB.users.filter(u => u.id !== id);
  saveDB(DB); logAction("USER_DELETE", `User #${id}`);
  renderUsers(); renderDashboard(); renderLeaderboard();
  showToast("User dihapus");
}

/* ============ COURSES ============ */
function renderCourses() {
  const q = (document.getElementById("courseSearch")?.value || "").toLowerCase();
  const lf = document.getElementById("courseLevelFilter")?.value || "";
  const filtered = DB.courses.filter(c =>
    (!q || c.title.toLowerCase().includes(q)) &&
    (!lf || c.level === lf)
  );
  document.getElementById("coursesGrid").innerHTML = filtered.map(c => `
    <div class="col-md-6 col-lg-4">
      <div class="course-card p-3">
        <div class="d-flex justify-content-between mb-2">
          <span class="badge bg-secondary">${c.level}</span>
          <small class="text-muted">${c.duration_hours} jam</small>
        </div>
        <h6 class="mb-1">${c.title}</h6>
        <p class="small text-muted mb-2">${(c.description||"").substring(0,80)}...</p>
        <div class="d-flex justify-content-between align-items-center">
          <span class="badge ${c.is_published ? 'bg-success' : 'bg-secondary'}">${c.is_published ? 'Published' : 'Draft'}</span>
          <div>
            <button class="btn btn-sm btn-outline-warning" onclick="viewCourseDetail(${c.id})" title="Detail"><i class="bi bi-eye"></i></button>
            <button class="btn btn-sm btn-outline-primary" onclick="viewCourseForum(${c.id})" title="Forum"><i class="bi bi-chat-dots"></i></button>
            <button class="btn btn-sm btn-outline-info" onclick="openCourseModal(${c.id})"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-sm btn-outline-danger" onclick="deleteCourse(${c.id})"><i class="bi bi-trash"></i></button>
          </div>
        </div>
      </div>
    </div>
  `).join("");
}
function openCourseModal(id) {
  const m = new bootstrap.Modal(document.getElementById("courseModal"));
  if (id) {
    const c = DB.courses.find(x => x.id === id);
    document.getElementById("courseModalTitle").textContent = "Edit Course";
    document.getElementById("courseId").value = c.id;
    document.getElementById("cTitle").value = c.title;
    document.getElementById("cLevel").value = c.level;
    document.getElementById("cDesc").value = c.description || "";
    document.getElementById("cDuration").value = c.duration_hours;
    document.getElementById("cPrice").value = c.price;
    document.getElementById("cPublished").checked = c.is_published;
  } else {
    document.getElementById("courseModalTitle").textContent = "Tambah Course";
    document.getElementById("courseId").value = "";
    document.getElementById("cTitle").value = "";
    document.getElementById("cLevel").value = "beginner";
    document.getElementById("cDesc").value = "";
    document.getElementById("cDuration").value = 10;
    document.getElementById("cPrice").value = 0;
    document.getElementById("cPublished").checked = true;
  }
  m.show();
}
function saveCourse() {
  const id = document.getElementById("courseId").value;
  const data = {
    title: document.getElementById("cTitle").value,
    level: document.getElementById("cLevel").value,
    description: document.getElementById("cDesc").value,
    duration_hours: parseInt(document.getElementById("cDuration").value) || 0,
    price: parseInt(document.getElementById("cPrice").value) || 0,
    is_published: document.getElementById("cPublished").checked,
  };
  if (id) Object.assign(DB.courses.find(x => x.id === parseInt(id)), data);
  else DB.courses.push({id: nextId(DB.courses), ...data});
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("courseModal")).hide();
  renderCourses(); renderDashboard();
  showToast(id ? "Course diupdate" : "Course ditambahkan");
}
function deleteCourse(id) {
  if (!confirm("Hapus course ini?")) return;
  DB.courses = DB.courses.filter(c => c.id !== id);
  saveDB(DB); logAction("COURSE_DELETE", `Course #${id}`);
  renderCourses(); renderDashboard();
  showToast("Course dihapus");
}

/* ============ LABS ============ */
let flagLabId = null;
function renderLabs() {
  const q = (document.getElementById("labSearch")?.value || "").toLowerCase();
  const cf = document.getElementById("labCatFilter")?.value || "";
  const df = document.getElementById("labDiffFilter")?.value || "";
  const filtered = DB.labs.filter(l =>
    (!q || l.title.toLowerCase().includes(q)) &&
    (!cf || l.category === cf) &&
    (!df || l.difficulty === df)
  );
  document.getElementById("labsGrid").innerHTML = filtered.map(l => `
    <div class="col-md-6 col-lg-4">
      <div class="lab-card p-3">
        <div class="d-flex justify-content-between mb-2">
          <span class="badge diff-${l.difficulty}">${l.difficulty}</span>
          <span class="badge bg-dark border border-secondary"><i class="bi bi-star-fill text-warning"></i> ${l.points}</span>
        </div>
        <h6 class="mb-1"><i class="bi bi-terminal text-info"></i> ${l.title}</h6>
        <p class="small text-muted mb-2">${(l.description||"").substring(0,70)}</p>
        <div class="d-flex justify-content-between mb-2 small">
          <span class="badge bg-secondary">${l.category}</span>
          <span class="text-muted"><i class="bi bi-clock"></i> ${l.time_limit_min} min</span>
        </div>
        <div class="d-flex gap-1">
          <button class="btn btn-sm btn-outline-success flex-fill" onclick="openFlagModal(${l.id})"><i class="bi bi-flag"></i> Flag</button>
          <button class="btn btn-sm btn-outline-dark border-secondary" onclick="openTerminal(${l.id})" title="Terminal"><i class="bi bi-terminal text-success"></i></button>
          <button class="btn btn-sm btn-outline-info" onclick="openLabModal(${l.id})"><i class="bi bi-pencil"></i></button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteLab(${l.id})"><i class="bi bi-trash"></i></button>
        </div>
      </div>
    </div>
  `).join("");
}
function openLabModal(id) {
  const m = new bootstrap.Modal(document.getElementById("labModal"));
  if (id) {
    const l = DB.labs.find(x => x.id === id);
    document.getElementById("labModalTitle").textContent = "Edit Lab";
    document.getElementById("labId").value = l.id;
    document.getElementById("lTitle").value = l.title;
    document.getElementById("lCat").value = l.category;
    document.getElementById("lDesc").value = l.description || "";
    document.getElementById("lDiff").value = l.difficulty;
    document.getElementById("lPoints").value = l.points;
    document.getElementById("lTime").value = l.time_limit_min;
    document.getElementById("lFlag").value = l.flag || "";
  } else {
    document.getElementById("labModalTitle").textContent = "Tambah Lab";
    document.getElementById("labId").value = "";
    document.getElementById("lTitle").value = "";
    document.getElementById("lCat").value = "web";
    document.getElementById("lDesc").value = "";
    document.getElementById("lDiff").value = "easy";
    document.getElementById("lPoints").value = 100;
    document.getElementById("lTime").value = 60;
    document.getElementById("lFlag").value = "";
  }
  m.show();
}
function saveLab() {
  const id = document.getElementById("labId").value;
  const data = {
    title: document.getElementById("lTitle").value,
    category: document.getElementById("lCat").value,
    description: document.getElementById("lDesc").value,
    difficulty: document.getElementById("lDiff").value,
    points: parseInt(document.getElementById("lPoints").value) || 100,
    time_limit_min: parseInt(document.getElementById("lTime").value) || 60,
    flag: document.getElementById("lFlag").value,
  };
  if (id) Object.assign(DB.labs.find(x => x.id === parseInt(id)), data);
  else DB.labs.push({id: nextId(DB.labs), ...data});
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("labModal")).hide();
  renderLabs(); renderDashboard();
  showToast(id ? "Lab diupdate" : "Lab ditambahkan");
}
function deleteLab(id) {
  if (!confirm("Hapus lab ini?")) return;
  DB.labs = DB.labs.filter(l => l.id !== id);
  saveDB(DB); renderLabs(); renderDashboard();
  showToast("Lab dihapus");
}
function openFlagModal(id) {
  flagLabId = id;
  const l = DB.labs.find(x => x.id === id);
  document.getElementById("flagLabName").textContent = l.title;
  document.getElementById("flagInput").value = "";
  document.getElementById("flagResult").innerHTML = "";
  new bootstrap.Modal(document.getElementById("flagModal")).show();
}
function submitFlag() {
  const l = DB.labs.find(x => x.id === flagLabId);
  const input = document.getElementById("flagInput").value.trim();
  const out = document.getElementById("flagResult");
  if (input === l.flag) {
    out.innerHTML = `<span class="text-success"><i class="bi bi-check-circle"></i> Flag benar! +${l.points}</span>`;
    const ex = DB.progress.find(p => p.user_id === currentUser.id && p.item_type === "lab" && p.item_id === l.id);
    if (!ex) {
      DB.progress.push({user_id: currentUser.id, item_type:"lab", item_id:l.id, points:l.points});
      saveDB(DB); renderLeaderboard(); renderProgress(); renderDashboard(); renderCertificates();
      pushNotif(`Flag benar! Lab "${l.title}" selesai. +${l.points} poin`, "success");
      logActivity("lab");
      checkAndAwardBadges();
    }
  } else {
    out.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle"></i> Flag salah</span>`;
  }
}

/* ============ QUIZZES ============ */
function renderQuizzes() {
  document.getElementById("quizzesGrid").innerHTML = DB.quizzes.map(q => `
    <div class="col-md-6 col-lg-4">
      <div class="quiz-card p-3">
        <div class="d-flex justify-content-between mb-2">
          <span class="badge diff-${q.difficulty}">${q.difficulty}</span>
          <small class="text-muted"><i class="bi bi-clock"></i> ${q.time_limit_min} min</small>
        </div>
        <h6 class="mb-1"><i class="bi bi-question-circle text-warning"></i> ${q.title}</h6>
        <p class="small text-muted mb-2">${q.questions} pertanyaan • pass ${q.pass_score}%</p>
        <div class="d-flex gap-1">
          <button class="btn btn-sm btn-outline-success flex-fill" onclick="startQuiz(${q.id})"><i class="bi bi-play-fill"></i> Mulai</button>
          <button class="btn btn-sm btn-outline-info" onclick="openQuizModal(${q.id})"><i class="bi bi-pencil"></i></button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteQuiz(${q.id})"><i class="bi bi-trash"></i></button>
        </div>
      </div>
    </div>
  `).join("");
}
function openQuizModal(id) {
  const m = new bootstrap.Modal(document.getElementById("quizModal"));
  if (id) {
    const q = DB.quizzes.find(x => x.id === id);
    document.getElementById("quizModalTitle").textContent = "Edit Quiz";
    document.getElementById("quizId").value = q.id;
    document.getElementById("qTitle").value = q.title;
    document.getElementById("qDiff").value = q.difficulty;
    document.getElementById("qTime").value = q.time_limit_min;
    document.getElementById("qPass").value = q.pass_score;
  } else {
    document.getElementById("quizModalTitle").textContent = "Tambah Quiz";
    document.getElementById("quizId").value = "";
    document.getElementById("qTitle").value = "";
    document.getElementById("qDiff").value = "easy";
    document.getElementById("qTime").value = 15;
    document.getElementById("qPass").value = 70;
  }
  m.show();
}
function saveQuiz() {
  const id = document.getElementById("quizId").value;
  const data = {
    title: document.getElementById("qTitle").value,
    difficulty: document.getElementById("qDiff").value,
    time_limit_min: parseInt(document.getElementById("qTime").value) || 15,
    pass_score: parseInt(document.getElementById("qPass").value) || 70,
    questions: 2,
  };
  if (id) Object.assign(DB.quizzes.find(x => x.id === parseInt(id)), data);
  else DB.quizzes.push({id: nextId(DB.quizzes), ...data});
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("quizModal")).hide();
  renderQuizzes(); renderDashboard();
  showToast(id ? "Quiz diupdate" : "Quiz ditambahkan");
}
function deleteQuiz(id) {
  if (!confirm("Hapus quiz ini?")) return;
  DB.quizzes = DB.quizzes.filter(q => q.id !== id);
  saveDB(DB); renderQuizzes(); renderDashboard();
  showToast("Quiz dihapus");
}

/* ============ TOOLS ============ */
function renderTools() {
  const q = (document.getElementById("toolSearch")?.value || "").toLowerCase();
  const cf = document.getElementById("toolCatFilter")?.value || "";
  const filtered = DB.tools.filter(t =>
    (!q || t.name.toLowerCase().includes(q) || (t.description||"").toLowerCase().includes(q)) &&
    (!cf || t.category === cf)
  );
  document.getElementById("toolsGrid").innerHTML = filtered.map(t => `
    <div class="col-md-6 col-lg-3">
      <div class="tool-card p-3">
        <h6 class="mb-1"><i class="bi bi-terminal-fill text-info"></i> ${t.name}</h6>
        <small class="text-muted">${t.category} • ${t.platform}</small>
        <p class="small text-muted mb-2 mt-2">${t.description}</p>
        ${t.install_cmd ? `<code class="cmd">$ ${t.install_cmd}</code>` : ""}
        <div class="d-flex gap-1 mt-2">
          <button class="btn btn-sm btn-outline-info flex-fill" onclick="openToolModal(${t.id})"><i class="bi bi-pencil"></i></button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteTool(${t.id})"><i class="bi bi-trash"></i></button>
        </div>
      </div>
    </div>
  `).join("");
}
function openToolModal(id) {
  const m = new bootstrap.Modal(document.getElementById("toolModal"));
  if (id) {
    const t = DB.tools.find(x => x.id === id);
    document.getElementById("toolModalTitle").textContent = "Edit Tool";
    document.getElementById("toolId").value = t.id;
    document.getElementById("tName").value = t.name;
    document.getElementById("tCat").value = t.category;
    document.getElementById("tPlat").value = t.platform;
    document.getElementById("tDesc").value = t.description;
    document.getElementById("tInstall").value = t.install_cmd || "";
  } else {
    document.getElementById("toolModalTitle").textContent = "Tambah Tool";
    document.getElementById("toolId").value = "";
    document.getElementById("tName").value = "";
    document.getElementById("tCat").value = "recon";
    document.getElementById("tPlat").value = "linux";
    document.getElementById("tDesc").value = "";
    document.getElementById("tInstall").value = "";
  }
  m.show();
}
function saveTool() {
  const id = document.getElementById("toolId").value;
  const data = {
    name: document.getElementById("tName").value,
    category: document.getElementById("tCat").value,
    platform: document.getElementById("tPlat").value,
    description: document.getElementById("tDesc").value,
    install_cmd: document.getElementById("tInstall").value,
  };
  if (id) Object.assign(DB.tools.find(x => x.id === parseInt(id)), data);
  else DB.tools.push({id: nextId(DB.tools), ...data});
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("toolModal")).hide();
  renderTools(); renderDashboard();
  showToast(id ? "Tool diupdate" : "Tool ditambahkan");
}
function deleteTool(id) {
  if (!confirm("Hapus tool ini?")) return;
  DB.tools = DB.tools.filter(t => t.id !== id);
  saveDB(DB); renderTools(); renderDashboard();
