          <div>Longest Streak</div>
          <small style="opacity:.9">hari</small>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card p-3 text-center">
          <div class="stat-value text-info" id="hmTotal">0</div>
          <div class="text-muted small">Total Aktivitas</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card p-3 text-center">
          <div class="stat-value text-success" id="hmActiveDays">0</div>
          <div class="text-muted small">Hari Aktif</div>
        </div>
      </div>
    </div>

    <div class="card p-3 mb-3">
      <h6 class="mb-3"><i class="bi bi-grid-3x3-gap"></i> Aktivitas 365 Hari Terakhir</h6>
      <div class="heatmap" id="heatmapGrid"></div>
      <div class="heatmap-legend">
        <span>Less</span>
        <div class="heatmap-cell"></div>
        <div class="heatmap-cell l1"></div>
        <div class="heatmap-cell l2"></div>
        <div class="heatmap-cell l3"></div>
        <div class="heatmap-cell l4"></div>
        <span>More</span>
      </div>
    </div>
  </div>

  <!-- PROFILE -->
  <div id="page-profile" class="page">
    <h3 class="mb-3"><i class="bi bi-person-circle"></i> Profile</h3>
    <div class="row g-3">
      <div class="col-md-6">
        <div class="card p-3">
          <h6><i class="bi bi-person-badge"></i> Info Akun</h6>
          <div class="mb-3"><label class="form-label">Nama Lengkap</label>
            <input class="form-control" id="profName"></div>
          <div class="mb-3"><label class="form-label">Email</label>
            <input class="form-control" id="profEmail"></div>
          <div class="mb-3"><label class="form-label">Role</label>
            <input class="form-control" id="profRole" disabled></div>
          <button class="btn btn-primary" onclick="saveProfile()"><i class="bi bi-save"></i> Simpan</button>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3 mb-3">
          <h6><i class="bi bi-key"></i> Ganti Password</h6>
          <div class="mb-3"><label class="form-label">Password Lama</label>
            <input type="password" class="form-control" id="oldPw"></div>
          <div class="mb-3"><label class="form-label">Password Baru</label>
            <input type="password" class="form-control" id="newPw"></div>
          <div class="mb-3"><label class="form-label">Konfirmasi</label>
            <input type="password" class="form-control" id="confirmPw"></div>
          <button class="btn btn-warning" onclick="changePassword()"><i class="bi bi-shield-lock"></i> Ganti Password</button>
        </div>
        <div class="card p-3 mb-3">
          <h6><i class="bi bi-share"></i> Kode Referral</h6>
          <p class="small text-muted">Bagikan kode ini ke teman. Kamu dapat 50 poin setiap teman mendaftar.</p>
          <div class="referral-code" onclick="copyReferral()" title="Klik untuk copy">
            <span id="refCode">—</span>
          </div>
          <div class="d-flex gap-2 mt-2">
            <button class="btn btn-sm btn-outline-info flex-fill" onclick="copyReferral()">
              <i class="bi bi-clipboard"></i> Copy
            </button>
            <button class="btn btn-sm btn-outline-success flex-fill" onclick="simulateReferral()">
              <i class="bi bi-person-plus"></i> Test Referral
            </button>
          </div>
          <div class="small text-muted mt-2">
            Total referral: <strong id="refCount">0</strong> • Poin dari referral: <strong id="refPoints">0</strong>
          </div>
        </div>

        <div class="card p-3 mb-3">
          <h6><i class="bi bi-bell"></i> Notifikasi Browser</h6>
          <p class="small text-muted">Aktifkan notifikasi sistem untuk update real-time.</p>
          <button class="btn btn-outline-primary w-100" id="notifPermBtn" onclick="requestNotifPermission()">
            <i class="bi bi-bell-fill"></i> Aktifkan Notifikasi
          </button>
        </div>

        <div class="card p-3">
          <div class="card p-3 mb-3">
          <h6><i class="bi bi-clock-history"></i> Login History</h6>
          <div id="loginHistoryList" class="small"></div>
        </div>

        <div class="card p-3">
          <h6><i class="bi bi-exclamation-triangle text-warning"></i> Danger Zone</h6>
          <p class="small text-muted">Reset semua data demo (user, course, lab, dll) ke default.</p>
          <button class="btn btn-outline-danger" onclick="resetDemo()"><i class="bi bi-arrow-counterclockwise"></i> Reset Demo</button>
          <hr class="border-secondary">
          <h6><i class="bi bi-download"></i> Backup Data</h6>
          <div class="d-grid gap-2">
            <button class="btn btn-outline-success" onclick="exportJSON()">
              <i class="bi bi-download"></i> Export JSON</button>
            <button class="btn btn-outline-warning" onclick="exportStandalone()">
              <i class="bi bi-file-code"></i> Export Standalone HTML</button>
            <button class="btn btn-outline-danger" onclick="exportFullBackup()">
              <i class="bi bi-archive"></i> Full Backup (JSON)</button>
            <label class="btn btn-outline-info mb-0">
              <i class="bi bi-upload"></i> Import JSON
              <input type="file" accept=".json" onchange="importJSON(event)" hidden>
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PROGRESS -->
  <div id="page-progress" class="page">
    <h3 class="mb-3"><i class="bi bi-graph-up"></i> My Progress</h3>
    <div class="row g-3 mb-4">
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <i class="bi bi-star-fill stat-icon text-warning"></i>
        <div class="stat-value" id="profTotalPoints">0</div>
        <div class="text-muted small">Total Poin</div></div></div>
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <i class="bi bi-terminal-fill stat-icon text-danger"></i>
        <div class="stat-value" id="profLabsDone">0</div>
        <div class="text-muted small">Labs Selesai</div></div></div>
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <i class="bi bi-question-circle-fill stat-icon text-success"></i>
        <div class="stat-value" id="profQuizDone">0</div>
        <div class="text-muted small">Quiz Selesai</div></div></div>
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <i class="bi bi-trophy-fill stat-icon text-info"></i>
        <div class="stat-value" id="profRank">-</div>
        <div class="text-muted small">Peringkat</div></div></div>
    </div>

    <div class="card mb-3">
      <div class="card-header bg-transparent border-secondary">
        <h6 class="mb-0"><i class="bi bi-terminal"></i> Labs yang Diselesaikan</h6>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead><tr><th>Lab</th><th>Kategori</th><th>Difficulty</th><th class="text-end">Poin</th></tr></thead>
          <tbody id="progressLabsTable"></tbody>
        </table>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header bg-transparent border-secondary">
        <h6 class="mb-0"><i class="bi bi-question-circle"></i> Quiz yang Diselesaikan</h6>
      </div>
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead><tr><th>Quiz</th><th>Difficulty</th><th class="text-end">Poin</th></tr></thead>
          <tbody id="progressQuizTable"></tbody>
        </table>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <div class="card p-3">
          <h6 class="mb-2"><i class="bi bi-pie-chart"></i> Distribusi Poin per Kategori Lab</h6>
          <div class="chart-container"><canvas id="chartCategory"></canvas></div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3">
          <h6 class="mb-2"><i class="bi bi-bar-chart"></i> Poin per Difficulty</h6>
          <div class="chart-container"><canvas id="chartDiff"></canvas></div>
        </div>
      </div>
    </div>
  </div>

  </div>

</div>
</div>

<!-- ============== MODALS ============== -->
<!-- User Modal -->
<div class="modal fade" id="userModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="userModalTitle">User</h5>
    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="userId">
    <div class="mb-3"><label class="form-label">Nama</label><input class="form-control" id="uName"></div>
    <div class="mb-3"><label class="form-label">Email</label><input class="form-control" id="uEmail"></div>
    <div class="mb-3"><label class="form-label">Role</label>
      <select class="form-select" id="uRole"><option>student</option><option>instructor</option><option>admin</option></select></div>
    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="uActive" checked>
      <label class="form-check-label">Aktif</label></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
    <button class="btn btn-primary" onclick="saveUser()">Simpan</button></div>
</div></div></div>

<!-- Course Modal -->
<div class="modal fade" id="courseModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="courseModalTitle">Course</h5>
    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="courseId">
    <div class="row g-3">
      <div class="col-md-8"><label class="form-label">Judul</label><input class="form-control" id="cTitle"></div>
      <div class="col-md-4"><label class="form-label">Level</label>
        <select class="form-select" id="cLevel"><option>beginner</option><option>intermediate</option><option>advanced</option></select></div>
      <div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" id="cDesc" rows="2"></textarea></div>
      <div class="col-md-6"><label class="form-label">Durasi (jam)</label><input type="number" class="form-control" id="cDuration" value="10"></div>
      <div class="col-md-6"><label class="form-label">Harga (Rp)</label><input type="number" class="form-control" id="cPrice" value="0"></div>
      <div class="col-12"><div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="cPublished" checked><label class="form-check-label">Published</label></div></div>
    </div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
    <button class="btn btn-primary" onclick="saveCourse()">Simpan</button></div>
</div></div></div>

<!-- Lab Modal -->
<div class="modal fade" id="labModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="labModalTitle">Lab</h5>
    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="labId">
    <div class="row g-3">
      <div class="col-md-8"><label class="form-label">Judul</label><input class="form-control" id="lTitle"></div>
      <div class="col-md-4"><label class="form-label">Kategori</label>
        <select class="form-select" id="lCat"><option>web</option><option>network</option><option>forensics</option><option>crypto</option><option>osint</option><option>reveng</option></select></div>
      <div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" id="lDesc" rows="2"></textarea></div>
      <div class="col-md-4"><label class="form-label">Difficulty</label>
        <select class="form-select" id="lDiff"><option>easy</option><option>medium</option><option>hard</option><option>insane</option></select></div>
      <div class="col-md-4"><label class="form-label">Points</label><input type="number" class="form-control" id="lPoints" value="100"></div>
      <div class="col-md-4"><label class="form-label">Time (menit)</label><input type="number" class="form-control" id="lTime" value="60"></div>
      <div class="col-12"><label class="form-label">Flag</label><input class="form-control" id="lFlag" placeholder="CTF{...}"></div>
    </div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
    <button class="btn btn-primary" onclick="saveLab()">Simpan</button></div>
</div></div></div>

<!-- Quiz Modal -->
<div class="modal fade" id="quizModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="quizModalTitle">Quiz</h5>
    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="quizId">
    <div class="mb-3"><label class="form-label">Judul</label><input class="form-control" id="qTitle"></div>
    <div class="mb-3"><label class="form-label">Difficulty</label>
      <select class="form-select" id="qDiff"><option>easy</option><option>medium</option><option>hard</option></select></div>
    <div class="mb-3"><label class="form-label">Time (menit)</label><input type="number" class="form-control" id="qTime" value="15"></div>
    <div class="mb-3"><label class="form-label">Pass Score</label><input type="number" class="form-control" id="qPass" value="70"></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
    <button class="btn btn-primary" onclick="saveQuiz()">Simpan</button></div>
</div></div></div>

<!-- Tool Modal -->
<div class="modal fade" id="toolModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="toolModalTitle">Tool</h5>
    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="toolId">
    <div class="mb-3"><label class="form-label">Nama</label><input class="form-control" id="tName"></div>
    <div class="mb-3"><label class="form-label">Kategori</label>
      <select class="form-select" id="tCat"><option>recon</option><option>exploitation</option><option>forensics</option><option>crypto</option><option>web</option><option>network</option><option>osint</option></select></div>
    <div class="mb-3"><label class="form-label">Platform</label>
      <select class="form-select" id="tPlat"><option>linux</option><option>windows</option><option>mac</option><option>web</option></select></div>
    <div class="mb-3"><label class="form-label">Deskripsi</label><textarea class="form-control" id="tDesc" rows="2"></textarea></div>
    <div class="mb-3"><label class="form-label">Install</label><input class="form-control" id="tInstall"></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
    <button class="btn btn-primary" onclick="saveTool()">Simpan</button></div>
</div></div></div>

<!-- Event Modal -->
<div class="modal fade" id="eventModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="eventModalTitle">Event</h5>
    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="eventId">
    <div class="mb-3"><label class="form-label">Judul</label><input class="form-control" id="eTitle"></div>
    <div class="mb-3"><label class="form-label">Tipe</label>
      <select class="form-select" id="eType"><option>ctf</option><option>workshop</option><option>webinar</option><option>bootcamp</option></select></div>
    <div class="mb-3"><label class="form-label">Lokasi</label><input class="form-control" id="eLocation" value="Online"></div>
    <div class="mb-3"><label class="form-label">Tanggal Mulai</label><input type="date" class="form-control" id="eDate"></div>
    <div class="mb-3"><label class="form-label">Deskripsi</label><textarea class="form-control" id="eDesc" rows="2"></textarea></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
    <button class="btn btn-primary" onclick="saveEvent()">Simpan</button></div>
</div></div></div>

<!-- Flag Submit Modal -->
<div class="modal fade" id="flagModal" tabindex="-1"><div class="modal-dialog modal-sm"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">Submit Flag</h5>
    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <p class="small text-muted mb-2">Lab: <strong id="flagLabName"></strong></p>
    <input type="text" class="form-control" id="flagInput" placeholder="CTF{...}">
    <div id="flagResult" class="mt-2 small"></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
    <button class="btn btn-success" onclick="submitFlag()">Submit</button></div>
</div></div></div>


<!-- Quiz Attempt Modal -->
<div class="modal fade" id="attemptModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="attemptTitle">Quiz</h5>
        <span class="badge bg-danger timer-badge" id="attemptTimer">--:--</span>
      </div>
      <div class="modal-body" id="attemptBody"></div>
      <div class="modal-footer">
        <span class="me-auto small text-muted" id="attemptProgress">Soal 1/1</span>
        <button class="btn btn-secondary" data-bs-dismiss="modal" onclick="cancelAttempt()">Batal</button>
        <button class="btn btn-success" id="nextBtn" onclick="nextQuestion()">
          <i class="bi bi-arrow-right"></i> Lanjut
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Notifications Modal -->
<div class="modal fade" id="notifModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-bell-fill"></i> Notifikasi</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <ul class="list-group list-group-flush" id="notifList"></ul>
      </div>
    </div>
  </div>
</div>

<!-- Terminal Modal -->
<div class="modal fade" id="terminalModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-terminal-fill"></i> <span id="termLabName">Lab</span></h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="terminal" id="termBody" onclick="document.getElementById('termInput').focus()">
          <div class="terminal-line">Welcome to CyberSec Academy Terminal v1.0</div>
          <div class="terminal-line" id="termHint">Hint: coba ketik <b>help</b> untuk daftar perintah.</div>
          <div class="terminal-line">---</div>
        </div>
        <div class="terminal mt-2" style="height:auto; padding:.5rem 1rem;">
          <span style="color:#58a6ff;">$</span>
          <input class="terminal-input" id="termInput" autocomplete="off"
                 onkeydown="if(event.key==='Enter') runCmd()" placeholder="ketik perintah...">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Global Search Modal -->
<div class="modal fade" id="globalSearchModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-search"></i> Global Search</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="text" class="form-control mb-3" id="gsInput"
               placeholder="Cari user, course, lab, quiz, tool, event..."
               oninput="runGlobalSearch()" autofocus>
        <div id="gsResults">
          <p class="text-muted text-center py-3">
            Ketik minimal 2 karakter untuk mencari.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Spawn Container Modal -->
<div class="modal fade" id="spawnModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-box"></i> Spawn Lab Container</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Pilih Lab</label>
          <select class="form-select" id="spawnLabSelect"></select>
        </div>
        <div class="mb-3">
          <label class="form-label">Durasi (menit)</label>
          <input type="number" class="form-control" id="spawnDuration" value="60" min="5" max="480">
        </div>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="spawnNetworkIsolated" checked>
          <label class="form-check-label">Isolasi network</label>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        <button class="btn btn-danger" onclick="spawnContainer()">
          <i class="bi bi-play-fill"></i> Spawn
        </button>
      </div>
    </div>
  </div>
</div>


<!-- Log Stream Modal -->
<div class="modal fade" id="logModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-file-text"></i> Container Logs — <span id="logContainerName"></span></h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="log-stream" id="logStream"></div>
        <div class="form-check form-switch mt-2">
          <input class="form-check-input" type="checkbox" id="logAutoScroll" checked>
          <label class="form-check-label small">Auto-scroll</label>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal" onclick="stopLogStream()">Tutup</button>
        <button class="btn btn-danger" onclick="stopLogStream()">
          <i class="bi bi-stop-fill"></i> Stop Stream
        </button>
      </div>
    </div>
  </div>
</div>


<!-- Log Stream Modal -->
<div class="modal fade" id="logModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-file-text"></i> Container Logs — <span id="logContainerName"></span></h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="log-stream" id="logStream"></div>
        <div class="form-check form-switch mt-2">
          <input class="form-check-input" type="checkbox" id="logAutoScroll" checked>
          <label class="form-check-label small">Auto-scroll</label>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal" onclick="stopLogStream()">Tutup</button>
        <button class="btn btn-danger" onclick="stopLogStream()">
          <i class="bi bi-stop-fill"></i> Stop Stream
        </button>
      </div>
    </div>
  </div>
</div>


<!-- Video Player Modal -->
<div class="modal fade video-player-modal" id="videoModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-play-circle-fill text-info"></i> <span id="videoTitle">—</span></h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="stopVideo()"></button>
      </div>
      <div class="modal-body">
        <div class="video-stage" id="videoStage">
          <div class="play-big" id="videoPlayBtn" onclick="playVideo()">
            <i class="bi bi-play-circle-fill"></i>
          </div>
        </div>
        <div class="progress-video">
          <div id="videoProgress" style="width:0%"></div>
        </div>
        <div class="d-flex justify-content-between small text-muted px-3 py-2">
          <span id="videoTime">00:00 / 00:00</span>
          <span id="videoStatus">Paused</span>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal" onclick="stopVideo()">Tutup</button>
        <button class="btn btn-info" onclick="markCurrentVideoDone()">
          <i class="bi bi-check-circle"></i> Tandai Selesai
        </button>
      </div>
    </div>
  </div>
</div>


<!-- Checkout Modal -->
<div class="modal fade" id="checkoutModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-credit-card-fill"></i> Checkout</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="checkoutCourse" class="mb-3"></div>
        <h6>Metode Pembayaran</h6>
        <div class="d-grid gap-2 mb-3">
          <label class="btn btn-outline-info text-start p-2">
            <input type="radio" name="payMethod" value="transfer" checked> 🏦 Transfer Bank
          </label>
          <label class="btn btn-outline-info text-start p-2">
            <input type="radio" name="payMethod" value="ewallet"> 📱 E-Wallet (OVO/GoPay/Dana)
          </label>
          <label class="btn btn-outline-info text-start p-2">
            <input type="radio" name="payMethod" value="qris"> 📷 QRIS
          </label>
          <label class="btn btn-outline-info text-start p-2">
            <input type="radio" name="payMethod" value="va"> 💳 Virtual Account
          </label>
        </div>
        <div class="mb-3">
          <label class="form-label">Kode Promo (opsional)</label>
          <input type="text" class="form-control" id="promoCode" placeholder="CYBER20">
          <div id="promoResult" class="small mt-1"></div>
        </div>
        <div class="card p-3">
          <div class="d-flex justify-content-between"><span>Subtotal:</span><span id="coSubtotal">Rp 0</span></div>
          <div class="d-flex justify-content-between text-success"><span>Diskon:</span><span id="coDiscount">-Rp 0</span></div>
          <div class="d-flex justify-content-between"><span>PPN 11%:</span><span id="coTax">Rp 0</span></div>
          <hr class="my-2">
          <div class="d-flex justify-content-between fw-bold fs-5"><span>Total:</span><span id="coTotal" class="text-warning">Rp 0</span></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        <button class="btn btn-success" onclick="processPayment()">
          <i class="bi bi-check-circle-fill"></i> Bayar Sekarang
        </button>
      </div>
    </div>
  </div>
</div>


<!-- Payment Status Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-credit-card"></i> Memproses Pembayaran</h5>
      </div>
      <div class="modal-body">
        <div class="payment-status" id="payPending">
          <div class="spinner-border spinner-border-sm text-warning"></div>
          <div>
            <div class="fw-bold">Menunggu konfirmasi...</div>
            <small class="text-muted" id="payStatusText">Memverifikasi dengan payment gateway</small>
          </div>
        </div>
        <div class="text-center small text-muted">
          <div>Invoice: <code id="payInvoice">—</code></div>
          <div>Total: <strong id="payTotal">—</strong></div>
          <div class="mt-2">Jangan tutup window ini</div>
        </div>
        <div class="progress mt-3" style="height:6px;">
          <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
               id="payProgress" style="width:0%"></div>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Note Modal -->
<div class="modal fade" id="noteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="noteModalTitle">Catatan Baru</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="noteId">
        <div class="mb-3">
          <label class="form-label">Judul</label>
          <input type="text" class="form-control" id="noteTitle" placeholder="Judul catatan">
        </div>
        <div class="mb-3">
          <label class="form-label">Isi</label>
          <textarea class="form-control" id="noteContent" rows="5" placeholder="Isi catatan..."></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label">Warna</label>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm" style="background:#ffc107;width:40px;height:40px;"
                    onclick="selectNoteColor('yellow')" data-color="yellow"></button>
            <button type="button" class="btn btn-sm" style="background:#0d6efd;width:40px;height:40px;"
                    onclick="selectNoteColor('blue')" data-color="blue"></button>
            <button type="button" class="btn btn-sm" style="background:#198754;width:40px;height:40px;"
                    onclick="selectNoteColor('green')" data-color="green"></button>
            <button type="button" class="btn btn-sm" style="background:#dc3545;width:40px;height:40px;"
                    onclick="selectNoteColor('red')" data-color="red"></button>
            <button type="button" class="btn btn-sm" style="background:#6f42c1;width:40px;height:40px;"
                    onclick="selectNoteColor('purple')" data-color="purple"></button>
          </div>
          <input type="hidden" id="noteColor" value="yellow">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        <button class="btn btn-primary" onclick="saveNote()">
          <i class="bi bi-save"></i> Simpan
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="toast" class="toast align-items-center text-bg-success border-0">
    <div class="d-flex"><div class="toast-body" id="toastMsg">OK</div>
      <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
  </div>
</div>

