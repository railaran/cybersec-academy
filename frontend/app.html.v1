function loadDB() {
  const raw = localStorage.getItem(DB_KEY);
  if (!raw) { const d = defaultDB(); localStorage.setItem(DB_KEY, JSON.stringify(d)); return d; }
  try { return JSON.parse(raw); } catch { const d = defaultDB(); localStorage.setItem(DB_KEY, JSON.stringify(d)); return d; }
}
function saveDB(db) { localStorage.setItem(DB_KEY, JSON.stringify(db)); }
function nextId(arr) { return arr.length ? Math.max(...arr.map(x=>x.id)) + 1 : 1; }

/* ============ AUTH ============ */
function loginAs(u) {
  currentUser = u;
  document.getElementById("loginView").style.display = "none";
  document.getElementById("mainApp").style.display = "block";
  logActivity();
  pushNotif(`Selamat datang, ${u.full_name}!`, "success");
  refreshAll();
  showToast(`Selamat datang, ${u.full_name}!`);
}

function logout() {
  currentUser = null;
  document.getElementById("loginView").style.display = "flex";
  document.getElementById("mainApp").style.display = "none";
  document.getElementById("loginPassword").value = "";
}

function loginWithGoogle() {
  const accounts = [
    { name: "Demo Cyber", email: "demo.cybersec@gmail.com" },
    { name: "Budi Santoso", email: "budi.santoso@gmail.com" },
  ];
  const pick = accounts[Math.floor(Math.random() * accounts.length)];
  let u = DB.users.find(x => x.email === pick.email);
  if (!u) {
    u = { id: nextId(DB.users), full_name: pick.name, email: pick.email, password: "(google)", role: "student", is_active: true };
    DB.users.push(u); saveDB(DB);
  }
  loginAs(u);
}

/* ============ INIT ============ */
document.addEventListener("DOMContentLoaded", () => {
  DB = loadDB();
  toast = new bootstrap.Toast(document.getElementById("toast"));

  // Theme
  const theme = localStorage.getItem("cybersec_theme") || "dark";
  document.documentElement.setAttribute("data-theme", theme);

  // Tabs
  document.getElementById("tabLogin").addEventListener("click", e => {
    e.preventDefault();
    document.getElementById("tabLogin").classList.add("active");
    document.getElementById("tabRegister").classList.remove("active");
    document.getElementById("nameField").style.display = "none";
  });
  document.getElementById("tabRegister").addEventListener("click", e => {
    e.preventDefault();
    document.getElementById("tabRegister").classList.add("active");
    document.getElementById("tabLogin").classList.remove("active");
    document.getElementById("nameField").style.display = "block";
  });

  // Login form
  document.getElementById("loginForm").addEventListener("submit", e => {
    e.preventDefault();
    const email = document.getElementById("loginEmail").value.trim();
    const password = document.getElementById("loginPassword").value;
    const isRegister = document.getElementById("tabRegister").classList.contains("active");
    const err = document.getElementById("loginError");
    err.classList.add("d-none");

    if (isRegister) {
      const name = document.getElementById("regName").value.trim();
      if (!name) { err.textContent = "Nama wajib diisi"; err.classList.remove("d-none"); return; }
      if (DB.users.find(u => u.email === email)) { err.textContent = "Email sudah terdaftar"; err.classList.remove("d-none"); return; }
      const u = { id: nextId(DB.users), full_name: name, email, password, role: "student", is_active: true };
      DB.users.push(u); saveDB(DB);
      loginAs(u);
    } else {
      const u = DB.users.find(x => x.email === email && x.password === password);
      if (!u) { err.textContent = "Email atau password salah"; err.classList.remove("d-none"); return; }
      loginAs(u);
    }
  });
});

/* ============ NAV ============ */
function showPage(name) {
  document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
  document.getElementById("page-" + name).classList.add("active");
  if (name === "chat") renderChat();
  if (name === "notes") renderNotes();
  if (name === "pomodoro") renderPomodoro();
  if (name === "heatmap") renderHeatmap();
  if (name === "badges") renderBadges();
  window.scrollTo(0, 0);
}

/* ============ REFRESH ============ */
function refreshAll() {
  renderDashboard();
  renderUsers();
  renderCourses();
  renderLabs();
  renderQuizzes();
  renderTools();
  renderEvents();
  renderLeaderboard();
  renderBadges();
  renderChat();
  renderNotes();
  renderPomodoro();
  renderHeatmap();
}

/* ============ DASHBOARD ============ */
function renderDashboard() {
  document.getElementById("statUsers").textContent = DB.users.length;
  document.getElementById("statCourses").textContent = DB.courses.length;
  document.getElementById("statLabs").textContent = DB.labs.length;
  document.getElementById("statQuizzes").textContent = DB.quizzes.length;
  document.getElementById("statTools").textContent = DB.tools.length;
  document.getElementById("statEvents").textContent = DB.events.length;
  document.getElementById("recentCourses").innerHTML = DB.courses.slice(-5).reverse().map(c => `<li><i class="bi bi-dot"></i> ${c.title}</li>`).join("");
  document.getElementById("recentLabs").innerHTML = DB.labs.slice(-5).reverse().map(l => `<li><i class="bi bi-dot"></i> ${l.title}</li>`).join("");
}

/* ============ USERS ============ */
function renderUsers() {
  document.getElementById("usersTable").innerHTML = DB.users.map((u, i) => `
    <tr>
      <td>${i+1}</td>
      <td><i class="bi bi-person-circle"></i> ${u.full_name}</td>
      <td>${u.email}</td>
      <td><span class="badge badge-${u.role}">${u.role}</span></td>
      <td><span class="badge badge-${u.is_active ? 'active' : 'inactive'}">${u.is_active ? 'Aktif' : 'Nonaktif'}</span></td>
      <td>
        <button class="btn btn-sm btn-outline-info" onclick="openUserModal(${u.id})"><i class="bi bi-pencil"></i></button>
        <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(${u.id})"><i class="bi bi-trash"></i></button>
      </td>
    </tr>`).join("");
}
function openUserModal(id) {
  const m = new bootstrap.Modal(document.getElementById("userModal"));
  if (id) {
    const u = DB.users.find(x => x.id === id);
    document.getElementById("userModalTitle").textContent = "Edit User";
    document.getElementById("userId").value = u.id;
    document.getElementById("uName").value = u.full_name;
    document.getElementById("uEmail").value = u.email;
    document.getElementById("uRole").value = u.role;
    document.getElementById("uActive").checked = u.is_active;
  } else {
    document.getElementById("userModalTitle").textContent = "Tambah User";
    document.getElementById("userId").value = "";
    document.getElementById("uName").value = "";
    document.getElementById("uEmail").value = "";
    document.getElementById("uRole").value = "student";
    document.getElementById("uActive").checked = true;
  }
  m.show();
}
function saveUser() {
  const id = document.getElementById("userId").value;
  const data = {
    full_name: document.getElementById("uName").value,
    email: document.getElementById("uEmail").value,
    role: document.getElementById("uRole").value,
    is_active: document.getElementById("uActive").checked,
  };
  if (id) Object.assign(DB.users.find(x => x.id === parseInt(id)), data);
  else DB.users.push({ id: nextId(DB.users), password: "changeme", ...data });
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("userModal")).hide();
  renderUsers(); renderDashboard();
  showToast(id ? "User diupdate" : "User ditambahkan");
}
function deleteUser(id) {
  if (!confirm("Hapus user ini?")) return;
  DB.users = DB.users.filter(u => u.id !== id);
  saveDB(DB); renderUsers(); renderDashboard();
  showToast("User dihapus");
}

/* ============ COURSES ============ */
function renderCourses() {
  document.getElementById("coursesGrid").innerHTML = DB.courses.map(c => `
    <div class="col-md-6 col-lg-4">
      <div class="course-card p-3">
        <div class="d-flex justify-content-between mb-2">
          <span class="badge bg-secondary">${c.level}</span>
          <small class="text-muted">${c.duration_hours} jam</small>
        </div>
        <h6 class="mb-1">${c.title}</h6>
        <p class="small text-muted mb-2">${(c.description||"").substring(0,80)}...</p>
        <div class="d-flex justify-content-between">
          <span class="badge ${c.is_published ? 'bg-success' : 'bg-secondary'}">${c.is_published ? 'Published' : 'Draft'}</span>
          <span class="text-warning fw-bold">${c.price ? "Rp " + c.price.toLocaleString("id-ID") : "Gratis"}</span>
        </div>
      </div>
    </div>`).join("");
}

/* ============ LABS ============ */
let flagLabId = null;
function renderLabs() {
  document.getElementById("labsGrid").innerHTML = DB.labs.map(l => `
    <div class="col-md-6 col-lg-4">
      <div class="lab-card p-3">
        <div class="d-flex justify-content-between mb-2">
          <span class="badge diff-${l.difficulty}">${l.difficulty}</span>
          <span class="badge bg-dark border border-secondary"><i class="bi bi-star-fill text-warning"></i> ${l.points}</span>
        </div>
        <h6 class="mb-1"><i class="bi bi-terminal text-info"></i> ${l.title}</h6>
        <p class="small text-muted mb-2">${(l.description||"").substring(0,70)}</p>
        <div class="d-flex justify-content-between mb-2 small">
          <span class="badge bg-secondary">${l.category}</span>
          <span class="text-muted"><i class="bi bi-clock"></i> ${l.time_limit_min} min</span>
        </div>
        <button class="btn btn-sm btn-outline-success w-100" onclick="openFlagModal(${l.id})"><i class="bi bi-flag"></i> Submit Flag</button>
      </div>
    </div>`).join("");
}
function openFlagModal(id) {
  flagLabId = id;
  const l = DB.labs.find(x => x.id === id);
  document.getElementById("flagLabName").textContent = l.title;
  document.getElementById("flagInput").value = "";
  document.getElementById("flagResult").innerHTML = "";
  new bootstrap.Modal(document.getElementById("flagModal")).show();
}
function submitFlag() {
  const l = DB.labs.find(x => x.id === flagLabId);
  const input = document.getElementById("flagInput").value.trim();
  const out = document.getElementById("flagResult");
  if (input === l.flag) {
    out.innerHTML = `<span class="text-success"><i class="bi bi-check-circle"></i> Flag benar! +${l.points}</span>`;
    const ex = DB.progress.find(p => p.user_id === currentUser.id && p.item_type === "lab" && p.item_id === l.id);
    if (!ex) {
      DB.progress.push({ user_id: currentUser.id, item_type: "lab", item_id: l.id, points: l.points });
      saveDB(DB); renderLeaderboard(); checkBadges(); logActivity();
    }
  } else {
    out.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle"></i> Flag salah</span>`;
  }
}

