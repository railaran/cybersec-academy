/* ============ LEADERBOARD ============ */
function renderLeaderboard() {
  const totals = {};
  DB.users.forEach(u => totals[u.id] = { name: u.full_name, points: 0, completed: 0 });
  DB.progress.forEach(p => {
    if (totals[p.user_id]) { totals[p.user_id].points += p.points; totals[p.user_id].completed += 1; }
  });
  const rows = Object.values(totals).sort((a, b) => b.points - a.points);
  document.getElementById("lbTable").innerHTML = rows.map((r, i) => {
    const medal = i === 0 ? "🥇" : i === 1 ? "🥈" : i === 2 ? "🥉" : (i + 1);
    return `<tr class="${i < 3 ? 'rank-' + (i+1) : ''}">
      <td class="fw-bold">${medal}</td>
      <td><i class="bi bi-person-circle"></i> ${r.name}</td>
      <td class="text-end fw-bold text-warning">${r.points.toLocaleString("id-ID")}</td>
      <td class="text-end">${r.completed}</td>
    </tr>`;
  }).join("");
}

/* ============ BADGES ============ */
function checkBadges() {
  if (!currentUser) return;
  DB.user_badges = DB.user_badges || [];
  const earned = new Set(DB.user_badges.filter(b => b.user_id === currentUser.id).map(b => b.badge_id));
  const mine = DB.progress.filter(p => p.user_id === currentUser.id);
  const labCount = mine.filter(p => p.item_type === "lab").length;
  const quizCount = mine.filter(p => p.item_type === "quiz").length;
  const totalPoints = mine.reduce((s, p) => s + p.points, 0);
  const checks = [
    ["first_login", true],
    ["first_lab", labCount >= 1],
    ["lab_master", labCount >= 5],
    ["quiz_rookie", quizCount >= 1],
    ["point_500", totalPoints >= 500],
  ];
  checks.forEach(([id, ok]) => {
    if (ok && !earned.has(id)) {
      DB.user_badges.push({ user_id: currentUser.id, badge_id: id, earned_at: new Date().toISOString() });
      const b = DB.badges.find(x => x.id === id);
      if (b) showToast(`🏆 Badge baru: ${b.name}!`);
    }
  });
  saveDB(DB);
}
function renderBadges() {
  if (!currentUser) return;
  const earned = new Set(DB.user_badges.filter(b => b.user_id === currentUser.id).map(b => b.badge_id));
  document.getElementById("badgesGrid").innerHTML = DB.badges.map(b => {
    const has = earned.has(b.id);
    return `<div class="col-md-4 col-lg-3">
      <div class="stat-card p-3 text-center ${has ? '' : 'opacity-50'}">
        <i class="bi bi-${b.icon} stat-icon text-${has ? 'warning' : 'secondary'}"></i>
        <h6 class="mt-2 mb-1">${b.name}</h6>
        <small class="text-muted d-block">${b.desc}</small>
        ${has ? '<span class="badge bg-warning text-dark mt-2">✓</span>' : '<span class="badge bg-secondary mt-2">Locked</span>'}
      </div>
    </div>`;
  }).join("");
}

/* ============ CHAT ============ */
function renderChat() {
  const box = document.getElementById("chatBox");
  if (!box) return;
  box.innerHTML = (DB.chat || []).map(m => {
    const isMe = m.from_id === currentUser?.id;
    return `<div class="chat-msg ${isMe ? 'me' : ''}">
      <div class="chat-bubble">
        <div class="chat-meta">${isMe ? 'Kamu' : m.from} • ${new Date(m.at).toLocaleTimeString("id-ID")}</div>
        <div>${m.text}</div>
      </div>
    </div>`;
  }).join("");
  box.scrollTop = box.scrollHeight;
}
function sendChat() {
  const inp = document.getElementById("chatInput");
  const text = inp.value.trim();
  if (!text) return;
  DB.chat.push({ id: Date.now(), from: currentUser.full_name, from_id: currentUser.id, text, at: new Date().toISOString() });
  saveDB(DB);
  inp.value = "";
  renderChat();
  // Bot reply
  if (Math.random() > 0.4) {
    const bots = DB.users.filter(u => u.id !== currentUser.id);
    const bot = bots[Math.floor(Math.random() * bots.length)];
    const replies = ["Setuju! 👍", "Menarik!", "Aku coba ya", "Mantap! 🔥", "Nice info!", "Besok ikut CTF?"];
    setTimeout(() => {
      DB.chat.push({ id: Date.now(), from: bot.full_name, from_id: bot.id, text: replies[Math.floor(Math.random() * replies.length)], at: new Date().toISOString() });
      saveDB(DB);
      if (document.getElementById("page-chat").classList.contains("active")) renderChat();
    }, 1200 + Math.random() * 1500);
  }
}

/* ============ NOTES ============ */
const NOTE_COLORS = { yellow:{bg:"#3d3419",border:"#ffc107"}, blue:{bg:"#172a45",border:"#0d6efd"},
  green:{bg:"#17341d",border:"#198754"}, red:{bg:"#3d1a1a",border:"#dc3545"}, purple:{bg:"#2d1f45",border:"#6f42c1"} };
let selectedNoteColor = "yellow";

function renderNotes() {
  const notes = (DB.notes || []).filter(n => n.user_id === currentUser?.id);
  const grid = document.getElementById("notesGrid");
  if (!grid) return;
  if (!notes.length) {
    grid.innerHTML = `<div class="col-12 text-center text-muted py-5"><i class="bi bi-journal-text fs-1 d-block mb-2"></i>Belum ada catatan.</div>`;
    return;
  }
  grid.innerHTML = notes.map(n => {
    const c = NOTE_COLORS[n.color] || NOTE_COLORS.yellow;
    return `<div class="col-md-6 col-lg-4">
      <div class="note-card" style="background:${c.bg};border-left:4px solid ${c.border};">
        <div class="d-flex justify-content-between mb-2">
          <h6 class="mb-0">${n.title}</h6>
          <div>
            <button class="btn btn-sm btn-link text-info p-0 me-2" onclick="openNoteModal(${n.id})"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-sm btn-link text-danger p-0" onclick="deleteNote(${n.id})"><i class="bi bi-trash"></i></button>
          </div>
        </div>
        <p class="small mb-2" style="white-space:pre-wrap;">${n.content}</p>
        <small class="text-muted">${new Date(n.updated_at).toLocaleString("id-ID")}</small>
      </div>
    </div>`;
  }).join("");
}
function openNoteModal(id) {
  const m = new bootstrap.Modal(document.getElementById("noteModal"));
  if (id) {
    const n = DB.notes.find(x => x.id === id);
    document.getElementById("noteModalTitle").textContent = "Edit Catatan";
    document.getElementById("noteId").value = n.id;
    document.getElementById("noteTitle").value = n.title;
    document.getElementById("noteContent").value = n.content;
    document.getElementById("noteColor").value = n.color;
    selectedNoteColor = n.color;
  } else {
    document.getElementById("noteModalTitle").textContent = "Catatan Baru";
    document.getElementById("noteId").value = "";
    document.getElementById("noteTitle").value = "";
    document.getElementById("noteContent").value = "";
    document.getElementById("noteColor").value = "yellow";
    selectedNoteColor = "yellow";
  }
  m.show();
}
function selectNoteColor(c) {
  selectedNoteColor = c;
  document.getElementById("noteColor").value = c;
}
function saveNote() {
  const id = document.getElementById("noteId").value;
  const data = {
    title: document.getElementById("noteTitle").value.trim() || "(tanpa judul)",
    content: document.getElementById("noteContent").value,
    color: document.getElementById("noteColor").value,
  };
  DB.notes = DB.notes || [];
  if (id) Object.assign(DB.notes.find(x => x.id === parseInt(id)), data, { updated_at: new Date().toISOString() });
  else DB.notes.push({ id: Date.now(), user_id: currentUser.id, ...data, created_at: new Date().toISOString(), updated_at: new Date().toISOString() });
  saveDB(DB);
  bootstrap.Modal.getInstance(document.getElementById("noteModal")).hide();
  renderNotes();
  showToast(id ? "Catatan diupdate" : "Catatan ditambahkan");
}
function deleteNote(id) {
  if (!confirm("Hapus catatan ini?")) return;
  DB.notes = DB.notes.filter(n => n.id !== id);
  saveDB(DB); renderNotes();
  showToast("Catatan dihapus");
}

/* ============ POMODORO ============ */
let pomodoroState = { running: false, mode: "focus", seconds: 25*60, totalSeconds: 25*60, timer: null };
function renderPomodoro() {
  updatePomodoroDisplay();
  const hist = (DB.pomodoroHistory || []).filter(h => h.user_id === currentUser?.id).slice(-5).reverse();
  const el = document.getElementById("pomodoroHistory");
  if (!el) return;
  el.innerHTML = hist.length ? hist.map(h => `<div class="d-flex justify-content-between py-1 border-bottom border-secondary"><span>${h.mode === "focus" ? "🎯 Fokus" : "☕ Istirahat"} ${h.minutes}m</span><small class="text-muted">${new Date(h.at).toLocaleString("id-ID")}</small></div>`).join("") : '<span class="text-muted">Belum ada sesi</span>';
}
function updatePomodoroDisplay() {
  const m = Math.floor(pomodoroState.seconds / 60);
  const s = pomodoroState.seconds % 60;
  const timeEl = document.getElementById("pomodoroTime");
  const modeEl = document.getElementById("pomodoroMode");
  if (!timeEl) return;
  timeEl.textContent = `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
  modeEl.textContent = pomodoroState.mode === "focus" ? "Waktu Fokus" : "Istirahat";
  const pct = (pomodoroState.totalSeconds - pomodoroState.seconds) / pomodoroState.totalSeconds;
  const deg = pct * 360;
  const color = pomodoroState.mode === "focus" ? "#1f6feb" : "#198754";
  document.getElementById("pomodoroRing").style.background = `conic-gradient(${color} ${deg}deg, #21262d ${deg}deg)`;
  const btn = document.getElementById("pomodoroStart");
  if (btn) btn.innerHTML = pomodoroState.running ? '<i class="bi bi-pause-fill"></i> Pause' : '<i class="bi bi-play-fill"></i> Start';
}
function togglePomodoro() {
  if (pomodoroState.running) {
    clearInterval(pomodoroState.timer); pomodoroState.running = false; updatePomodoroDisplay(); return;
  }
  pomodoroState.running = true;
  pomodoroState.timer = setInterval(() => {
    pomodoroState.seconds--;
    if (pomodoroState.seconds <= 0) {
      clearInterval(pomodoroState.timer);
      pomodoroState.running = false;
      const mins = Math.round(pomodoroState.totalSeconds / 60);
      DB.pomodoroHistory = DB.pomodoroHistory || [];
      DB.pomodoroHistory.push({ user_id: currentUser.id, mode: pomodoroState.mode, minutes: mins, at: new Date().toISOString() });
      saveDB(DB);
      pomodoroState.mode = pomodoroState.mode === "focus" ? "break" : "focus";
      pomodoroState.totalSeconds = (pomodoroState.mode === "focus" ? 25 : 5) * 60;
      pomodoroState.seconds = pomodoroState.totalSeconds;
      renderPomodoro();
      showToast(pomodoroState.mode === "focus" ? "Istirahat selesai!" : "Sesi fokus selesai!");
    }
    updatePomodoroDisplay();
  }, 1000);
}
function resetPomodoro() {
  clearInterval(pomodoroState.timer);
  pomodoroState.running = false;
  pomodoroState.seconds = pomodoroState.totalSeconds;
  updatePomodoroDisplay();
}

/* ============ HEATMAP ============ */
function logActivity() {
  if (!currentUser) return;
  DB.activityHeatmap = DB.activityHeatmap || {};
  const key = currentUser.id + "_" + new Date().toISOString().slice(0, 10);
  DB.activityHeatmap[key] = (DB.activityHeatmap[key] || 0) + 1;
  saveDB(DB);
}
function renderHeatmap() {
  if (!currentUser) return;
  DB.activityHeatmap = DB.activityHeatmap || {};
  const grid = document.getElementById("heatmapGrid");
  if (!grid) return;
  const today = new Date();
  const days = [];
  for (let i = 364; i >= 0; i--) {
    const d = new Date(today); d.setDate(d.getDate() - i); days.push(d);
  }
  let total = 0, activeDays = 0;
  grid.innerHTML = days.map(d => {
    const key = currentUser.id + "_" + d.toISOString().slice(0, 10);
    const count = DB.activityHeatmap[key] || 0;
    if (count > 0) activeDays++;
    total += count;
    let level = 0;
    if (count >= 1 && count <= 2) level = 1;
    else if (count >= 3 && count <= 5) level = 2;
    else if (count >= 6 && count <= 9) level = 3;
    else if (count >= 10) level = 4;
    const cls = level > 0 ? `l${level}` : "";
    return `<div class="heatmap-cell ${cls}" title="${d.toLocaleDateString("id-ID")}: ${count} aktivitas"></div>`;
  }).join("");
  let currentStreak = 0;
  for (let i = 0; i < 365; i++) {
    const d = new Date(today); d.setDate(d.getDate() - i);
    const key = currentUser.id + "_" + d.toISOString().slice(0, 10);
    if (DB.activityHeatmap[key]) currentStreak++; else break;
  }
  document.getElementById("streakCurrent").textContent = currentStreak;
  document.getElementById("streakLongest").textContent = currentStreak;
  document.getElementById("hmTotal").textContent = total;
  document.getElementById("hmActiveDays").textContent = activeDays;
}

/* ============ THEME & TOAST ============ */
function toggleTheme() {
  const cur = document.documentElement.getAttribute("data-theme") || "dark";
  const next = cur === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  localStorage.setItem("cybersec_theme", next);
  document.getElementById("themeBtn").innerHTML = next === "dark" ? '<i class="bi bi-moon-stars"></i>' : '<i class="bi bi-sun"></i>';
}
function showToast(msg, type = "success") {
  if (!toast) toast = new bootstrap.Toast(document.getElementById("toast"));
  const el = document.getElementById("toast");
  el.className = `toast align-items-center text-bg-${type} border-0`;
  document.getElementById("toastMsg").textContent = msg;
  toast.show();
}
function pushNotif(msg, type = "info") { /* placeholder */ }

console.log("CyberSec Academy — versi bersih siap");
</script>
