<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CyberSec Academy</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#1f6feb">
<style>
  body { background:#0d1117; color:#e6edf3; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  .navbar { background:#010409 !important; border-bottom:1px solid #30363d; }
  .card, .modal-content { background:#161b22; border:1px solid #30363d; }
  .form-control, .form-select { background:#0d1117; border:1px solid #30363d; color:#e6edf3; }
  .form-control:focus, .form-select:focus { background:#0d1117; color:#e6edf3; border-color:#58a6ff; box-shadow:0 0 0 .2rem rgba(88,166,255,.25); }
  .table { color:#e6edf3; } .table thead { background:#21262d; }
  .table-hover tbody tr:hover { background:#1f2937; }
  .login-wrap { min-height:100vh; display:flex; align-items:center; justify-content:center; }
  .login-card { background:#161b22; border:1px solid #30363d; border-radius:1rem; padding:2rem; width:100%; max-width:400px; }
  .brand-icon { font-size:3rem; color:#58a6ff; }
  .stat-card { background:#161b22; border:1px solid #30363d; border-radius:.75rem; transition:transform .2s, border-color .2s; }
  .stat-card:hover { transform:translateY(-3px); border-color:#58a6ff; }
  .stat-icon { font-size:2rem; } .stat-value { font-size:2rem; font-weight:700; }
  .badge-admin{background:#dc3545;} .badge-student{background:#0d6efd;}
  .badge-instructor{background:#198754;} .badge-active{background:#198754;}
  .badge-inactive{background:#6c757d;}
  .diff-easy{background:#198754;} .diff-medium{background:#ffc107;color:#000;}
  .diff-hard{background:#dc3545;} .diff-insane{background:#6f42c1;}
  .course-card,.lab-card,.quiz-card,.tool-card,.event-card {
    background:#161b22; border:1px solid #30363d; border-radius:.75rem;
    transition:transform .2s, border-color .2s; height:100%;
  }
  .course-card:hover,.lab-card:hover,.quiz-card:hover,.tool-card:hover,.event-card:hover {
    transform:translateY(-4px); border-color:#58a6ff;
  }
  .event-cover { height:120px; background:linear-gradient(135deg,#1f6feb,#6f42c1);
    display:flex; align-items:center; justify-content:center; font-size:2.5rem; color:#fff; border-radius:.75rem .75rem 0 0; }
  code.cmd { background:#0d1117; border:1px solid #30363d; padding:2px 6px; border-radius:.25rem;
    color:#7ee787; font-size:.78rem; display:block; overflow-x:auto; white-space:nowrap; margin-top:.25rem; }
  .rank-1{background:linear-gradient(90deg,rgba(255,215,0,.15),transparent);}
  .rank-2{background:linear-gradient(90deg,rgba(192,192,192,.12),transparent);}
  .rank-3{background:linear-gradient(90deg,rgba(205,127,50,.12),transparent);}
  .toast-container { z-index:9999; }
  .page { display:none; } .page.active { display:block; }
  .medal { font-size:1.2rem; }
  .chat-msg { margin-bottom:.75rem; display:flex; gap:.5rem; }
  .chat-msg.me { flex-direction:row-reverse; }
  .chat-bubble { background:#161b22; border:1px solid #30363d; border-radius:.5rem; padding:.5rem .75rem; max-width:70%; }
  .chat-msg.me .chat-bubble { background:#1f6feb; border-color:#1f6feb; }
  .chat-meta { font-size:.7rem; color:#6c757d; margin-bottom:.15rem; }
  .chat-box { background:#0d1117; border:1px solid #30363d; border-radius:.5rem; height:400px; overflow-y:auto; padding:1rem; }
  .note-card { background:#161b22; border:1px solid #30363d; border-radius:.5rem; padding:1rem; margin-bottom:.75rem; }
  .pomodoro-ring { width:180px; height:180px; border-radius:50%; background:conic-gradient(#1f6feb 0deg,#21262d 0deg);
    display:flex; align-items:center; justify-content:center; margin:0 auto; transition:background .3s; }
  .pomodoro-inner { width:150px; height:150px; border-radius:50%; background:#161b22; display:flex;
    align-items:center; justify-content:center; flex-direction:column; }
  .pomodoro-inner .time { font-size:2rem; font-weight:700; font-family:monospace; }
  .heatmap { display:grid; grid-template-columns:repeat(53,1fr); gap:2px; padding:1rem;
    background:#0d1117; border-radius:.5rem; border:1px solid #30363d; overflow-x:auto; }
  .heatmap-cell { width:12px; height:12px; border-radius:2px; background:#161b22; }
  .heatmap-cell.l1{background:#0e4429;} .heatmap-cell.l2{background:#006d32;}
  .heatmap-cell.l3{background:#26a641;} .heatmap-cell.l4{background:#39d353;}
  .api-endpoint { background:#0d1117; border:1px solid #30363d; padding:.75rem 1rem;
    border-radius:.5rem; margin-bottom:.5rem; font-family:monospace; font-size:.85rem; display:flex; gap:.75rem; align-items:center; }
  .api-method { padding:.2rem .5rem; border-radius:.25rem; font-weight:bold; font-size:.75rem; min-width:50px; text-align:center; }
  .api-get{background:#198754;} .api-post{background:#0d6efd;} .api-put{background:#ffc107;color:#000;} .api-delete{background:#dc3545;}
  [data-theme="light"] body { background:#f6f8fa; color:#1f2328; }
  [data-theme="light"] .navbar { background:#fff !important; border-color:#d0d7de; }
  [data-theme="light"] .card,[data-theme="light"] .modal-content,[data-theme="light"] .stat-card,
  [data-theme="light"] .course-card,[data-theme="light"] .lab-card,[data-theme="light"] .quiz-card,
  [data-theme="light"] .tool-card,[data-theme="light"] .event-card,[data-theme="light"] .login-card { background:#fff; border-color:#d0d7de; }
  [data-theme="light"] .form-control,[data-theme="light"] .form-select { background:#fff; color:#1f2328; }
  [data-theme="light"] .table { color:#1f2328; } [data-theme="light"] .table thead { background:#f6f8fa; }
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginView" class="login-wrap">
  <div class="login-card">
    <div class="text-center mb-4">
      <i class="bi bi-shield-lock-fill brand-icon"></i>
      <h4 class="mt-2 mb-0">CyberSec Academy</h4>
      <small class="text-muted">Sign in to continue</small>
    </div>
    <ul class="nav nav-pills nav-fill mb-3">
      <li class="nav-item"><a class="nav-link active" href="#" id="tabLogin">Login</a></li>
      <li class="nav-item"><a class="nav-link" href="#" id="tabRegister">Register</a></li>
    </ul>
    <form id="loginForm" autocomplete="off">
      <div class="mb-3" id="nameField" style="display:none">
        <label class="form-label">Nama Lengkap</label>
        <input type="text" class="form-control" id="regName" placeholder="Nama kamu">
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" id="loginEmail" value="admin@cybersec.id" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" class="form-control" id="loginPassword" value="admin123" required>
      </div>
      <button class="btn btn-primary w-100" type="submit" id="loginBtn">
        <i class="bi bi-box-arrow-in-right"></i> Login
      </button>
    </form>
    <div class="alert alert-danger mt-3 d-none" id="loginError"></div>
    <div class="text-center my-3"><small class="text-muted">atau</small></div>
    <button type="button" class="btn btn-light w-100" onclick="loginWithGoogle()">
      <i class="bi bi-google" style="color:#4285F4;"></i> Continue with Google
    </button>
    <div class="text-center mt-3 small text-muted">
      Demo: <code>admin@cybersec.id</code> / <code>admin123</code>
    </div>
  </div>
</div>

<!-- MAIN APP -->
<div id="mainApp" style="display:none">
<nav class="navbar navbar-expand-xl navbar-dark px-3 flex-nowrap" style="overflow-x:auto;">
  <a class="navbar-brand" href="#" onclick="showPage('dashboard');return false;">
    <i class="bi bi-shield-lock-fill text-info"></i> CyberSec Academy
  </a>
  <div class="ms-auto d-flex gap-1 flex-nowrap" style="white-space:nowrap;">
    <button class="btn btn-sm btn-outline-light" onclick="showPage('dashboard')" title="Dashboard"><i class="bi bi-speedometer2"></i></button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('users')" title="Users"><i class="bi bi-people"></i></button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('courses')" title="Courses"><i class="bi bi-journal-code"></i></button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('labs')" title="Labs"><i class="bi bi-terminal"></i></button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('quizzes')" title="Quizzes"><i class="bi bi-question-circle"></i></button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('tools')" title="Tools"><i class="bi bi-tools"></i></button>
    <button class="btn btn-sm btn-outline-light" onclick="showPage('events')" title="Events"><i class="bi bi-calendar-event"></i></button>
    <button class="btn btn-sm btn-outline-warning" onclick="showPage('leaderboard')" title="Leaderboard"><i class="bi bi-trophy"></i></button>
    <button class="btn btn-sm btn-outline-warning" onclick="showPage('badges')" title="Badges"><i class="bi bi-award"></i></button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('chat')" title="Chat"><i class="bi bi-chat-dots"></i></button>
    <button class="btn btn-sm btn-outline-info" onclick="showPage('notes')" title="Notes"><i class="bi bi-journal-text"></i></button>
    <button class="btn btn-sm btn-outline-danger" onclick="showPage('pomodoro')" title="Pomodoro"><i class="bi bi-alarm"></i></button>
    <button class="btn btn-sm btn-outline-success" onclick="showPage('heatmap')" title="Activity"><i class="bi bi-calendar3"></i></button>
    <button class="btn btn-sm btn-outline-secondary" onclick="toggleTheme()" id="themeBtn" title="Theme"><i class="bi bi-moon-stars"></i></button>
    <button class="btn btn-sm btn-outline-danger" onclick="logout()" title="Logout"><i class="bi bi-box-arrow-right"></i></button>
  </div>
</nav>

<div class="container-fluid my-4 px-4">
  <div id="page-dashboard" class="page active">
    <h3 class="mb-3"><i class="bi bi-speedometer2"></i> Dashboard</h3>
    <div class="row g-3 mb-4">
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-people-fill stat-icon text-info"></i>
        <div class="stat-value" id="statUsers">0</div><div class="text-muted small">Users</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-journal-code stat-icon text-success"></i>
        <div class="stat-value" id="statCourses">0</div><div class="text-muted small">Courses</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-terminal-fill stat-icon text-danger"></i>
        <div class="stat-value" id="statLabs">0</div><div class="text-muted small">Labs</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-question-circle-fill stat-icon text-warning"></i>
        <div class="stat-value" id="statQuizzes">0</div><div class="text-muted small">Quizzes</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-tools stat-icon text-info"></i>
        <div class="stat-value" id="statTools">0</div><div class="text-muted small">Tools</div></div></div>
      <div class="col-md-4 col-lg-2"><div class="stat-card p-3 text-center">
        <i class="bi bi-calendar-event stat-icon text-success"></i>
        <div class="stat-value" id="statEvents">0</div><div class="text-muted small">Events</div></div></div>
    </div>
    <div class="row g-3">
      <div class="col-md-6"><div class="card p-3"><h6><i class="bi bi-journal-code text-success"></i> Courses Terbaru</h6>
        <ul class="list-unstyled small mb-0" id="recentCourses"></ul></div></div>
      <div class="col-md-6"><div class="card p-3"><h6><i class="bi bi-terminal-fill text-danger"></i> Labs Terbaru</h6>
        <ul class="list-unstyled small mb-0" id="recentLabs"></ul></div></div>
    </div>
  </div>

  <div id="page-users" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-people-fill"></i> Users</h3>
      <button class="btn btn-primary" onclick="openUserModal()"><i class="bi bi-plus-circle"></i> Tambah</button>
    </div>
    <div class="card"><div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead><tr><th>#</th><th>Nama</th><th>Email</th><th>Role</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody id="usersTable"></tbody>
      </table>
    </div></div>
  </div>

  <div id="page-courses" class="page">
    <h3 class="mb-3"><i class="bi bi-journal-code"></i> Courses</h3>
    <div class="row g-3" id="coursesGrid"></div>
  </div>

  <div id="page-labs" class="page">
    <h3 class="mb-3"><i class="bi bi-terminal"></i> Labs</h3>
    <div class="row g-3" id="labsGrid"></div>
  </div>

  <div id="page-quizzes" class="page">
    <h3 class="mb-3"><i class="bi bi-question-circle"></i> Quizzes</h3>
    <div class="row g-3" id="quizzesGrid"></div>
  </div>

  <div id="page-tools" class="page">
    <h3 class="mb-3"><i class="bi bi-tools"></i> Cyber Tools</h3>
    <div class="row g-3" id="toolsGrid"></div>
  </div>

  <div id="page-events" class="page">
    <h3 class="mb-3"><i class="bi bi-calendar-event"></i> Events</h3>
    <div class="row g-3" id="eventsGrid"></div>
  </div>

  <div id="page-leaderboard" class="page">
    <h3 class="mb-3"><i class="bi bi-trophy-fill text-warning"></i> Leaderboard</h3>
    <div class="card"><div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead><tr><th style="width:70px">Rank</th><th>Nama</th><th class="text-end">Points</th><th class="text-end">Completed</th></tr></thead>
        <tbody id="lbTable"></tbody>
      </table>
    </div></div>
  </div>

  <div id="page-badges" class="page">
    <h3 class="mb-3"><i class="bi bi-award-fill text-warning"></i> Badges</h3>
    <div class="row g-3" id="badgesGrid"></div>
  </div>

  <div id="page-chat" class="page">
    <h3 class="mb-3"><i class="bi bi-chat-dots-fill text-primary"></i> Community Chat</h3>
    <div class="card p-3">
      <div class="chat-box" id="chatBox"></div>
      <div class="d-flex gap-2 mt-2">
        <input type="text" class="form-control" id="chatInput" placeholder="Tulis pesan..." onkeydown="if(event.key==='Enter') sendChat()">
        <button class="btn btn-primary" onclick="sendChat()"><i class="bi bi-send-fill"></i></button>
      </div>
    </div>
  </div>

  <div id="page-notes" class="page">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3><i class="bi bi-journal-text text-info"></i> Catatan Belajar</h3>
      <button class="btn btn-primary" onclick="openNoteModal()"><i class="bi bi-plus-circle"></i> Catatan Baru</button>
    </div>
    <div class="row g-3" id="notesGrid"></div>
  </div>

  <div id="page-pomodoro" class="page">
    <h3 class="mb-3"><i class="bi bi-alarm-fill text-danger"></i> Pomodoro Timer</h3>
    <div class="row g-3">
      <div class="col-md-6 mx-auto">
        <div class="card p-4 text-center">
          <div class="pomodoro-ring" id="pomodoroRing">
            <div class="pomodoro-inner">
              <div class="time" id="pomodoroTime">25:00</div>
              <small class="text-muted" id="pomodoroMode">Waktu Fokus</small>
            </div>
          </div>
          <div class="d-flex gap-2 justify-content-center mt-3">
            <button class="btn btn-success" id="pomodoroStart" onclick="togglePomodoro()"><i class="bi bi-play-fill"></i> Start</button>
            <button class="btn btn-warning" onclick="resetPomodoro()"><i class="bi bi-arrow-clockwise"></i> Reset</button>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3">
          <h6><i class="bi bi-clock-history"></i> Sesi Terakhir</h6>
          <div id="pomodoroHistory" class="small"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="page-heatmap" class="page">
    <h3 class="mb-3"><i class="bi bi-calendar3 text-success"></i> Activity Heatmap</h3>
    <div class="row g-3 mb-4">
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <div class="stat-value text-warning" id="streakCurrent">0</div>
        <div class="text-muted small">Current Streak</div></div></div>
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <div class="stat-value text-info" id="streakLongest">0</div>
        <div class="text-muted small">Longest Streak</div></div></div>
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <div class="stat-value text-success" id="hmTotal">0</div>
        <div class="text-muted small">Total Aktivitas</div></div></div>
      <div class="col-md-3"><div class="stat-card p-3 text-center">
        <div class="stat-value text-primary" id="hmActiveDays">0</div>
        <div class="text-muted small">Hari Aktif</div></div></div>
    </div>
    <div class="card p-3">
      <h6 class="mb-3"><i class="bi bi-grid-3x3-gap"></i> 365 Hari Terakhir</h6>
      <div class="heatmap" id="heatmapGrid"></div>
    </div>
  </div>
</div>
</div>

<!-- MODALS -->
<div class="modal fade" id="userModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 id="userModalTitle">User</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="userId">
    <div class="mb-3"><label>Nama</label><input class="form-control" id="uName"></div>
    <div class="mb-3"><label>Email</label><input class="form-control" id="uEmail"></div>
    <div class="mb-3"><label>Role</label><select class="form-select" id="uRole"><option>student</option><option>instructor</option><option>admin</option></select></div>
    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="uActive" checked><label class="form-check-label">Aktif</label></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button><button class="btn btn-primary" onclick="saveUser()">Simpan</button></div>
</div></div></div>

<div class="modal fade" id="noteModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <div class="modal-header"><h5 id="noteModalTitle">Catatan</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <input type="hidden" id="noteId">
    <div class="mb-3"><label>Judul</label><input class="form-control" id="noteTitle"></div>
    <div class="mb-3"><label>Isi</label><textarea class="form-control" id="noteContent" rows="4"></textarea></div>
    <div class="mb-3"><label>Warna</label>
      <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm" style="background:#ffc107;width:40px;height:40px;" onclick="selectNoteColor('yellow')"></button>
        <button type="button" class="btn btn-sm" style="background:#0d6efd;width:40px;height:40px;" onclick="selectNoteColor('blue')"></button>
        <button type="button" class="btn btn-sm" style="background:#198754;width:40px;height:40px;" onclick="selectNoteColor('green')"></button>
        <button type="button" class="btn btn-sm" style="background:#dc3545;width:40px;height:40px;" onclick="selectNoteColor('red')"></button>
        <button type="button" class="btn btn-sm" style="background:#6f42c1;width:40px;height:40px;" onclick="selectNoteColor('purple')"></button>
      </div>
      <input type="hidden" id="noteColor" value="yellow">
    </div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Batal</button><button class="btn btn-primary" onclick="saveNote()">Simpan</button></div>
</div></div></div>

<div class="modal fade" id="flagModal" tabindex="-1"><div class="modal-dialog modal-sm"><div class="modal-content">
  <div class="modal-header"><h5>Submit Flag</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <p class="small text-muted">Lab: <strong id="flagLabName"></strong></p>
    <input class="form-control" id="flagInput" placeholder="CTF{...}">
    <div id="flagResult" class="mt-2 small"></div>
  </div>
  <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button><button class="btn btn-success" onclick="submitFlag()">Submit</button></div>
</div></div></div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="toast" class="toast align-items-center text-bg-success border-0">
    <div class="d-flex"><div class="toast-body" id="toastMsg">OK</div>
      <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
/* ============================================================
   CyberSec Academy — bersih dari awal
   ============================================================ */
const DB_KEY = "cybersec_demo_db";
let DB, currentUser = null, toast = null;

function defaultDB() {
  return {
    users: [
      {id:1, full_name:"Admin Cyber", email:"admin@cybersec.id", password:"admin123", role:"admin", is_active:true},
      {id:2, full_name:"Budi Santoso", email:"budi@cybersec.id", password:"student123", role:"student", is_active:true},
      {id:3, full_name:"Siti Aminah", email:"siti@cybersec.id", password:"student123", role:"student", is_active:true},
      {id:4, full_name:"Andi Wijaya", email:"andi@cybersec.id", password:"student123", role:"student", is_active:true},
      {id:5, full_name:"Rina Kartika", email:"rina@cybersec.id", password:"student123", role:"student", is_active:true},
    ],
    courses: [
      {id:1, title:"Dasar Keamanan Siber", level:"beginner", description:"Pengenalan CIA triad.", duration_hours:12, price:0, is_published:true},
